import { useLocale } from '../../stores/locale.store.ts';
import Icon from '../../icons/icon.component.azeroth';

/** Where nothing can be written: a table whose host keeps it quiet, or a group the reader may only read. */
export default component QuietNote(props: { class?: string; title?: string; lead?: string })
{
    const locale = useLocale();

    derived title = props.title ?? locale.t('play.table.quiet');

    derived lead = props.lead ?? locale.t('play.table.quietLead');

    <div class={ () => [ 'flex items-start gap-3 rounded-tile border border-line bg-sunk px-3 py-2.5', props.class ?? '' ].filter(Boolean).join(' ') } role="status" data-quiet>
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-raised text-muted">
            <Icon name="chat-off" size={ 16 } />
        </span>
        <span class="flex min-w-0 flex-col gap-0.5">
            <span class="text-ui-sm font-semibold text-text">{ title }</span>
            <span class="text-ui-xs text-muted">{ lead }</span>
        </span>
    </div>
}
