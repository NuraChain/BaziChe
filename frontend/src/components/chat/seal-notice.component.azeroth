import Icon from '../../icons/icon.component.azeroth';
import type { IconName } from '../../icons/registry.ts';
import type { Readiness } from '../../lib/device-state.ts';
import type { MemberSealState, SendBlock } from '../../lib/seal-state.ts';
import type { MessageKey } from '../../locales/en.ts';
import { useDevices } from '../../stores/devices.store.ts';
import { useEnrolment } from '../../stores/enrolment.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import Button from '../ui/button.component.azeroth';

type Blocked = Exclude<MemberSealState, 'ready'>;

const ICON: Record<Blocked, IconName> = {
    'no-device': 'info',
    'needs-chain': 'info',
    tampered: 'alert'
};

const SAYS: Record<Blocked, MessageKey> = {
    'no-device': 'seal.noDevice',
    'needs-chain': 'seal.needsChain',
    tampered: 'seal.tampered'
};

const BROWSER: Record<Exclude<Readiness, 'ready'>, MessageKey> = {
    unsupported: 'seal.deviceUnsupported',
    absent: 'seal.noKeysHere'
};

const BROWSER_ICON: Record<Exclude<Readiness, 'ready'>, IconName> = {
    unsupported: 'error-circle',
    absent: 'key'
};

const SAYS_MINE: Record<Blocked, MessageKey> = {
    'no-device': 'seal.noDeviceMine',
    'needs-chain': 'seal.needsChainMine',
    tampered: 'seal.tamperedMine'
};

export default component SealNotice(props: { stop: SendBlock | null })
{
    const locale = useLocale();
    const devices = useDevices();
    const enrolment = useEnrolment();

    derived clear = props.stop === null;

    derived shown = props.stop !== null && props.stop.reason !== 'pending' ? props.stop : null;

    derived keyless = shown !== null && shown.reason === 'browser' && shown.readiness === 'absent';

    derived plain = keyless ? null : shown;

    <>
        <Show when={ clear }>
            { () =>
                <p class="flex items-start gap-2 px-3 py-1.5 text-ui-xs text-faint">
                    <Icon name="lock" size={ 14 } class="mt-0.5 shrink-0" />
                    <span>{ locale.t('seal.sealed') }</span>
                </p>
            }
        </Show>

        <Show when={ keyless }>
            <div class="@container rounded-tile border border-line bg-field" data-keyless>
                <div class="flex flex-col gap-3 p-3 @sm:flex-row @sm:items-center">
                    <div class="flex min-w-0 flex-1 items-start gap-3">
                        <span class="grid size-9 shrink-0 place-items-center rounded-full bg-accent/15 text-accent" aria-hidden="true">
                            <Icon name="key" size={ 18 } />
                        </span>
                        <div class="min-w-0">
                            <p class="text-ui-sm font-semibold text-text">{ locale.t('seal.keyless.title') }</p>
                            <p class="mt-0.5 text-ui-xs text-muted">{ locale.t('seal.keyless.body') }</p>
                        </div>
                    </div>
                    <Button variant="primary" size="sm" leading="wallet" class="w-full shrink-0 @sm:w-auto" loading={ devices.busy() } onClick={ () => void enrolment.give() }>
                        { locale.t('devices.enrol') }
                    </Button>
                </div>
            </div>
        </Show>

        <Show when={ plain } let={ sealed }>
            <div
                class={ () => [
                    'flex flex-wrap items-start gap-2 rounded-tile border px-3 py-2 text-ui-sm',
                    sealed.reason === 'member' && sealed.member.state === 'tampered'
                        ? 'border-danger/40 bg-danger/10 text-danger'
                        : 'border-line bg-field text-muted'
                ].join(' ') }
                role={ sealed.reason === 'member' && sealed.member.state === 'tampered' ? 'alert' : undefined }
            >
                <Icon
                    name={ sealed.reason === 'browser' ? BROWSER_ICON[sealed.readiness] : ICON[sealed.member.state] }
                    size={ 16 }
                    class="mt-0.5 shrink-0"
                />
                <span class="min-w-0 flex-1">
                    { sealed.reason === 'browser'
                        ? locale.t(BROWSER[sealed.readiness])
                        : (sealed.member.isMe
                            ? locale.t(SAYS_MINE[sealed.member.state])
                            : locale.t(SAYS[sealed.member.state], { who: sealed.member.handle })) }
                </span>
            </div>
        </Show>
    </>
}
