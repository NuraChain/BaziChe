import { whyRewards } from '../../lib/reward-words.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useRewards } from '../../stores/rewards.store.ts';
import Button from '../ui/button.component.azeroth';
import QuestRow from './quest-row.component.azeroth';

export default component Quests(props: { class?: string })
{
    const locale = useLocale();
    const rewards = useRewards();

    derived daily = rewards.dailyQuests();

    derived weekly = rewards.weeklyQuests();

    derived ready = [...daily, ...weekly].filter((quest) => quest.done && !quest.claimed).length;

    derived many = ready > 1;

    derived hasDaily = daily.length > 0;

    derived hasWeekly = weekly.length > 0;

    derived chestOpened = rewards.state()?.chestClaimed === true;

    derived chestShut = !chestOpened;

    derived chest = rewards.state()?.chest ?? 0;

    derived claimingAll = rewards.busy() === 'claim-all';

    derived said = rewards.said();

    derived saying = said !== null && said.on === 'quests';

    derived why = said === null ? '' : whyRewards(said.reason, locale);

    <div class={ [ 'flex flex-col gap-4', props.class ?? '' ].filter(Boolean).join(' ') }>
        <Show when={ many }>
            <Button onClick={ () => void rewards.claimAll() } loading={ claimingAll } variant="outline" block={ true }>
                { locale.t('app.rewards.claimAll') }
            </Button>
        </Show>

        <Show when={ saying }>
            <p class="text-ui-sm text-muted" role="status">{ why }</p>
        </Show>

        <Show when={ hasDaily }>
            <section class="flex flex-col gap-3" aria-labelledby="reward-daily">
                <h3 id="reward-daily" class="text-ui-lg font-semibold text-text">{ locale.t('app.rewards.dailyQuests') }</h3>
                <ul class="flex flex-col gap-3">
                    <For each={ daily } key={ (quest) => quest.id } let={ quest }>
                        <li><QuestRow quest={ quest } period="daily" /></li>
                    </For>
                </ul>
            </section>
        </Show>

        <Show when={ hasWeekly }>
            <section class="flex flex-col gap-3" aria-labelledby="reward-weekly">
                <div class="flex items-center justify-between gap-3">
                    <h3 id="reward-weekly" class="text-ui-lg font-semibold text-text">{ locale.t('app.rewards.weeklyQuests') }</h3>
                    <Show when={ chestOpened }>
                        <span class="text-xs text-accent">{ locale.t('app.rewards.chestOpened') }</span>
                    </Show>
                </div>
                <Show when={ chestShut }>
                    <p class="text-xs text-muted">{ locale.t('app.rewards.chest', { amount: chest }) }</p>
                </Show>
                <ul class="flex flex-col gap-3">
                    <For each={ weekly } key={ (quest) => quest.id } let={ quest }>
                        <li><QuestRow quest={ quest } period="weekly" /></li>
                    </For>
                </ul>
            </section>
        </Show>
    </div>
}
