# Copy to .env at the repository root, or run `npm run setup`, which writes one for this machine
# and asks only for the database. Every name below must be written: the server has a value for none
# of them and refuses to start, naming each one, while any is missing. Whatever differs between
# development and production follows from the command: `npm run dev` is development, `npm start`
# is production, and NODE_ENV in this file is never read. One file serves both halves: the api
# reads it, and so does vite, which takes PUBLIC_ORIGIN and PORT from it.

# =================================================================================================
# Needed
# =================================================================================================

# The database. `npm run setup` makes it when Postgres has none of that name, or once by hand:
#   psql -U postgres -c "create database baziche"
DATABASE_URL=postgres://postgres:change-me@127.0.0.1:5432/baziche

# Signs session cookies and realtime tickets, and keys the franking of reported messages. There is
# no default and there must not be one: `serializeCookie` has no `signed` option and the framework
# ships no keyring, so this value is the only thing standing between a cookie and a forged
# session. Production refuses one under 32 characters.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# The origin the browser actually uses, such as https://play.example.com. It is the SIWE `domain`
# and `URI`, the WebSocket origin check, the check every write is held to, the cookie's site, and
# the address a link preview's picture is written against. Never derived from a request header - a
# header is attacker-controlled, and this value decides what a signature means. `npm run dev` uses
# its dev server's, http://localhost:3100, whatever is written here; on this machine `npm start`
# serves http://localhost:4900.
PUBLIC_ORIGIN=https://baziche.com

# =================================================================================================
# Optional features: each is off while its values are empty, but its names are still written
# =================================================================================================

# The one wallet address that may open /admin.
ADMIN_WALLET_ADDRESS=0x2Ef2D5A095Fd5Ecd686d99eD3cd1F9ff91fc3167

# Web Push. All three together or none: a half-configured push subscribes a browser and then
# never delivers, which is worse than not subscribing. With none, a device is still told what
# happened while a tab is open. A push from this server carries NO payload,
# so there is no content key here - the worker asks the api what happened, over the reader's
# own session, and says that.
#   node -e "const {generateKeyPairSync}=require('node:crypto');const p=generateKeyPairSync('ec',{namedCurve:'prime256v1'});const j=p.privateKey.export({format:'jwk'});console.log('VAPID_PUBLIC_KEY='+Buffer.concat([Buffer.from([4]),Buffer.from(j.x,'base64url'),Buffer.from(j.y,'base64url')]).toString('base64url'));console.log('VAPID_PRIVATE_KEY='+j.d)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@nura.games

# NuraChain, the Nurachain deployment of 2026-10-24. NURA_CHAIN_ID is the DECIMAL EIP-155 id a
# wallet row records and a contract wallet is checked on. NURA_RPC_URL verifies a smart-contract
# wallet (a Safe, say) and reads the profile registry; ordinary key-holding wallets are verified
# locally and need none of this. The registry is the ERC-1967 proxy, NOT the implementation
# (0x86D130274e32b0eD0c76819C222824766B3B85f4), with the stateless lens beside it; the lens's own
# `core()` names the proxy, and a profile written anywhere else is one the lens never reads. The explorer's
# Etherscan-compatible api is where a wallet's NFTs are read. Write the block's values empty and the
# server reads no chain: the profile page shows nothing about it and the NFT count is not drawn.
NURA_CHAIN_ID=1020
NURA_RPC_URL=https://rpc.nurachain.net
NURA_PROFILE_ADDRESS=0x47C27929B6f67d1a21eBe36eF62Ace6e187BF6Aa
NURA_PROFILE_LENS_ADDRESS=0x450096589985ea73614F96e08B5d4B512fAd11c7
NURA_EXPLORER_API=https://explorer.nurachain.net/api

# Paid tables: playing for NURA. NURA_VAULT_ADDRESS is the ArcadeVault the SmartContract project
# deploys with `npm run deploy:nurachain:baziche`. NURA_REFEREE_KEY is the private key (0x and 64 hex
# digits) of the address the vault was given as its referee: the only key that can lock players'
# signed stakes into a game and pay its winners. It is a hot key, so fund it with a little NURA for
# gas and nothing more; the vault's admin can revoke it in one transaction. Paid tables exist only
# when both are set beside NURA_RPC_URL and NURA_CHAIN_ID; leave either empty and every table is free.
NURA_VAULT_ADDRESS=0xbD0943a51BF1A34B989087Bc991c2Af940da03De
NURA_REFEREE_KEY=

# The shop: looks bought with NURA. NURA_SHOP_ADDRESS is the ArcadeShop the SmartContract project
# deploys with `npm run deploy:nurachain:bazicheshop`, whose seller is NURA_REFEREE_KEY's address: that
# key signs every price a buyer pays, and it can only sign prices, never move NURA. The shop is open
# only when it is set beside NURA_REFEREE_KEY, NURA_RPC_URL and NURA_CHAIN_ID; leave it empty and no
# door to the shop is drawn.
NURA_SHOP_ADDRESS=0x4F03844D4c3bdC4aCCA7E358868d69E0eBD7F21C

# Donations: somebody watching a game gives NURA to a player of it from their own wallet.
# NURA_TIPS_ADDRESS is the ArcadeTips the SmartContract project deploys with
# `npm run deploy:nurachain:bazichetips`; it passes each gift straight to the player and keeps
# nothing, and this server only reads it. Donations are open when it is set beside NURA_RPC_URL and
# NURA_CHAIN_ID; leave it empty and nobody is offered a way to give.
NURA_TIPS_ADDRESS=0x1e693081A6823a062BF1E7c4E6D7FFcE072afbDb

# Markets: somebody watching a game at a public table backs one of its outcomes with NURA, in a pool
# the winners share. NURA_MARKETS_ADDRESS is the ArcadeMarkets the SmartContract project deploys with
# `npm run deploy:nurachain:bazichemarkets`, whose operator is NURA_REFEREE_KEY's address: that key
# signs every position and settles every market from its game's result, and it never holds a stake.
# It needs NURA_REFEREE_KEY, NURA_RPC_URL and NURA_CHAIN_ID beside it; write it empty and markets are off.
NURA_MARKETS_ADDRESS=0x728715176B9e3E3bD61297B732dE7FeDf61A01ea

# Metrics for a monitor outside, such as Prometheus: GET /api/metrics answers the text format to a
# caller that sends `Authorization: Bearer` and this token, and answers anybody else exactly as an
# address nothing is served at. At least 32 characters; write it empty and the endpoint is off.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
METRICS_TOKEN=

# =================================================================================================
# Numbers
# =================================================================================================

# The address this process binds. 127.0.0.1 on the machine nginx runs on, so nothing reaches the
# api past the proxy. The Docker image writes 0.0.0.0 itself, since a container's 127.0.0.1 is its
# own: publish its port to the proxy alone, never to the internet.
HOST=0.0.0.0

# The port this process binds, for nginx to forward to. vite proxies to it in development.
PORT=4900

# Requests a minute per address, for /api and /ws. The responsive matrix pulls 600 pages from
# one address as fast as it can, which is abusive traffic by any honest measure - raise this for
# a load run rather than shipping a limit shaped around a test. The two sign-in routes, which a
# caller who is not signed in can make rows and accounts with, get a twentieth of it and never
# fewer than ten: 30 a minute at 600.
API_RATE_MAX=600

# The most connections the server holds open to Postgres at once.
DATABASE_POOL_MAX=10
