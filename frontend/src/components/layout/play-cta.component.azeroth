import Button from '../ui/button.component.azeroth';
import { useLocale } from '../../stores/locale.store.ts';

export default component PlayCta(props: { returning: boolean })
{
    const locale = useLocale();

    <Button href="/app" variant="primary" size="lg" leading="play">
        { locale.t(props.returning ? 'landing.cta.back' : 'landing.cta.start') }
    </Button>
}
