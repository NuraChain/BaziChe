import { untrack, useHead, useNavigate, useParams } from 'azerothjs';

import { mayIn } from '../../../../backend/src/domains/group/roles.ts';
import type { GroupSummary } from '../../api.ts';
import ConfirmSheet from '../../components/app/confirm-sheet.component.azeroth';
import Page from '../../components/app/page.component.azeroth';
import OpenHereSheet from '../../components/games/open-here-sheet.component.azeroth';
import GroupAdd from '../../components/social/group-add.component.azeroth';
import GroupBanned from '../../components/social/group-banned.component.azeroth';
import GroupCrest from '../../components/social/group-crest.component.azeroth';
import GroupForm from '../../components/social/group-form.component.azeroth';
import GroupLinks from '../../components/social/group-links.component.azeroth';
import GroupLog from '../../components/social/group-log.component.azeroth';
import GroupMemberRow from '../../components/social/group-member-row.component.azeroth';
import GroupMemberSheet from '../../components/social/group-member-sheet.component.azeroth';
import GroupRequests from '../../components/social/group-requests.component.azeroth';
import Button from '../../components/ui/button.component.azeroth';
import EmptyState from '../../components/ui/empty-state.component.azeroth';
import ErrorState from '../../components/ui/error-state.component.azeroth';
import IconButton from '../../components/ui/icon-button.component.azeroth';
import LoadMore from '../../components/ui/load-more.component.azeroth';
import SearchInput from '../../components/ui/search-input.component.azeroth';
import SectionHeading from '../../components/ui/section-heading.component.azeroth';
import Skeleton from '../../components/ui/skeleton.component.azeroth';
import Tabs from '../../components/ui/tabs.component.azeroth';
import type { GameId } from '../../data/games.ts';
import { formatsWithin } from '../../data/tables.ts';
import Icon from '../../icons/icon.component.azeroth';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useGroupAdmin, type GroupMember } from '../../stores/group-admin.store.ts';
import { useGroups } from '../../stores/groups.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import { usePresence } from '../../stores/presence.store.ts';
import { useShell } from '../../stores/shell.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';
import { attempt } from '../../lib/attempt.ts';
import { whyGroup } from '../../lib/group-words.ts';
import { useAddress } from '../../lib/page-param.ts';
import { runtime } from '../../lib/runtime.ts';
import { SEARCH_FIELD, keyboardTo } from '../../lib/way-back.ts';
import { SEARCH_FROM, SEARCH_PAUSE_MS } from '../../services/search.service.ts';

export default component GroupPage()
{
    const locale = useLocale();
    const presence = usePresence();
    const catalogue = useCatalogue();
    const groups = useGroups();
    const admin = useGroupAdmin();
    const overlay = useOverlay();
    const shell = useShell();
    const toasts = useToasts();
    const params = useParams();
    const { navigate } = useNavigate();

    let pause: (() => void) | null = null;

    mount
    {
        const mine = untrack(() => params().id ?? '');

        groups.open(mine);
        admin.open(mine);
        const listen = admin.start();
        const release = shell.claimTitle(() => name);

        return () =>
        {
            release();
            listen();
            pause?.();

            if (untrack(groups.openId) === mine)
            {
                groups.close();
            }
            if (untrack(admin.slug) === mine)
            {
                admin.close();
            }
        };
    }

    derived group = groups.viewing();

    derived loading = groups.viewLoading() && group === null;

    derived failed = groups.viewFailed() !== null && group === null;

    derived missing = !loading && !failed && group === null;

    derived name = group !== null
        ? group.name
        : locale.t(missing ? 'groups.notFound' : (failed ? 'state.errorTitle' : 'common.loading'));

    useHead({ title: () => name });

    derived owns = group?.role === 'owner';

    derived joined = group?.role !== undefined;

    derived standing = { role: group?.role ?? null, rights: group?.rights ?? [], muted: group?.muted !== undefined };

    derived answers = group !== null && mayIn(standing, group.switches, 'approve');

    derived links = group !== null && mayIn(standing, group.switches, 'links');

    derived bans = group !== null && mayIn(standing, group.switches, 'ban');

    derived logged = group !== null && mayIn(standing, group.switches, 'log');

    derived editable = group !== null && mayIn(standing, group.switches, 'info');

    derived adds = group !== null && mayIn(standing, group.switches, 'add');

    derived waits = group?.requested === true;

    derived joinWords = locale.t(group?.approval === true ? 'groups.requestJoin' : 'groups.join');

    derived askedWords = locale.t('groups.asked', { name: group?.name ?? '' });

    derived silenced = group?.muted !== undefined;

    /** By its time alone when it ends today, and with its date on any other day: "until 14:45" for tomorrow reads as today. */
    const untilOf = (at: number) =>
        locale.date(at, new Date(at).toDateString() === new Date(runtime().clock.now()).toDateString() ? { timeStyle: 'short' } : { dateStyle: 'medium', timeStyle: 'short' });

    /** Until a time today, or a date and a time further off; for good where the mute has no end. */
    derived mutedWords = group?.muted?.until === undefined
        ? locale.t('groups.youMutedForGood')
        : locale.t('groups.youMuted', { time: untilOf(Date.parse(group.muted.until)) });

    state joining = false;

    derived waiting = group?.requests ?? 0;

    /** The staff's panels, each only for a reader whose place opens it; the members are everybody's. */
    derived tabs = [
        { id: 'members', label: locale.t('groups.tab.members') },
        ...(answers ? [{ id: 'requests', label: locale.t('groups.tab.requests'), ...(waiting > 0 ? { count: waiting } : {}) }] : []),
        ...(links ? [{ id: 'links', label: locale.t('groups.tab.links') }] : []),
        ...(bans ? [{ id: 'banned', label: locale.t('groups.tab.banned') }] : []),
        ...(logged ? [{ id: 'log', label: locale.t('groups.tab.log') }] : [])
    ];

    derived tabbed = tabs.length > 1;

    const address = useAddress();

    derived asked = address.text('tab');

    derived tab = tabs.some((one) => one.id === asked) ? asked : 'members';

    derived onMembers = tab === 'members';

    derived onRequests = tab === 'requests';

    derived onLinks = tab === 'links';

    derived onBanned = tab === 'banned';

    derived onLog = tab === 'log';

    const show = (id: string) => address.write({ tab: id === 'members' ? '' : id });

    derived online = (group?.members ?? []).filter((handle) => presence.isOnline(handle));

    derived members = admin.members();

    derived listReading = admin.reading() === 'reading' && members.length === 0;

    derived listFailed = admin.reading() === 'failed' && members.length === 0;

    derived moreMembers = admin.hasMore();

    state query = '';

    derived game = (group?.game ?? null) as GameId | null;

    derived blurbed = (group?.blurb ?? '') !== '';

    derived anyOnline = online.length > 0;

    derived closedDoors = group?.privacy === 'private';

    derived roomed = group?.conversationId !== undefined;

    derived playable = game !== null && catalogue.playable(game);

    derived searched = admin.query().trim() !== '';

    derived searchable = admin.count() > SEARCH_FROM || searched;

    derived nobodyFound = searched && admin.reading() === 'read' && members.length === 0;

    /** Asks the server once the typing pauses, as every search here does. */
    const search = (value: string) =>
    {
        query = value;
        pause?.();
        pause = runtime().clock.after(SEARCH_PAUSE_MS, () => admin.search(value));
    };

    let searchBox: HTMLElement | null = null;

    /** The way back asks at once: nothing is being typed, so there is nothing to wait for. */
    const clearSearch = () =>
    {
        keyboardTo(searchBox, SEARCH_FIELD);
        pause?.();
        query = '';
        admin.search('');
    };

    const playTogether = () =>
    {
        if (group === null || group.conversationId === undefined)
        {
            return;
        }
        const pick = game !== null && catalogue.playable(game) ? game : catalogue.featured();

        if (formatsWithin(catalogue.rules(pick), group.memberCount).length === 0)
        {
            toasts.show({ kind: 'info', text: locale.t('groups.tooFew'), dedupe: 'group-play' });
            return;
        }

        overlay.open(
            OpenHereSheet,
            { conversationId: group.conversationId, game: pick, heads: group.memberCount },
            { label: locale.t('openHere.title') }
        );
    };

    const edit = () =>
    {
        if (group !== null)
        {
            overlay.open(GroupForm, { group }, { label: locale.t('groups.edit') });
        }
    };

    const addSomebody = () =>
    {
        if (group !== null)
        {
            overlay.open(GroupAdd, { group }, { label: locale.t('groups.add') });
        }
    };

    const join = async (one: GroupSummary) =>
    {
        if (joining)
        {
            return;
        }
        joining = true;

        let asked = false;
        const went = groups.join(one.id).then((after) =>
        {
            asked = after.requested === true;
        });

        if (await attempt(went, undefined, whyGroup))
        {
            toasts.show(asked
                ? { kind: 'info', text: locale.t('groups.requestSent') }
                : { kind: 'success', text: locale.t('groups.joined', { name: one.name }) });
        }
        joining = false;
    };

    const withdraw = (one: GroupSummary) =>
        void attempt(groups.withdraw(one.id), { kind: 'info', text: locale.t('groups.withdrawn', { name: one.name }) }, whyGroup);

    const leave = async (one: GroupSummary) =>
    {
        const alone = one.memberCount <= 1;
        const yes = await overlay.open(
            ConfirmSheet,
            {
                title: locale.t('groups.leaveTitle', { name: one.name }),
                lead: alone
                    ? locale.t('groups.leaveLast')
                    : (owns ? locale.t('groups.ownerLeaving') : locale.t('groups.leaveLead')),
                confirm: locale.t('groups.leave'),
                destructive: true
            },
            { label: locale.t('groups.leaveTitle', { name: one.name }) }
        ).closed;

        if (yes !== true)
        {
            return;
        }

        if (await attempt(groups.leave(one.id), { kind: 'info', text: locale.t('groups.left', { name: one.name }) }))
        {
            navigate('/app/friends');
        }
    };

    const manage = (crew: GroupSummary, member: GroupMember) =>
    {
        overlay.open(GroupMemberSheet, { member, group: crew }, { label: locale.t('groups.manage', { name: member.person.displayName }) });
    };

    <Page label={ name }>
        <Show when={ loading }>
            { () =>
                <div class="flex flex-col items-center gap-3 pt-4" data-reading>
                    <span class="sr-only">{ locale.t('common.loading') }</span>
                    <Skeleton class="h-20 w-20 rounded-panel" />
                    <Skeleton class="h-7 w-48" />
                    <Skeleton class="h-5 w-64" />
                </div>
            }
        </Show>

        <Show when={ failed }>
            { () => <ErrorState error={ groups.viewFailed() } title={ locale.t('state.errorTitle') } lead={ locale.t('state.errorLead') } onRetry={ () => void groups.refresh() } class="py-12" /> }
        </Show>

        <Show when={ missing }>
            { () => <EmptyState icon="people" heading title={ locale.t('groups.notFound') } action={ locale.t('app.nav.friends') } to="/app/friends" class="py-12" /> }
        </Show>

        <Show when={ group } let={ crew }>
            <div class="flex flex-col gap-6">
                <section class="hero-surface relative overflow-hidden rounded-hero p-5 @xl:p-7" aria-labelledby="group-name">
                    <div class="relative grid gap-6 @2xl:grid-cols-[minmax(0,1fr)_auto] @2xl:items-center">
                        <div class="flex min-w-0 items-center gap-4">
                            <GroupCrest crest={ crew.crest } hue={ crew.hue } photo={ crew.photo } size="lg" />
                            <div class="flex min-w-0 flex-col gap-1.5">
                                <h1 id="group-name" class="title truncate text-ui-2xl @xl:text-ui-3xl" dir="auto">{ crew.name }</h1>
                                <Show when={ blurbed }>
                                    { () => <p class="max-w-[52ch] text-ui-md text-muted" dir="auto">{ crew.blurb }</p> }
                                </Show>
                                <p class="facts text-ui-sm text-muted">
                                    <span><span class="tally">{ locale.n(crew.memberCount) }</span> { locale.plural('groups.membersLabel', crew.memberCount) }</span>
                                    <Show when={ anyOnline }>
                                        { () => <span><span class="text-live"><span class="tally">{ locale.n(online.length) }</span> { locale.plural('groups.onlineLabel', online.length) }</span></span> }
                                    </Show>
                                    <Show when={ closedDoors }>
                                        { () => <span class="flex items-center gap-1"><Icon name="lock" size={ 13 } />{ locale.t('groups.private') }</span> }
                                    </Show>
                                    <Show when={ game } let={ played }>
                                        <span>{ locale.t(catalogue.byId(played).nameKey) }</span>
                                    </Show>
                                </p>
                                <Show when={ silenced }>
                                    { () =>
                                        <p class="flex items-center gap-1.5 text-ui-sm text-gold" data-muted>
                                            <Icon name="clock" size={ 14 } class="shrink-0" />
                                            <span>{ mutedWords }</span>
                                        </p>
                                    }
                                </Show>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-2 @2xl:flex @2xl:w-56 @2xl:flex-col">
                            <Show
                                when={ joined }
                                fallback={
                                    <Show
                                        when={ waits }
                                        fallback={ <Button variant="primary" leading="friend-add" block class="col-span-2" loading={ joining } onClick={ () => void join(crew) }>{ joinWords }</Button> }
                                    >
                                        { () =>
                                            <div class="col-span-2 flex flex-col gap-2" data-asked>
                                                <p class="text-ui-sm text-muted" dir="auto">{ askedWords }</p>
                                                <Button variant="outline" block onClick={ () => withdraw(crew) }>{ locale.t('groups.withdraw') }</Button>
                                            </div>
                                        }
                                    </Show>
                                }
                            >
                                { () =>
                                    <>
                                        <Show when={ roomed }>
                                            { () => <Button variant="primary" leading="play" block class="col-span-2" onClick={ playTogether }>{ locale.t('groups.playTogether') }</Button> }
                                        </Show>
                                        <Show when={ roomed }>
                                            { () => <Button variant="secondary" leading="chats" block to={ `/app/chats/${ crew.conversationId ?? '' }` }>{ locale.t('groups.chat') }</Button> }
                                        </Show>
                                        <Show when={ playable }>
                                            { () => <Button variant="outline" leading="add" block to={ `/app/games/${ game ?? '' }/create` }>{ locale.t('groups.createGame') }</Button> }
                                        </Show>
                                    </>
                                }
                            </Show>
                        </div>
                    </div>
                </section>

                <Show when={ tabbed }>
                    { () => <Tabs label={ name } value={ tab } onChange={ show } items={ tabs } /> }
                </Show>

                <Show when={ onRequests }>
                    { () => <GroupRequests /> }
                </Show>

                <Show when={ onLinks }>
                    { () => <GroupLinks /> }
                </Show>

                <Show when={ onBanned }>
                    { () => <GroupBanned /> }
                </Show>

                <Show when={ onLog }>
                    { () => <GroupLog /> }
                </Show>

                <section hidden={ !onMembers }>
                    <SectionHeading
                        title={ locale.t('groups.members') }
                        actions={
                            <>
                                <Show when={ editable }>
                                    { () => <IconButton icon="edit" label={ locale.t('groups.edit') } variant="ghost" size="sm" onClick={ edit } /> }
                                </Show>
                                <Show when={ adds }>
                                    { () => <IconButton icon="friend-add" label={ locale.t('groups.add') } variant="ghost" size="sm" onClick={ addSomebody } /> }
                                </Show>
                            </>
                        }
                    />

                    <Show when={ searchable }>
                        { () =>
                            <div ref={ (element) => searchBox = element } class="mb-3">
                                <SearchInput
                                    value={ query }
                                    onInput={ search }
                                    placeholder={ locale.t('groups.searchMembers') }
                                    label={ locale.t('groups.searchMembers') }
                                />
                            </div>
                        }
                    </Show>

                    <Show when={ nobodyFound }>
                        { () =>
                            <EmptyState
                                icon="search"
                                title={ locale.t('search.empty', { query: query.trim() }) }
                                action={ locale.t('search.clearQuery') }
                                wayBack
                                onAction={ clearSearch }
                                class="py-8"
                            />
                        }
                    </Show>

                    <Show when={ listReading }>
                        { () =>
                            <div class="flex flex-col gap-2" data-reading>
                                <span class="sr-only">{ locale.t('common.loading') }</span>
                                <Skeleton class="h-16 w-full rounded-tile" />
                                <Skeleton class="h-16 w-full rounded-tile" />
                            </div>
                        }
                    </Show>

                    <Show when={ listFailed }>
                        { () => <ErrorState compact error={ admin.failure() } title={ locale.t('state.errorTitle') } lead={ locale.t('state.errorLead') } onRetry={ () => void admin.refresh() } /> }
                    </Show>

                    <ul class="flex flex-col divide-y divide-line rounded-panel border border-line bg-field px-2 empty:hidden" aria-label={ locale.t('groups.members') }>
                        <For each={ members } key={ (member) => member.person.handle } let={ member }>
                            <li>
                                <GroupMemberRow member={ member } group={ crew } onManage={ (one) => manage(crew, one) } />
                            </li>
                        </For>
                    </ul>
                    <Show when={ moreMembers }>
                        { () => <LoadMore label={ locale.t('groups.moreMembers') } onMore={ () => void admin.more() } /> }
                    </Show>
                </section>

                <div class="flex flex-col items-center gap-4">
                    <p class="flex flex-wrap items-center justify-center gap-2 text-ui-xs text-faint">
                        <Icon name="history" size={ 13 } />
                        { locale.t('groups.since', { date: locale.date(Date.parse(crew.createdAt), { year: 'numeric', month: 'long' }) }) }
                        <span class="h-1 w-1 rounded-full bg-current opacity-50" aria-hidden="true"></span>
                        <span>{ locale.t('groups.owner') }: <span dir="ltr">@{ crew.owner }</span></span>
                    </p>
                    <Show when={ joined }>
                        { () =>
                            <Button variant="destructive" size="sm" leading="sign-out" onClick={ () => void leave(crew) }>
                                { locale.t('groups.leave') }
                            </Button>
                        }
                    </Show>
                </div>
            </div>
        </Show>
    </Page>
}
