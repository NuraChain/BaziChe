import { bundleOf, lookOf, type ShopSlot } from '../../../../backend/src/domains/shop/catalogue.ts';
import { NURA_CHAIN } from '../../data/chain.ts';
import { GAMES } from '../../data/games.ts';
import Icon from '../../icons/icon.component.azeroth';
import { explorerTx, nuraOf } from '../../lib/nura.ts';
import { bundleSaving, collectionName, gameOfSlot, itemName, slotsFor } from '../../lib/shop.ts';
import { shortAddress } from '../../lib/wallet.ts';
import { namesOf, narrowed } from '../../services/search.service.ts';
import { useLocale } from '../../stores/locale.store.ts';
import type { OverlayProps } from '../../stores/overlay.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import { useShop } from '../../stores/shop.store.ts';
import { useSocial } from '../../stores/social.store.ts';
import Avatar from '../ui/avatar.component.azeroth';
import Badge from '../ui/badge.component.azeroth';
import Button from '../ui/button.component.azeroth';
import IconButton from '../ui/icon-button.component.azeroth';
import SearchInput from '../ui/search-input.component.azeroth';
import Spinner from '../ui/spinner.component.azeroth';

const TIER_TONE = { common: 'neutral', rare: 'accent', epic: 'epic', legendary: 'gold' } as const;

export default component LookSheet(props: OverlayProps & { item: string })
{
    const locale = useLocale();
    const shop = useShop();
    const social = useSocial();
    const people = usePeople();

    state giving = false;

    state query = '';

    derived look = lookOf(props.item) ?? null;

    derived bundle = bundleOf(props.item) ?? null;

    derived bundled = bundle !== null;

    derived name = itemName(props.item, locale);

    derived collectionId = look?.collection ?? bundle?.collection ?? 'glow';

    derived collection = collectionName(collectionId, locale);

    derived tier = look?.tier ?? null;

    derived mythic = tier === 'mythic';

    derived ranked = tier !== null && !mythic;

    derived tierWord = tier === null ? '' : locale.t(`shop.tier.${ tier }`);

    derived tierTone = tier === null || tier === 'mythic' ? 'neutral' : TIER_TONE[tier];

    derived where = look === null ? '' : locale.t(`shop.where.${ look.kind }`);

    derived held = shop.state();

    derived may = held !== null && held.open ? held.may : null;

    derived asked = shop.priceFor(props.item);

    derived owned = shop.owns(props.item);

    derived price = asked === null ? '' : locale.n(nuraOf(asked.price), { maximumFractionDigits: 4 });

    derived was = asked?.was === undefined ? '' : locale.n(nuraOf(asked.was), { maximumFractionDigits: 4 });

    derived sale = asked?.until === undefined ? '' : locale.t('shop.sale.until', { date: locale.date(Date.parse(asked.until), { dateStyle: 'medium', timeStyle: 'short' }) });

    derived onSale = was !== '';

    derived count = bundle?.looks.length ?? 0;

    derived holds = locale.plural('shop.bundle.holds', count);

    derived saves = locale.t('shop.bundle.saves', { percent: locale.n(bundleSaving(held, props.item), { style: 'percent', maximumFractionDigits: 0 }) });

    derived lacking = bundle === null ? 0 : bundle.looks.filter((one) => !shop.owns(one)).length;

    derived partly = bundled && lacking > 0 && lacking < count;

    derived lackingWords = locale.plural('shop.bundle.left', lacking);

    derived slots = look === null ? [] : slotsFor(look.kind);

    derived buying = shop.buying();

    derived mine = buying !== null && buying.item === props.item;

    derived step = mine ? buying!.step : null;

    derived working = step === 'preparing' || step === 'wallet' || step === 'chain';

    derived finished = step === 'done';

    derived failed = step === 'failed';

    derived elsewhere = buying !== null && !mine && (buying.step === 'preparing' || buying.step === 'wallet' || buying.step === 'chain');

    derived open = may !== null;

    derived refusedWallet = may === 'shop-wallet';

    derived refusedMinor = may === 'shop-minor';

    derived buyable = may === 'yes' && !owned && asked !== null && !working && !elsewhere;

    derived givable = may === 'yes' && asked !== null && !working && !elsewhere && !finished;

    derived usable = open && owned && !bundled && !working;

    derived wholly = bundled && owned;

    derived stepWords = step === 'wallet'
        ? locale.t('shop.step.wallet', { price, address: shortAddress(buying?.from ?? '') })
        : locale.t(step === 'chain' ? 'shop.step.chain' : 'shop.step.preparing');

    derived link = buying?.hash === null || buying?.hash === undefined || buying.chainId === null ? null : explorerTx(buying.chainId, buying.hash);

    derived linked = mine && link !== null;

    derived recipient = buying?.for ?? null;

    derived doneWords = recipient !== null
        ? locale.t('shop.step.sent', { name: people.byHandle(recipient)?.displayName ?? recipient })
        : locale.t(buying?.said === 'shop.step.nothing' ? 'shop.step.nothing' : 'shop.step.mine');

    derived short = mine ? buying!.short : null;

    derived shortWords = short === null
        ? ''
        : short.held === null
            ? locale.t('shop.shortPlain')
            : locale.t('shop.short', { price: locale.n(nuraOf(short.price), { maximumFractionDigits: 4 }), held: locale.n(nuraOf(short.held), { maximumFractionDigits: 4 }) });

    derived isShort = short !== null;

    derived failWords = locale.t(buying?.said ?? 'common.actionFailed');

    derived plainFail = failed && !isShort;

    derived friends = narrowed(social.friends(), query, (handle) => namesOf({ displayName: people.byHandle(handle)?.displayName ?? handle, handle }));

    derived lonely = social.friends().length === 0;

    derived nobody = !lonely && friends.length === 0;

    derived listed = friends.length > 0;

    mount
    {
        const unwatch = shop.watch(props.item);

        return () =>
        {
            unwatch();
            shop.forget();
        };
    }

    const buy = () =>
    {
        void shop.buy(props.item);
    };

    const send = (handle: string) =>
    {
        giving = false;
        query = '';
        void shop.buy(props.item, handle);
    };

    const useAt = (slot: ShopSlot) =>
    {
        void shop.choose(slot, props.item);
    };

    const slotWords = (slot: ShopSlot, chosen: boolean) =>
    {
        const game = GAMES.find((one) => one.id === gameOfSlot(slot));

        if (slots.length === 1 || game === undefined)
        {
            return locale.t(chosen ? 'shop.inUse' : 'shop.use');
        }

        return locale.t(chosen ? 'shop.inUseAt' : 'shop.useAt', { game: locale.t(game.nameKey) });
    };

    <div class="@container flex max-h-[inherit] min-h-0 flex-col" data-look-sheet={ props.item }>
        <header class="flex items-start justify-between gap-3 px-5 pb-2 pt-4">
            <div class="min-w-0">
                <h2 class="title text-ui-xl text-text">{ giving ? locale.t('shop.gift.title', { look: name }) : name }</h2>
                <p class="mt-1 flex flex-wrap items-center gap-2 text-ui-sm text-muted">
                    <img src={ `/sigils/${ collectionId }.svg` } alt="" width="20" height="20" decoding="async" class="h-5 w-5 shrink-0" data-sigil={ collectionId } />
                    <span>{ collection }</span>
                    <Show when={ ranked }>
                        <Badge text={ tierWord } tone={ tierTone } size="sm" />
                    </Show>
                    <Show when={ mythic }>
                        <span class="tier-mythic inline-flex h-4 min-w-4 items-center justify-center rounded-full px-1 text-ui-2xs font-bold leading-none">{ tierWord }</span>
                    </Show>
                </p>
            </div>
            <Show when={ giving }>
                <IconButton icon="back" label={ locale.t('app.nav.back') } variant="ghost" class="icon-flip" onClick={ () => giving = false } />
            </Show>
            <IconButton icon="close" label={ locale.t('common.close') } variant="ghost" onClick={ () => props.close() } />
        </header>

        <Show when={ giving }>
            <div class="flex min-h-0 flex-col">
                <div class="px-5 pb-3">
                    <SearchInput value={ query } onInput={ (value) => query = value } placeholder={ locale.t('shop.gift.search') } label={ locale.t('shop.gift.search') } autofocus />
                </div>
                <div class="min-block-0 overflow-y-auto overscroll-contain px-3 pb-4 [touch-action:pan-y]">
                    <Show when={ lonely }>
                        <p class="px-2 pb-2 text-ui-sm text-muted">{ locale.t('shop.gift.none') }</p>
                    </Show>
                    <Show when={ nobody }>
                        <p class="px-2 pb-2 text-ui-sm text-muted">{ locale.t('shop.gift.nobody') }</p>
                    </Show>
                    <Show when={ listed }>
                        <ul class="flex flex-col gap-0.5" data-gift-friends>
                            <For each={ friends } key={ (handle) => handle } let={ handle }>
                                <li class="flex min-h-14 items-center gap-3 rounded-tile px-2 py-2">
                                    <Avatar person={ people.byHandle(handle) } size="md" />
                                    <span class="flex min-w-0 flex-1 flex-col">
                                        <span class="truncate text-ui-base font-semibold text-text" dir="auto">{ people.byHandle(handle)?.displayName ?? handle }</span>
                                        <span class="truncate text-ui-xs text-muted" dir="ltr">@{ handle }</span>
                                    </span>
                                    <Button variant="primary" size="sm" leading="gift" class="shrink-0 whitespace-nowrap" label={ locale.t('shop.gift.pick', { name: people.byHandle(handle)?.displayName ?? handle }) } onClick={ () => send(handle) }>
                                        { locale.t('shop.gift.send') }
                                    </Button>
                                </li>
                            </For>
                        </ul>
                    </Show>
                </div>
            </div>
        </Show>

        <Show when={ !giving }>
            <div class="min-block-0 overflow-y-auto overscroll-contain px-5 pb-5 [touch-action:pan-y]">
                <div class="grid gap-5 @xl:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] @xl:items-start">
                    <img src={ `/looks/${ props.item }.svg` } alt="" width="320" height="240" decoding="async" class="look-large block aspect-[4/3] w-full rounded-hero border border-line" data-tier={ look?.tier ?? 'bundle' } />

                    <div class="flex min-w-0 flex-col gap-4">
                        <Show when={ !bundled }>
                            <div class="flex flex-col gap-1.5">
                                <p class="text-ui-base text-text">{ where }</p>
                                <p class="text-ui-sm text-muted">{ locale.t('shop.where.everyone') }</p>
                            </div>
                        </Show>
                        <Show when={ bundled }>
                            <div class="flex flex-col gap-1.5">
                                <p class="text-ui-base text-text">{ holds }</p>
                                <p class="text-ui-sm font-semibold text-live">{ saves }</p>
                                <Show when={ partly }>
                                    <p class="text-ui-sm text-muted">{ lackingWords }</p>
                                </Show>
                            </div>
                        </Show>

                        <Show when={ buyable }>
                            <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                                <span class="text-ui-2xl font-bold text-text"><span class="tally">{ price }</span> NURA</span>
                                <Show when={ onSale }>
                                    <s class="text-ui-sm text-faint"><span class="tally">{ was }</span> NURA</s>
                                    <span class="text-ui-xs text-gold">{ sale }</span>
                                </Show>
                            </div>
                        </Show>

                        <Show when={ wholly }>
                            <p class="flex items-center gap-2 text-ui-sm font-semibold text-live"><Icon name="selected" size={ 15 } />{ locale.t('shop.owned') }</p>
                        </Show>

                        <Show when={ refusedWallet }>
                            <p class="rounded-tile border border-line bg-sunk p-3 text-ui-sm text-muted">{ locale.t('shop.may.wallet') }</p>
                        </Show>
                        <Show when={ refusedMinor }>
                            <p class="rounded-tile border border-line bg-sunk p-3 text-ui-sm text-muted">{ locale.t('shop.may.minor') }</p>
                        </Show>
                        <Show when={ elsewhere }>
                            <p class="text-ui-sm text-muted">{ locale.t('shop.busy') }</p>
                        </Show>

                        <Show when={ working }>
                            <div role="status" class="flex items-start gap-3 rounded-tile border border-line bg-sunk p-3" data-buy-step={ step ?? '' }>
                                <Spinner size={ 16 } />
                                <div class="flex min-w-0 flex-col gap-1">
                                    <p class="text-ui-sm text-text">{ stepWords }</p>
                                    <Show when={ linked }>
                                        <a href={ link ?? '' } target="_blank" rel="noopener noreferrer" class="text-ui-sm font-semibold text-accent underline-offset-2 hover:underline">{ locale.t('shop.step.transaction') }</a>
                                    </Show>
                                </div>
                            </div>
                        </Show>

                        <Show when={ finished }>
                            <div role="status" class="flex items-start gap-3 rounded-tile border border-live/40 bg-live/10 p-3" data-buy-step="done">
                                <Icon name="check-circle" size={ 18 } class="shrink-0 text-live" />
                                <div class="flex min-w-0 flex-col gap-1">
                                    <p class="text-ui-sm font-semibold text-text">{ doneWords }</p>
                                    <Show when={ linked }>
                                        <a href={ link ?? '' } target="_blank" rel="noopener noreferrer" class="text-ui-sm font-semibold text-accent underline-offset-2 hover:underline">{ locale.t('shop.step.transaction') }</a>
                                    </Show>
                                </div>
                            </div>
                        </Show>

                        <Show when={ failed }>
                            <div role="alert" class="flex flex-col gap-2 rounded-tile border border-gold/40 bg-gold/10 p-3" data-buy-step="failed">
                                <Show when={ plainFail }>
                                    <p class="text-ui-sm text-text">{ failWords }</p>
                                </Show>
                                <Show when={ isShort }>
                                    <p class="text-ui-sm text-text">{ shortWords }</p>
                                    <a href={ NURA_CHAIN.site } target="_blank" rel="noopener noreferrer" class="self-start text-ui-sm font-semibold text-accent underline-offset-2 hover:underline">{ locale.t('shop.getNura') }</a>
                                </Show>
                            </div>
                        </Show>

                        <Show when={ usable }>
                            <ul class="flex flex-wrap gap-2">
                                <For each={ slots } key={ (slot) => slot } let={ slot }>
                                    <li>
                                        <Button
                                            variant={ shop.chosen(slot) === props.item ? 'secondary' : 'primary' }
                                            leading={ shop.chosen(slot) === props.item ? 'selected' : undefined }
                                            pressed={ shop.chosen(slot) === props.item }
                                            onClick={ () => useAt(slot) }
                                        >
                                            { slotWords(slot, shop.chosen(slot) === props.item) }
                                        </Button>
                                    </li>
                                </For>
                            </ul>
                        </Show>

                        <div class="flex flex-col gap-2">
                            <Show when={ buyable }>
                                <Button variant="primary" size="lg" block leading="coins" onClick={ buy }>{ locale.t('shop.buy', { price }) }</Button>
                            </Show>
                            <Show when={ givable }>
                                <Button variant="outline" size="lg" block leading="gift" onClick={ () => giving = true }>{ locale.t('shop.give') }</Button>
                            </Show>
                        </div>
                    </div>
                </div>
            </div>
        </Show>
    </div>
}
