import LandingGameCard from '../components/games/landing-game-card.component.azeroth';
import { GAMES } from '../data/games.ts';
import { useLocale } from '../stores/locale.store.ts';

export default component SceneGames()
{
    const locale = useLocale();

    <section id="games" class="landing-tour" aria-labelledby="games-title">
        <h2 id="games-title" class="sr-only">{ locale.t('landing.cta.games') }</h2>
        <ol>
            <For each={ GAMES } key={ (game) => game.id } let={ game } index={ index }>
                <li><LandingGameCard game={ game } next={ GAMES[index + 1] } /></li>
            </For>
        </ol>
    </section>
}
