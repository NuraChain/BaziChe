import { GAMES } from '../data/games.ts';
import PlayCta from '../components/layout/play-cta.component.azeroth';
import Button from '../components/ui/button.component.azeroth';
import { useFocus } from '../stores/focus.store.ts';
import { useLocale } from '../stores/locale.store.ts';

export default component SceneArrival(props: { returning: boolean })
{
    const locale = useLocale();
    const focus = useFocus();

    mount
    {
        return () => focus.focus(null);
    }

    <section data-beat="arrival" class="landing-arrival" aria-labelledby="arrival-title">
        <div class="landing-intro">
            <p class="landing-kicker">
                <span>{ locale.t('games.category.cards') }</span>
                <span aria-hidden="true">/</span>
                <span>{ locale.t('games.category.board') }</span>
            </p>
            <h1 id="arrival-title" class="landing-title">
                <span>{ locale.t('landing.arrival.lead') }</span>
                <span>{ locale.t('landing.arrival.accent') }</span>
            </h1>
            <p class="landing-lead">{ locale.t('landing.arrival.body') }</p>
            <div class="landing-actions">
                <PlayCta returning={ props.returning } />
                <Button href="#games" variant="ghost" size="lg">{ locale.t('landing.cta.games') }</Button>
            </div>
            <nav class="landing-quick" aria-label={ locale.t('nav.games') }>
                <For each={ GAMES } key={ (game) => game.id } let={ game }>
                    <a
                        data-game-color={ game.id }
                        href={ `/app/games/${ game.slug }` }
                        aria-label={ locale.t('landing.games.playGame', { game: locale.t(game.nameKey) }) }
                        onPointerEnter={ (event) => { if (event.pointerType === 'mouse') focus.focus(game.id); } }
                        onPointerLeave={ () => focus.focus(null) }
                        onFocus={ () => focus.focus(game.id) }
                        onBlur={ () => focus.focus(null) }
                    >
                        <span>{ locale.t(game.nameKey) }</span>
                    </a>
                </For>
            </nav>
        </div>
    </section>
}
