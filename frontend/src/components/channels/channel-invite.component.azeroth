import type { ChannelSummary } from '../../api.ts';
import type { Person } from '../../data/person.ts';
import { whyFailed } from '../../lib/failure.ts';
import { copyText } from '../../lib/clipboard.ts';
import { namesOf, narrowed, SEARCH_FROM } from '../../services/search.service.ts';
import { useChannels } from '../../stores/channels.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import type { OverlayProps } from '../../stores/overlay.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import { useSocial } from '../../stores/social.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';
import Avatar from '../ui/avatar.component.azeroth';
import Button from '../ui/button.component.azeroth';
import EmptyState from '../ui/empty-state.component.azeroth';
import SearchInput from '../ui/search-input.component.azeroth';
import SheetHeader from '../ui/sheet-header.component.azeroth';

/**
 * Who can be invited into a channel: the people this account has added, minus whoever is in it
 * already. Friends only, as a group's door is; the server's rule (`mayMessage`) is the floor. A
 * public channel's link can be shared besides.
 */
export default component ChannelInvite(props: OverlayProps & { channel: ChannelSummary; members: string[] })
{
    const locale = useLocale();
    const channels = useChannels();
    const social = useSocial();
    const people = usePeople();
    const toasts = useToasts();

    state pending = '';
    state query = '';
    state invited = [] as string[];

    derived everyone = social.friends()
        .filter((handle) => !props.members.includes(handle) && !invited.includes(handle))
        .map((handle) => people.byHandle(handle))
        .filter((person): person is Person => person !== null);

    derived candidates = narrowed(everyone, query, namesOf);

    derived open = props.channel.privacy === 'public';

    const invite = async (person: Person) =>
    {
        if (pending !== '')
        {
            return;
        }

        pending = person.id;

        try
        {
            await channels.invite(props.channel.slug, person.id);
            invited = [...invited, person.id];
            toasts.show({ kind: 'success', text: locale.t('channels.invited', { name: person.displayName }) });
        }
        catch (error)
        {
            toasts.show({ kind: 'warning', text: locale.t(whyFailed(error)) });
        }
        finally
        {
            pending = '';
        }
    };

    const link = () => void copyText(`${ location.origin }/app/channels/${ encodeURIComponent(props.channel.slug) }`, 'channels.linkCopied', { dedupe: 'channel-link' });

    <div class="flex flex-col gap-4 p-5" data-channel-invite>
        <SheetHeader title={ locale.t('channels.inviteTitle', { name: props.channel.name }) } lead={ locale.t('channels.inviteLead') } onClose={ () => props.close() } />

        <Show when={ open }>
            { () => <Button variant="secondary" leading="invite" block onClick={ link }>{ locale.t('channels.copyLink') }</Button> }
        </Show>

        <Show when={ everyone.length > SEARCH_FROM }>
            { () => <SearchInput value={ query } onInput={ (value) => query = value } placeholder={ locale.t('create.search') } label={ locale.t('create.search') } /> }
        </Show>

        <Show
            when={ candidates.length > 0 }
            fallback={ <EmptyState icon="people" title={ locale.t('channels.inviteNone') } class="py-6" /> }
        >
            { () =>
                <ul class="flex flex-col gap-1" aria-label={ locale.t('channels.invite') }>
                    <For each={ candidates } key={ (person) => person.id } let={ person }>
                        <li>
                            <button
                                type="button"
                                class="flex min-h-14 w-full cursor-pointer items-center gap-3 rounded-tile px-2 py-2 text-start transition-colors hover:bg-raised/60"
                                disabled={ pending !== '' }
                                onClick={ () => void invite(person) }
                            >
                                <Avatar person={ person } size="sm" />
                                <span class="flex min-w-0 flex-1 flex-col">
                                    <span class="truncate text-ui-sm font-semibold text-text" dir="auto">{ locale.text(person.displayName) }</span>
                                    <span class="truncate text-ui-xs text-muted">@{ person.handle }</span>
                                </span>
                                <span class="text-ui-xs font-semibold text-accent">{ locale.t('channels.invite') }</span>
                            </button>
                        </li>
                    </For>
                </ul>
            }
        </Show>
    </div>
}
