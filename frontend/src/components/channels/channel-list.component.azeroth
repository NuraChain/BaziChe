import type { ChannelSummary } from '../../api.ts';
import { useChannels } from '../../stores/channels.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import Button from '../ui/button.component.azeroth';
import EmptyState from '../ui/empty-state.component.azeroth';
import ErrorState from '../ui/error-state.component.azeroth';
import Skeleton from '../ui/skeleton.component.azeroth';
import { postGist } from './channel-gist.ts';
import ChannelFace from './channel-face.component.azeroth';
import ChannelForm from './channel-form.component.azeroth';

/**
 * The Channels tab of the chats: the channels the reader is in, each with its newest post and how
 * many they have not read, New channel, and the public channels they could join.
 */
export default component ChannelList(props: { pane?: boolean })
{
    const locale = useLocale();
    const channels = useChannels();
    const overlay = useOverlay();

    mount
    {
        channels.want();
    }

    derived mine = channels.mine();

    derived others = channels.elsewhere();

    derived reading = channels.reading() === 'reading' && mine.length === 0;

    derived failed = channels.reading() === 'failed' && mine.length === 0;

    derived none = channels.reading() === 'read' && mine.length === 0;

    const make = () => overlay.open(ChannelForm, {}, { label: locale.t('channels.new') });

    const row = (channel: ChannelSummary, joined: boolean) =>
        <a
            href={ `/app/channels/${ encodeURIComponent(channel.slug) }` }
            class="flex min-h-16 items-center gap-3 rounded-tile px-3 py-2.5 transition-colors hover:bg-raised/60"
            data-channel={ channel.slug }
        >
            <ChannelFace name={ channel.name } photo={ channel.photo } seed={ channel.slug } />
            <span class="flex min-w-0 flex-1 flex-col">
                <span class="flex items-center gap-1.5">
                    <span class="truncate text-ui-base font-semibold text-text" dir="auto">{ channel.name }</span>
                </span>
                <span class="truncate text-ui-sm text-muted" dir="auto">
                    { joined
                        ? (channel.last === undefined ? locale.t('channels.noPosts') : postGist(channel.last, locale))
                        : locale.plural('channels.members', channel.memberCount, { count: locale.n(channel.memberCount) }) }
                </span>
            </span>
            <Show when={ (channel.unread ?? 0) > 0 }>
                { () => <span class="flex h-5 min-w-5 items-center justify-center rounded-full bg-accent px-1.5 text-ui-2xs font-semibold tabular-nums text-accent-ink" data-unread>{ locale.n(channel.unread ?? 0) }</span> }
            </Show>
        </a>;

    <div class={ () => (props.pane === true ? 'flex flex-col gap-4 px-2 pb-3' : 'flex flex-col gap-4') } data-channels>
        <Button variant="secondary" leading="megaphone" block onClick={ make }>{ locale.t('channels.new') }</Button>

        <Switch
            fallback={
                <ul class="flex flex-col gap-0.5" aria-label={ locale.t('channels.mine') }>
                    <For each={ mine } key={ (channel) => channel.id } let={ channel }>
                        <li>{ row(channel, true) }</li>
                    </For>
                </ul>
            }
        >
            <Match when={ reading }>
                <div class="flex flex-col" aria-busy="true">
                    <span class="sr-only">{ locale.t('common.loading') }</span>
                    <Skeleton avatar lines={ 2 } class="py-2" />
                    <Skeleton avatar lines={ 2 } class="py-2" />
                </div>
            </Match>
            <Match when={ failed }>
                <ErrorState compact error={ channels.failure() } onRetry={ () => void channels.refresh() } />
            </Match>
            <Match when={ none }>
                <EmptyState icon="megaphone" title={ locale.t('channels.empty') } lead={ locale.t('channels.emptyLead') } class="py-6" />
            </Match>
        </Switch>

        <Show when={ others.length > 0 }>
            { () =>
                <section class="flex flex-col gap-1" aria-label={ locale.t('channels.discover') }>
                    <h3 class="px-3 text-ui-xs font-semibold uppercase tracking-wide text-faint">{ locale.t('channels.discover') }</h3>
                    <ul class="flex flex-col gap-0.5">
                        <For each={ others } key={ (channel) => channel.id } let={ channel }>
                            <li>{ row(channel, false) }</li>
                        </For>
                    </ul>
                </section>
            }
        </Show>
    </div>
}
