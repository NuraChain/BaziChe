import { crestOf } from '../../data/crests.ts';
import Icon from '../../icons/icon.component.azeroth';

const BOX: Record<'sm' | 'md' | 'lg', string> = {
    sm: 'h-10 w-10 rounded-control',
    md: 'h-12 w-12 rounded-tile',
    lg: 'h-20 w-20 rounded-panel'
};

const GLYPH: Record<'sm' | 'md' | 'lg', number> = {
    sm: 18,
    md: 22,
    lg: 34
};

/** A group's mark: its photo when it has one, and its crest on its hue otherwise. */
export default component GroupCrest(props: { crest: string; hue: number; photo?: string; size?: 'sm' | 'md' | 'lg'; class?: string })
{
    derived size = props.size ?? 'md';

    derived source = props.photo ?? '';

    derived pictured = source !== '';

    <span
        class={ [
            'relative flex shrink-0 items-center justify-center overflow-hidden border border-line',
            BOX[size],
            props.class ?? ''
        ].filter(Boolean).join(' ') }
        style={ `--hue: ${ props.hue }` }
        aria-hidden="true"
        data-photo={ pictured ? '' : undefined }
    >
        <span
            class="absolute inset-0"
            style="background: linear-gradient(145deg, color-mix(in oklab, hsl(var(--hue) 62% 52%) 28%, var(--raised)), var(--raised))"
        ></span>
        <Show
            when={ pictured }
            fallback={
                <span class="relative" style="color: color-mix(in oklab, hsl(var(--hue) 70% 62%) 78%, var(--text))">
                    <Icon name={ crestOf(props.crest) } size={ GLYPH[size] } />
                </span>
            }
        >
            { () => <img src={ source } alt="" draggable="false" class="absolute inset-0 h-full w-full object-cover" /> }
        </Show>
    </span>
}
