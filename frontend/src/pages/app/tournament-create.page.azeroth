import { useHead, useNavigate } from 'azerothjs';

import { FORMATS, FORMAT_IDS, type FormatId } from '../../../../backend/src/domains/tournament/engine/formats.ts';
import { client } from '../../api.ts';
import Page from '../../components/app/page.component.azeroth';
import PageHeader from '../../components/app/page-header.component.azeroth';
import Button from '../../components/ui/button.component.azeroth';
import Field from '../../components/ui/field.component.azeroth';
import Input from '../../components/ui/input.component.azeroth';
import Segmented from '../../components/ui/segmented.component.azeroth';
import Select from '../../components/ui/select.component.azeroth';
import type { GameId } from '../../data/games.ts';
import '../../locales/tournament-catalogue.ts';
import { whyTournament } from '../../lib/tournament-refusal.ts';
import { runtime } from '../../lib/runtime.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';

const HOUR_MS = 3_600_000;

/** What a `datetime-local` field holds: the reader's own clock, with no zone written. */
const localInput = (at: number) =>
{
    const date = new Date(at);

    return new Date(at - date.getTimezoneOffset() * 60_000).toISOString().slice(0, 16);
};

export default component TournamentCreatePage()
{
    const locale = useLocale();
    const catalogue = useCatalogue();
    const toasts = useToasts();
    const { navigate } = useNavigate();

    derived games = catalogue.games.filter((game) => catalogue.status(game.id) === 'available');

    state name = '';
    state game = 'chess' as string;
    state format = 'single' as FormatId;
    state size = '8';
    state bestOf = '1';
    state listed = 'yes';
    state starts = localInput(runtime().clock.now() + HOUR_MS);
    state sending = false;

    derived sizes = FORMATS[format].sizes.map((one) => ({ id: String(one), label: locale.n(one) }));

    derived fittedSize = sizes.some((one) => one.id === size) ? size : sizes[0].id;

    derived gameOptions = games.map((one) => ({ value: one.id, label: locale.t(one.nameKey) }));

    derived formatOptions = FORMAT_IDS.map((id) => ({ value: id, label: locale.t(`tournaments.format.${ id }`) }));

    derived ready = name.trim() !== '' && starts !== '' && !sending;

    useHead({ title: () => locale.t('tournaments.new.title') });

    const submit = async () =>
    {
        if (!ready)
        {
            return;
        }

        sending = true;

        try
        {
            const made = await client.tournaments.create({
                input: {
                    name: name.trim(),
                    game: game as GameId,
                    format,
                    size: Number(fittedSize),
                    bestOf: Number(bestOf),
                    listed: listed === 'yes',
                    startsAt: new Date(starts).toISOString()
                }
            });

            navigate(`/app/tournaments/${ made.code }`);
        }
        catch (error)
        {
            toasts.show({ kind: 'warning', text: locale.t(whyTournament(error)), dedupe: 'tournament-new' });
        }
        finally
        {
            sending = false;
        }
    };

    <Page label={ locale.t('tournaments.new.title') }>
        <PageHeader title={ locale.t('tournaments.new.title') } lead={ locale.t('tournaments.new.lead') } />

        <form class="flex max-w-xl flex-col gap-4" onSubmit={ (event) => { event.preventDefault(); void submit(); } }>
            <Field id="tournament-name" label={ locale.t('tournaments.new.name') }>
                <Input id="tournament-name" value={ name } onInput={ (value) => name = value } maxlength={ 60 } placeholder={ locale.t('tournaments.new.namePlaceholder') } autofocus />
            </Field>

            <Select label={ locale.t('tournaments.new.game') } value={ game } options={ gameOptions } onChange={ (value) => game = value } />

            <Select label={ locale.t('tournaments.new.format') } value={ format } options={ formatOptions } hint={ locale.t(`tournaments.formatHint.${ format }`) } onChange={ (value) => format = value as FormatId } />

            <Field id="tournament-size" label={ locale.t('tournaments.new.size') }>
                <Segmented block items={ sizes } value={ fittedSize } label={ locale.t('tournaments.new.size') } onChange={ (id) => size = id } />
            </Field>

            <Field id="tournament-length" label={ locale.t('tournaments.new.length') }>
                <Segmented block items={ [ { id: '1', label: locale.t('tournaments.bestOf', { n: locale.n(1) }) }, { id: '3', label: locale.t('tournaments.bestOf', { n: locale.n(3) }) }, { id: '5', label: locale.t('tournaments.bestOf', { n: locale.n(5) }) } ] } value={ bestOf } label={ locale.t('tournaments.new.length') } onChange={ (id) => bestOf = id } />
            </Field>

            <Field id="tournament-starts" label={ locale.t('tournaments.new.starts') } hint={ locale.t('tournaments.new.startsHint') }>
                <Input id="tournament-starts" type="datetime-local" value={ starts } onInput={ (value) => starts = value } />
            </Field>

            <Field id="tournament-listed" label={ locale.t('tournaments.new.visibility') } hint={ locale.t(listed === 'yes' ? 'tournaments.new.listedHint' : 'tournaments.new.linkOnlyHint') }>
                <Segmented block items={ [ { id: 'yes', label: locale.t('tournaments.new.listed') }, { id: 'no', label: locale.t('tournaments.new.linkOnly') } ] } value={ listed } label={ locale.t('tournaments.new.visibility') } onChange={ (id) => listed = id } />
            </Field>

            <Button variant="primary" size="lg" block submit loading={ sending } disabled={ !ready }>{ locale.t('tournaments.create') }</Button>
        </form>
    </Page>
}
