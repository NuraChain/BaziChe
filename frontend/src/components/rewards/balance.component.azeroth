import { Show } from 'azerothjs';

import { useRewards } from '../../stores/rewards.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import Button from '../ui/button.component.azeroth';
import Panel from '../ui/panel.component.azeroth';

export default component Balance(props: { class?: string })
{
    const locale = useLocale();
    const rewards = useRewards();

    const cycleGranted = rewards.cycleGranted();
    const withdrawable = rewards.withdrawable();
    const reason = rewards.reason();

    const withdraw = async () =>
    {
        await rewards.withdraw();
    };

    return (
        <Panel section class={ props.class ?? '' }>
            <div class="flex flex-col gap-4">
                <div class="flex items-baseline justify-between gap-3">
                    <div class="flex flex-col gap-1">
                        <div class="text-xs text-muted">{ locale.t('app.rewards.balance') }</div>
                        <div class="text-ui-2xl font-mono text-text">{ cycleGranted }</div>
                    </div>
                    <div class="text-xs text-muted">{ locale.t('app.rewards.withdrawable') }</div>
                </div>
                <div class="w-full bg-border rounded-full h-2">
                    <div class="h-2 rounded-full bg-accent" style="width: min(100, (cycleGranted / 200000) * 100)%" />
                </div>
                <div class="text-xs text-muted text-right">
                    { cycleGranted } / 200,000 NURA
                </div>

                <Show when={ reason === undefined }>
                    { () =>
                        <div class="flex items-center justify-between gap-3">
                            <div class="text-xs text-muted">{ withdrawable } NURA available</div>
                            <Button
                                disabled={ withdrawable < 1000 }
                                onClick={ withdraw }
                                variant="primary"
                                block={ true }
                            >
                                { locale.t('app.rewards.withdraw') }
                            </Button>
                        </div>
                    }
                </Show>
                <Show when={ reason !== undefined }>
                    { () =>
                        <div class="flex items-center gap-3 text-xs text-muted">
                            <span>{ locale.t('app.rewards.notEligible') }</span>
                            <span>{ locale.t('app.rewards.notEligibleLead') }</span>
                        </div>
                    }
                </Show>
            </div>
        </Panel>
    );
}
