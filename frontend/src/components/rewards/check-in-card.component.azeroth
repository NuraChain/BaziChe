import { whyRewards } from '../../lib/reward-words.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useRewards } from '../../stores/rewards.store.ts';
import Icon from '../../icons/icon.component.azeroth';
import Button from '../ui/button.component.azeroth';
import Panel from '../ui/panel.component.azeroth';

/** The thirty-day ladder: the tile today's check-in pays, or paid, is the one ringed. */
export default component CheckInCard(props: { class?: string })
{
    const locale = useLocale();
    const rewards = useRewards();

    derived held = rewards.state();

    derived ladder = held?.ladder ?? [];

    // `today` is an absolute day number; the ladder is counted by `position` alone.
    derived position = held?.position ?? 0;

    derived streak = held?.streak ?? 0;

    derived claimable = held?.claimable ?? false;

    derived checking = rewards.busy() === 'check-in';

    derived said = rewards.said();

    derived saying = said !== null && said.on === 'check-in';

    derived why = said === null ? '' : whyRewards(said.reason, locale);

    <Panel section class={ props.class ?? '' } labelledBy="reward-check-in">
        <div class="flex flex-col gap-4">
            <div class="flex items-baseline gap-2">
                <h2 id="reward-check-in" class="text-ui-lg font-semibold text-text">{ locale.t('app.rewards.streak') }</h2>
                <span class="tally text-ui-xl font-mono text-accent">{ locale.n(streak) }</span>
            </div>

            <ol class="grid grid-cols-7 gap-1">
                <For each={ ladder } key={ (step) => step.day } let={ step }>
                    <li
                        class={ [
                            'aspect-square min-w-0 rounded-control border',
                            step.claimed ? 'border-accent/60 bg-accent/20' : 'border-line bg-field',
                            step.day === position ? 'ring-2 ring-accent' : ''
                        ].filter(Boolean).join(' ') }
                        aria-current={ step.day === position ? 'step' : undefined }
                        data-day={ step.day }
                    >
                        <span class="sr-only">
                            { locale.t(step.bonus === undefined ? 'app.rewards.dayPays' : 'app.rewards.dayBonus', { day: step.day, amount: step.amount + (step.bonus ?? 0) }) }
                        </span>
                        <span class="flex h-full w-full flex-col items-center justify-center gap-0.5 leading-none" aria-hidden="true">
                            <span class="text-ui-xs font-semibold text-text">{ locale.n(step.day) }</span>
                            <span class="text-[10px] text-muted">{ locale.n(step.amount + (step.bonus ?? 0)) }</span>
                            <Show when={ step.look !== undefined }>
                                <span class={ step.look === 'exclusive' ? 'text-accent' : 'text-muted' }>
                                    <Icon name="medal" size={ 10 } />
                                </span>
                            </Show>
                        </span>
                    </li>
                </For>
            </ol>

            <Button
                disabled={ !claimable }
                onClick={ () => void rewards.checkIn() }
                loading={ checking }
                variant={ claimable ? 'primary' : 'outline' }
                block={ true }
            >
                { locale.t(claimable ? 'app.rewards.checkIn' : 'app.rewards.checkedIn') }
            </Button>

            <Show when={ saying }>
                <p class="text-ui-sm text-muted" role="status">{ why }</p>
            </Show>
        </div>
    </Panel>
}
