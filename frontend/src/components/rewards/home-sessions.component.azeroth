import { Link } from 'azerothjs';

import type { GameId } from '../../data/games.ts';
import Icon from '../../icons/icon.component.azeroth';
import { findGame } from '../../lib/find-game.ts';
import { questWords } from '../../lib/reward-words.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useRewards } from '../../stores/rewards.store.ts';
import Button from '../ui/button.component.azeroth';
import SectionHeading from '../ui/section-heading.component.azeroth';

export default component HomeSessions()
{
    const locale = useLocale();
    const rewards = useRewards();

    derived daily = rewards.dailyQuests();

    derived weekly = rewards.weeklyQuests();

    derived weeklyClaimed = weekly.filter((quest) => quest.claimed).length;

    derived chest = rewards.state()?.chest ?? 0;

    derived chestOpened = rewards.state()?.chestClaimed === true;

    mount
    {
        rewards.want('state');
        return rewards.listen();
    }

    <Show when={ rewards.open() && daily.length > 0 }>
        <section aria-labelledby="home-sessions" class="flex flex-col gap-3">
            <div>
                <SectionHeading id="home-sessions" title={ locale.t('app.rewards.sessions.title') } more={ locale.t('common.seeAll') } to="/app/rewards" />
                <div class="flex items-center gap-2 text-ui-xs text-muted">
                    <span class="live-dot h-2 w-2" aria-hidden="true"></span>
                    <span>{ locale.t('app.rewards.sessions.alwaysOpen') }</span>
                    <span aria-hidden="true">·</span>
                    <span>{ locale.t('app.rewards.sessions.lead') }</span>
                </div>
            </div>

            <ul class="grid gap-3 @2xl:grid-cols-3">
                <For each={ daily } key={ (quest) => quest.id } let={ quest }>
                    <li class="flex min-w-0 flex-col gap-3 rounded-panel border border-line bg-field p-4" data-home-session={ quest.id }>
                        <div class="flex items-start justify-between gap-3">
                            <p class="min-w-0 text-ui-sm font-semibold leading-snug text-text">{ questWords(quest, locale) }</p>
                            <span class="shrink-0 rounded-full bg-accent/10 px-2.5 py-1 text-ui-xs font-semibold text-accent">+{ locale.n(quest.reward) } NURA</span>
                        </div>

                        <div class="flex items-center justify-between gap-3 text-ui-xs text-muted">
                            <span>{ locale.t('app.rewards.inProgress') }</span>
                            <span class="tally">{ locale.n(Math.min(quest.progress, quest.target)) } / { locale.n(quest.target) }</span>
                        </div>
                        <div
                            class="h-2 w-full overflow-hidden rounded-full bg-sunk"
                            role="progressbar"
                            aria-valuemin={ 0 }
                            aria-valuemax={ quest.target }
                            aria-valuenow={ Math.min(quest.progress, quest.target) }
                            aria-label={ questWords(quest, locale) }
                        >
                            <span
                                class={ [ 'block h-full rounded-full motion-safe:transition-[width]', quest.done ? 'bg-accent' : 'bg-accent/55' ].join(' ') }
                                style={ 'width: ' + (quest.target <= 0 ? 100 : Math.round(Math.min(quest.progress, quest.target) / quest.target * 100)) + '%' }
                            ></span>
                        </div>

                        <div class="mt-auto flex min-h-9 items-center justify-between gap-2 border-t border-line pt-3">
                            <Show when={ quest.claimed }>
                                <span class="flex items-center gap-1.5 text-ui-xs font-semibold text-win">
                                    <Icon name="check" size={ 14 } />
                                    { locale.t('app.rewards.claimed') }
                                </span>
                            </Show>
                            <Show when={ quest.done && !quest.claimed }>
                                <Button
                                    variant="primary"
                                    size="sm"
                                    loading={ rewards.busy() === 'quest:daily:' + quest.id }
                                    onClick={ () => void rewards.claimQuest('daily', quest.id) }
                                >
                                    { locale.t('app.rewards.claim') }
                                </Button>
                            </Show>
                            <Show when={ !quest.done && !quest.claimed }>
                                <Show
                                    when={ quest.game === 'any' }
                                    fallback={
                                        <Button variant="outline" size="sm" leading="play" onClick={ () => findGame(quest.game as GameId) }>
                                            { locale.t('app.rewards.sessions.play') }
                                        </Button>
                                    }
                                >
                                    <Link to="/app/games" class="inline-flex min-h-9 items-center gap-1.5 rounded-control border border-line px-3 text-ui-xs font-semibold text-text transition-colors hover:border-accent hover:text-accent">
                                        <Icon name="play" size={ 14 } />
                                        { locale.t('app.rewards.sessions.chooseGame') }
                                    </Link>
                                </Show>
                            </Show>
                        </div>
                    </li>
                </For>
            </ul>

            <Show when={ weekly.length > 0 }>
                <div class="flex flex-col gap-3 rounded-panel border border-line bg-raised p-4 @md:flex-row @md:items-center">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent/12 text-accent">
                        <Icon name="gift" size={ 18 } />
                    </span>
                    <div class="min-w-0 flex-1">
                        <div class="flex flex-wrap items-center gap-2">
                            <p class="text-ui-sm font-semibold text-text">{ locale.t('app.rewards.sessions.weekly') }</p>
                            <Show when={ chestOpened }>
                                <span class="rounded-full bg-win/10 px-2 py-0.5 text-ui-xs font-semibold text-win">{ locale.t('app.rewards.sessions.chestReady') }</span>
                            </Show>
                        </div>
                        <p class="mt-1 text-ui-xs text-muted">{ locale.t('app.rewards.sessions.weeklyProgress', { claimed: locale.n(weeklyClaimed) }) }</p>
                        <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-sunk" role="progressbar" aria-valuemin={ 0 } aria-valuemax={ 3 } aria-valuenow={ Math.min(weeklyClaimed, 3) }>
                            <span class="block h-full rounded-full bg-accent" style={ 'width: ' + Math.round(Math.min(weeklyClaimed, 3) / 3 * 100) + '%' }></span>
                        </div>
                    </div>
                    <p class="text-ui-xs text-muted @md:max-w-64 @md:text-end">{ locale.t('app.rewards.chest', { amount: chest }) }</p>
                </div>
            </Show>
        </section>
    </Show>
}
