import { onCleanup, untrack } from 'azerothjs';

import MatchResult from './match-result.component.azeroth';
import Button from '../ui/button.component.azeroth';
import { runtime } from '../../lib/runtime.ts';
import { useLocale } from '../../stores/locale.store.ts';
import type { MatchView } from '../../api.ts';
import type { Staked } from './boards.ts';

export const RESULT_OUT = 240;

// The longest ending a table plays, a six-way all-in before the flop, and two seconds over it: it
// grew when a won pot came to hold three seconds on its winner rather than one and a half.
export const RESULT_WAIT = 18_500;

export default component TableResult(props: { match: MatchView; shown: boolean; mine?: number; fold?: boolean; stake?: Staked; onStand?: (stands: boolean) => void; onShown?: (id: string) => void })
{
    const locale = useLocale();

    state folded = false;

    state last = untrack(() => ({ match: props.match, mine: props.mine, stake: props.stake }));

    state standing = false;

    derived drawn = standing && props.fold !== true;

    state leaving = false;

    state panel: HTMLDivElement | null = null;

    let stop: () => void = () => undefined;

    const gone = () =>
    {
        standing = false;
        folded = false;
    };

    effect
    {
        const now = { match: props.match, mine: props.mine, stake: props.stake };
        const shown = props.shown && now.match.finishedAt !== undefined;

        untrack(() =>
        {
            if (shown)
            {
                stop();
                last = now;
                standing = true;
                leaving = false;
            }
            else if (standing && !leaving)
            {
                if (now.match.id === last.match.id)
                {
                    gone();
                }
                else
                {
                    leaving = true;
                    stop = runtime().clock.after(RESULT_OUT, gone);
                }
            }
        });
    }

    effect
    {
        const fold = props.fold === true;

        untrack(() =>
        {
            if (fold)
            {
                folded = true;
            }
        });
    }

    effect
    {
        const stands = standing;

        untrack(() => props.onStand?.(stands));
    }

    effect
    {
        const node = panel;
        const id = last.match.id;
        const shown = props.onShown;

        if (drawn && !folded && node !== null && shown !== undefined)
        {
            const observer = new IntersectionObserver((entries) =>
            {
                if (entries.some((entry) => entry.isIntersecting))
                {
                    observer.disconnect();
                    shown(id);
                }
            });

            observer.observe(node);
            onCleanup(() => observer.disconnect());
        }
    }

    onCleanup(() => stop());

    <Show when={ drawn }>
        { () =>
            <Show
                when={ !folded }
                fallback={
                    <div class="table-result-tab" data-leaving={ leaving ? 'true' : undefined } inert={ leaving }>
                        <Button variant="secondary" size="md" leading="trophy" onClick={ () => folded = false }>{ locale.t('match.result.show') }</Button>
                    </div>
                }
            >
                { () =>
                    <div class="table-result" ref={ (element) => panel = element } data-leaving={ leaving ? 'true' : undefined } inert={ leaving }>
                        <div class="flex flex-col gap-2">
                            <div class="table-result-card">
                                <MatchResult match={ last.match } mine={ last.mine } stake={ last.stake } />
                            </div>
                            <Button variant="secondary" size="sm" class="self-center" onClick={ () => folded = true }>{ locale.t('match.result.board') }</Button>
                        </div>
                    </div>
                }
            </Show>
        }
    </Show>
}
