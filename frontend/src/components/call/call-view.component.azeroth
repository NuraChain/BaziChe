import { untrack } from 'azerothjs';

import ConfirmSheet from '../app/confirm-sheet.component.azeroth';
import Avatar from '../ui/avatar.component.azeroth';
import Button from '../ui/button.component.azeroth';
import Panel from '../ui/panel.component.azeroth';
import SheetHeader from '../ui/sheet-header.component.azeroth';
import VoiceInputSettings from '../voice/voice-input-settings.component.azeroth';
import VoiceOutputSettings from '../voice/voice-output-settings.component.azeroth';
import VoicePeer from '../voice/voice-peer.component.azeroth';
import VoiceChatPerson from './voice-chat-person.component.azeroth';
import { haptic } from '../../lib/haptics.ts';
import { runtime } from '../../lib/runtime.ts';
import { useAccount } from '../../stores/account.store.ts';
import { useCalls } from '../../stores/calls.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay, type OverlayProps } from '../../stores/overlay.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import { useRealtime } from '../../stores/realtime.store.ts';
import { useVoice } from '../../stores/voice.store.ts';
import { groupOfCall, heardIn, lastedOf, liveSaid, ticking, voiceChatSaid } from './said.ts';

/**
 * The live call, opened from its bar or its card (MS-D38): who it is with, ringed while they speak and
 * marked while they have muted themselves, how their line is doing, the reader's own microphone and
 * the way out, then the microphone's and the speaker's own settings. It goes when the call does.
 *
 * A group's voice chat lists everybody in it but the reader (MS-D33). The reader raises or lowers a
 * hand, and is told when they are held and so only listen; whoever may run it holds everybody below
 * them at once and ends it for everyone, which is asked first.
 */
export default component CallView(props: OverlayProps)
{
    const calls = useCalls();
    const account = useAccount();
    const locale = useLocale();
    const overlay = useOverlay();
    const people = usePeople();
    const voice = useVoice();
    const realtime = useRealtime();

    state now = runtime().clock.now();

    derived call = calls.current();

    derived live = call !== null && call.state === 'live';

    derived grouped = call !== null && call.kind === 'group';

    derived here = calls.here();

    derived person = call?.person ?? '';

    derived name = grouped ? (groupOfCall(call) ?? locale.t('call.voiceChat.action')) : (people.byHandle(person)?.displayName ?? person);

    derived heard = heardIn(call, here, voice);

    derived joining = here && voice.joining();

    derived lasted = lastedOf(call, now, realtime.toLocal);

    derived status = grouped ? voiceChatSaid(here, joining, lasted, locale) : liveSaid(here, heard, lasted, locale);

    derived them = voice.people().find((one) => one.who === person) ?? null;

    derived speaking = them !== null && them.speaking;

    derived quiet = them !== null && them.muted;

    derived muted = voice.muted();

    derived mic = voice.mic() === 'live';

    derived mine = call?.people?.find((one) => one.who === account.user()?.id) ?? null;

    derived listening = mine !== null && mine.held;

    derived speaks = here && !listening;

    derived handUp = mine !== null && mine.hand;

    derived runs = call?.may?.calls === true;

    derived others = (call?.people ?? []).filter((one) => one.who !== account.user()?.id).map((one) => one.who);

    derived company = others.length > 0;

    derived count = call?.people?.length ?? 0;

    derived title = locale.t(grouped ? 'call.voiceChat.title' : 'call.view.title', { name });

    derived leaves = locale.t(grouped ? 'call.voiceChat.leave' : 'call.hangUp');

    derived away = locale.t(grouped ? 'call.voiceChat.elsewhere' : 'call.elsewhere');

    derived id = call?.id ?? '';

    const end = async () =>
    {
        const asked = locale.t('call.voiceChat.endAsk');

        if ((await overlay.open(ConfirmSheet, { title: asked, lead: locale.t('call.voiceChat.endLead'), confirm: locale.t('call.voiceChat.endConfirm'), destructive: true }, { label: asked }).closed) === true)
        {
            void calls.end(id);
        }
    };

    effect
    {
        if (!live)
        {
            untrack(() => props.close());
        }
    }

    mount
    {
        const stopTicking = ticking((at) => now = at);
        const stopLines = voice.watchLines();

        return () =>
        {
            stopLines();
            stopTicking();
        };
    }

    <div class="flex flex-col gap-5 p-5" data-call-view={ id }>
        <SheetHeader title={ title } onClose={ () => props.close() } />
        <Show
            when={ grouped }
            fallback={
                <div class="flex flex-col items-center gap-2 text-center">
                    <span
                        class={ () => [ 'flex rounded-full transition-shadow duration-150', speaking ? 'ring-2 ring-live ring-offset-4 ring-offset-lifted' : '' ].join(' ') }
                        data-speaking={ speaking ? '' : undefined }
                        aria-hidden="true"
                    >
                        <Avatar person={ people.byHandle(person) } size="2xl" />
                    </span>
                    <span class="text-ui-xl font-semibold text-text" dir={ locale.dir() }><bdi>{ name }</bdi></span>
                    <span class="text-ui-sm text-muted" data-call-view-status>{ status }</span>
                    <Show when={ quiet }>
                        <span class="text-ui-xs text-gold" data-call-view-muted>{ locale.t('call.view.muted', { name }) }</span>
                    </Show>
                </div>
            }
        >
            <div class="flex flex-col items-center gap-1 text-center">
                <span class="text-ui-sm text-muted" data-call-view-status>{ status }</span>
                <Show when={ listening }>
                    <p class="text-balance text-ui-sm text-gold" data-call-view-held>{ locale.t('call.voiceChat.heldSelf') }</p>
                </Show>
            </div>
        </Show>
        <div class="flex flex-wrap justify-center gap-2" role="group" aria-label={ locale.t(grouped ? 'call.voiceChat.region' : 'call.region') }>
            <Show when={ speaks }>
                <span class="contents" data-call-view-mute>
                    <Button
                        variant={ muted ? 'outline' : 'secondary' }
                        leading={ muted ? 'voice-off' : 'voice' }
                        size="sm"
                        disabled={ !mic || joining }
                        pressed={ mic && !muted }
                        onClick={ () =>
                        {
                            haptic('tick');
                            voice.toggleMute();
                        } }
                    >
                        { locale.t(!mic ? 'voice.micUnavailable' : (muted ? 'voice.unmute' : 'voice.mute')) }
                    </Button>
                </span>
            </Show>
            <Show when={ grouped }>
                <span class="contents" data-call-view-hand>
                    <Button
                        variant={ handUp ? 'secondary' : 'outline' }
                        leading="hand"
                        size="sm"
                        pressed={ handUp }
                        onClick={ () =>
                        {
                            haptic('tick');
                            void calls.hand(id, !handUp);
                        } }
                    >
                        { locale.t(handUp ? 'call.voiceChat.lowerHand' : 'call.voiceChat.raiseHand') }
                    </Button>
                </span>
            </Show>
            <span class="contents" data-call-view-hang-up>
                <Button variant="destructive" size="sm" leading="hang-up" onClick={ () => void calls.hangUp(id) }>
                    { leaves }
                </Button>
            </span>
        </div>
        <Show when={ runs }>
            <div class="flex flex-wrap justify-center gap-2" data-call-view-staff>
                <span class="contents" data-call-view-hold-all>
                    <Button variant="outline" leading="voice-off" size="sm" onClick={ () => void calls.holdAll(id) }>
                        { locale.t('call.voiceChat.holdAll') }
                    </Button>
                </span>
                <span class="contents" data-call-view-end>
                    <Button variant="destructive-ghost" leading="hang-up" size="sm" onClick={ () => void end() }>
                        { locale.t('call.voiceChat.end') }
                    </Button>
                </span>
            </div>
        </Show>
        <Show when={ here } fallback={ <p class="text-center text-ui-sm text-muted" data-call-view-away>{ away }</p> }>
            <Show
                when={ grouped }
                fallback={
                    <section class="flex flex-col gap-3" aria-labelledby="call-view-people">
                        <h3 id="call-view-people" class="label text-ui-sm text-text">{ locale.t('voice.manager.people') }</h3>
                        <ul class="divide-y divide-line rounded-panel border border-line bg-field">
                            <li class="voice-peer" data-who={ person }>
                                <VoicePeer who={ person } />
                            </li>
                        </ul>
                    </section>
                }
            >
                <section class="flex flex-col gap-3" aria-labelledby="call-view-people">
                    <h3 id="call-view-people" class="label text-ui-sm text-text" data-call-view-count>{ locale.t('call.voiceChat.here', { count }) }</h3>
                    <Show when={ company } fallback={ <p class="text-ui-sm text-muted">{ locale.t('voice.manager.alone') }</p> }>
                        <ul class="divide-y divide-line rounded-panel border border-line bg-field">
                            <For each={ others } key={ (who) => who } let={ who }>
                                <li class="voice-peer" data-who={ who }>
                                    <VoiceChatPerson who={ who } />
                                </li>
                            </For>
                        </ul>
                    </Show>
                </section>
            </Show>
            <Panel stack="md">
                <VoiceInputSettings />
            </Panel>
            <Panel stack="md">
                <VoiceOutputSettings />
            </Panel>
        </Show>
    </div>
}
