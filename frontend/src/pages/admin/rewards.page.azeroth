import { useHead } from 'azerothjs';

import { may } from '../../../../backend/src/domains/admin/roles.ts';
import AdminHead from '../../components/admin/admin-head.component.azeroth';
import AdminRewardAmounts from '../../components/admin/admin-reward-amounts.component.azeroth';
import AdminRewardDays from '../../components/admin/admin-reward-days.component.azeroth';
import AdminRewardFrozen from '../../components/admin/admin-reward-frozen.component.azeroth';
import AdminRewardOverview from '../../components/admin/admin-reward-overview.component.azeroth';
import AdminRewardSettings from '../../components/admin/admin-reward-settings.component.azeroth';
import { useAdminRewards } from '../../stores/admin-rewards.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useSession } from '../../stores/session.store.ts';

export default component RewardsPage()
{
    const locale = useLocale();
    const session = useSession();

    useHead({ title: () => locale.t('admin.section.rewards') });

    derived role = session.account()?.staff ?? null;

    derived owner = may(role, 'wallet');

    derived freezes = may(role, 'rewards');

    mount
    {
        return () => useAdminRewards().reset();
    }

    <div class="flex flex-col gap-8 @container">
        <AdminHead title={ locale.t('admin.section.rewards') } lead={ locale.t('admin.rewards.lead') } how={ locale.t('admin.rewards.how') } />

        <AdminRewardSettings owner={ owner } />

        <Show when={ owner }>
            <AdminRewardAmounts />
        </Show>

        <AdminRewardOverview freezes={ freezes } />

        <AdminRewardDays />

        <AdminRewardFrozen freezes={ freezes } />
    </div>
}
