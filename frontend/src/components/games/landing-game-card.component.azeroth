import type { Game } from '../../data/games.ts';
import { useFocus } from '../../stores/focus.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import Button from '../ui/button.component.azeroth';
import SeatCount from './seat-count.component.azeroth';

export default component LandingGameCard(props: { game: Game; next?: Game })
{
    const locale = useLocale();
    const focus = useFocus();
    derived name = locale.t(props.game.nameKey);

    <article id={ `tour-${ props.game.id }` } data-chapter={ props.game.id } data-beat={ props.game.id }
        data-game-color={ props.game.id } class="landing-game" aria-labelledby={ `title-${ props.game.id }` } tabindex="-1">
        <div class="landing-game-art" aria-hidden="true">
            <img src={ `/world/card-${ props.game.id }.webp` } width="720" height="480" loading="lazy" decoding="async" alt="" />
        </div>
        <div class="landing-game-body">
            <div class="chapter-meta">
                <span class="landing-game-category">{ locale.t(props.game.categoryKey) }</span>
                <span aria-hidden="true" class="meta-rule"></span>
                <SeatCount game={ props.game } />
            </div>
            <h3 id={ `title-${ props.game.id }` }>{ name }</h3>
            <p class="landing-game-blurb">{ locale.t(props.game.blurbKey) }</p>
            <div class="chapter-actions">
                <Button href={ `/app/games/${ props.game.slug }` } variant="primary" size="lg" leading="play" label={ locale.t('landing.games.playGame', { game: name }) }>{ locale.t('landing.games.play') }</Button>
                <a class="chapter-next" href={ props.next ? `#tour-${ props.next.id }` : '#together' }>
                    { props.next ? locale.t('landing.tour.next', { game: locale.t(props.next.nameKey) }) : locale.t('footer.together') }
                </a>
            </div>
            <label class="studio-angle">
                <span>{ locale.t('landing.tour.angle') }</span>
                <input type="range" min="-28" max="28" step="2" dir="ltr"
                    disabled={ focus.chapter() !== props.game.id }
                    value={ focus.chapter() === props.game.id ? focus.orbit() : 0 }
                    onInput={ (event) => focus.setOrbit((event.currentTarget as HTMLInputElement).valueAsNumber) }
                />
            </label>
        </div>
    </article>
}
