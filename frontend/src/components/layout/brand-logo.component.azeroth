const SIZE = {
    sm: 'h-7 w-7',
    md: 'h-8 w-8',
    lg: 'h-9 w-9'
};

/**
 * Baziche's chip, as the logo inside the pages: the chip alone, cut from the app icon's tile
 * (`public/brand-chip.png`), so it stands on a dark bar and a light one alike.
 */
export default component BrandLogo(props: { size?: 'sm' | 'md' | 'lg' })
{
    <span class={ `flex shrink-0 ${ SIZE[props.size ?? 'lg'] }` } aria-hidden="true">
        <img src="/brand-chip.png" alt="" width="36" height="36" decoding="async" class="h-full w-full" />
    </span>
}
