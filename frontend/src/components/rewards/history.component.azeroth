import { Show } from 'azerothjs';

import { useRewards } from '../../stores/rewards.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import Panel from '../ui/panel.component.azeroth';

type HistoryItem = {
    id: string;
    kind: string;
    at: string;
    amount: number;
    note?: string;
};

export default component History(props: { class?: string })
{
    const locale = useLocale();
    const rewards = useRewards();

    mount
    {
        void rewards.loadHistory();
    }

    const page = rewards.history();
    const items: HistoryItem[] = page === null ? [] : page.items;

    return (
        <Panel section class={ props.class ?? '' }>
            <div class="flex flex-col gap-4">
                <h3 class="text-ui-lg font-semibold text-text">{ locale.t('app.rewards.history') }</h3>

                <Show when={ items.length === 0 }>
                    { () => <p class="text-xs text-muted">{ locale.t('app.rewards.noHistory') }</p> }
                </Show>
                <Show when={ items.length > 0 }>
                    { () =>
                        <div class="flex flex-col gap-2">
                            { items.map((item) => (
                                <div class="flex items-center justify-between gap-3 px-3 py-2 bg-field rounded-control border border-line">
                                    <div class="flex min-w-0 flex-col gap-1">
                                        <div class="text-ui-sm text-text">{ item.kind }</div>
                                        <div class="text-xs text-muted">{ new Date(item.at).toLocaleDateString() }</div>
                                        <Show when={ item.note !== undefined && item.note !== '' }>
                                            { () => <div class="text-[10px] text-faint">{ item.note }</div> }
                                        </Show>
                                    </div>
                                    <div class="text-right text-ui-sm font-mono text-text">+{ item.amount }</div>
                                </div>
                            ))}
                        </div>
                    }
                </Show>
            </div>
        </Panel>
    );
}
