import LoadMore from '../../components/ui/load-more.component.azeroth';
import { useHead, useNavigate } from 'azerothjs';

import Page from '../../components/app/page.component.azeroth';
import PageHeader from '../../components/app/page-header.component.azeroth';
import NotificationRow from '../../components/social/notification-row.component.azeroth';
import Button from '../../components/ui/button.component.azeroth';
import EmptyState from '../../components/ui/empty-state.component.azeroth';
import ErrorState from '../../components/ui/error-state.component.azeroth';
import FilterBar from '../../components/ui/filter-bar.component.azeroth';
import { NOTICES, type Notice } from '../../../../backend/src/domains/notify/notices.ts';
import SectionHeading from '../../components/ui/section-heading.component.azeroth';
import Skeleton from '../../components/ui/skeleton.component.azeroth';
import type { Notification } from '../../api.ts';
import { attempt } from '../../lib/attempt.ts';
import { targetOf } from '../../lib/notifications.ts';
import { useAddress } from '../../lib/page-param.ts';
import { runtime } from '../../lib/runtime.ts';
import { FIRST_CHIP, keyboardTo } from '../../lib/way-back.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useNotifications } from '../../stores/notifications.store.ts';

export default component NotificationsPage()
{
    const locale = useLocale();
    const notifications = useNotifications();
    const { navigate } = useNavigate();

    useHead({ title: () => locale.t('app.nav.notifications') });

    derived items = notifications.items();

    derived kind = notifications.notice();

    state loadingMore = false;

    const more = () =>
    {
        loadingMore = true;
        void notifications.more().finally(() => loadingMore = false);
    };

    derived kinds = [ 'all', ...NOTICES ].map((id) => ({ id, label: locale.t(`notifications.kind.${ id as Notice | 'all' }`) }));

    const address = useAddress();

    const choose = (id: string) =>
    {
        notifications.only(NOTICES.find((one) => one === id) ?? null);
        address.write({ kind: id === 'all' ? '' : id });
    };

    let filters: HTMLElement | null = null;

    const showAll = () =>
    {
        keyboardTo(filters, FIRST_CHIP);
        choose('all');
    };

    mount
    {
        notifications.only(NOTICES.find((one) => one === address.text('kind')) ?? null);
        return () => notifications.only(null);
    }

    derived dayStart = (() =>
    {
        const reference = new Date(runtime().clock.now());
        reference.setHours(0, 0, 0, 0);
        return reference.getTime();
    })();

    derived today = items.filter((item) => Date.parse(item.at) >= dayStart);

    derived earlier = items.filter((item) => Date.parse(item.at) < dayStart);

    derived listed = items.length > 0;

    derived read = notifications.reading();

    derived waiting = read === 'reading';

    derived refused = read === 'failed';

    derived quiet = read === 'read' && !listed;

    /** Kept once drawn: a kind changed reads the list again, and a bar that went with the list took the chip from under the reader. */
    state filterable = false;

    effect
    {
        if (listed || kind !== null)
        {
            filterable = true;
        }
    }

    derived unfiltered = kind === null;

    derived anyToday = today.length > 0;

    derived anyEarlier = earlier.length > 0;

    derived further = notifications.hasMore();

    derived unread = notifications.unread() > 0;

    const open = (item: Notification) =>
    {
        void notifications.markRead(item.id).catch(() => undefined);
        const target = targetOf(item);
        if (target !== null)
        {
            navigate(target);
        }
    };

    const dismiss = (id: string) => void attempt(notifications.dismiss(id));

    <Page label={ locale.t('app.nav.notifications') } onRefresh={ () => void notifications.refresh() }>
        <PageHeader
            title={ locale.t('app.nav.notifications') }
            lead={ locale.t('notifications.lead') }
            actions={ unread
                ? <Button variant="ghost" size="sm" leading="check-circle" onClick={ () => void attempt(notifications.markAllRead()) }>{ locale.t('notifications.markAll') }</Button>
                : undefined }
        />

        <Show when={ filterable }>
            { () =>
                <div ref={ (element) => filters = element } class="mb-4">
                    <FilterBar items={ kinds } value={ kind ?? 'all' } label={ locale.t('notifications.filter') } onChange={ choose } />
                </div>
            }
        </Show>

        <Show when={ waiting }>
            { () =>
                <div class="flex flex-col divide-y divide-line rounded-panel border border-line bg-field px-4" data-reading>
                    <span class="sr-only">{ locale.t('common.loading') }</span>
                    <Skeleton avatar class="py-3" />
                    <Skeleton avatar class="py-3" />
                    <Skeleton avatar class="py-3" />
                </div>
            }
        </Show>

        <Show when={ refused }>
            { () => <ErrorState error={ notifications.failed() } onRetry={ () => void notifications.refresh() } class="py-10" /> }
        </Show>

        <Show when={ quiet }>
            { () =>
                <Show when={ unfiltered } fallback={ <EmptyState icon="bell" title={ locale.t('notifications.emptyKind') } action={ locale.t('notifications.showAll') } wayBack onAction={ showAll } class="py-10" /> }>
                    { () => <EmptyState icon="bell" title={ locale.t('notifications.empty') } lead={ locale.t('notifications.emptyLead') } class="py-10" /> }
                </Show>
            }
        </Show>

        <Show when={ listed }>
            { () =>
                <div class="flex flex-col gap-6">
                    <Show when={ anyToday }>
                        <section>
                            <SectionHeading title={ locale.t('notifications.today') } />
                            <ul class="flex flex-col divide-y divide-line overflow-hidden rounded-panel border border-line bg-field" aria-label={ locale.t('notifications.today') }>
                                <For each={ today } key={ (item) => item.id } let={ item }>
                                    <li>
                                        <NotificationRow item={ item } onOpen={ open } onDismiss={ dismiss } />
                                    </li>
                                </For>
                            </ul>
                        </section>
                    </Show>

                    <Show when={ anyEarlier }>
                        <section>
                            <SectionHeading title={ locale.t('notifications.earlier') } />
                            <ul class="flex flex-col divide-y divide-line overflow-hidden rounded-panel border border-line bg-field" aria-label={ locale.t('notifications.earlier') }>
                                <For each={ earlier } key={ (item) => item.id } let={ item }>
                                    <li>
                                        <NotificationRow item={ item } onOpen={ open } onDismiss={ dismiss } />
                                    </li>
                                </For>
                            </ul>
                        </section>
                    </Show>

                    <Show when={ further }>
                        { () => <LoadMore label={ locale.t('common.more') } loading={ loadingMore } onMore={ more } /> }
                    </Show>
                </div>
            }
        </Show>
    </Page>
}
