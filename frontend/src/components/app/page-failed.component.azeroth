import { resolveRouteComponent, untrack, useHead, useMatch, type RouteMatch } from 'azerothjs';

import Icon from '../../icons/icon.component.azeroth';
import { reloadPage } from '../../lib/chunks.ts';
import { whyFailed } from '../../lib/failure.ts';
import { runtime } from '../../lib/runtime.ts';
import { useLocale } from '../../stores/locale.store.ts';
import Button from '../ui/button.component.azeroth';

/**
 * What a shell draws where a page threw, so the nav around it stays. Try again asks again for
 * whatever of the page's code could not be fetched (the router keeps a lost chunk's error until it
 * is asked again) and builds the page afresh; where the code still cannot be had, it loads the page,
 * the one way back from a chunk Chromium will not ask for twice (`lib/chunks.ts`).
 *
 * A page the reader goes to is drawn once its code has come and the router has taken it up, a turn
 * of the clock later. The router commits a page before its code comes and goes on drawing the last
 * one until then, so letting go of the failure at the commit drew the page that had failed again,
 * and its failure was then taken for the new page's and never let go. Nothing below `<Routes>` can
 * read whether the router is still waiting.
 */
export default component PageFailed(props: { error: unknown; reset: () => void; home: string; homeLabel: string; class?: string })
{
    const locale = useLocale();
    const match = useMatch();

    let watching = untrack(match);

    let gone = false;

    useHead({ title: () => locale.t('page.failed.title') });

    state trying = false;

    state failure: unknown = props.error;

    derived lead = locale.t(whyFailed(failure, 'page.failed.lead'));

    derived away = match()?.pathname !== props.home;

    const again = async () =>
    {
        trying = true;

        try
        {
            await Promise.all((untrack(match)?.matched ?? []).map((level) => resolveRouteComponent(level)));
        }
        catch (error)
        {
            if (await reloadPage())
            {
                return;
            }

            failure = error;
            trying = false;
            return;
        }

        props.reset();
    };

    const follow = async (to: RouteMatch | null) =>
    {
        try
        {
            await Promise.all((to?.matched ?? []).map((level) => resolveRouteComponent(level)));
        }
        catch (error)
        {
            if (!gone && untrack(match) === to)
            {
                failure = error;
            }

            return;
        }

        runtime().clock.after(0, () =>
        {
            if (!gone && untrack(match) === to)
            {
                props.reset();
            }
        });
    };

    effect
    {
        const now = match();

        if (now !== watching)
        {
            watching = now;
            untrack(() => void follow(now));
        }
    }

    mount
    {
        console.error('[nura] a page threw, and its shell kept the rest of the app', props.error);

        return () =>
        {
            gone = true;
        };
    }

    <div class={ [ 'flex flex-col items-center justify-center px-6 py-12 text-center', props.class ?? '' ].filter(Boolean).join(' ') } role="alert" data-page-failed>
        <span class="mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-danger/15 text-danger" aria-hidden="true">
            <Icon name="alert" size={ 26 } />
        </span>
        <h1 class="title text-balance text-ui-xl text-text">{ locale.t('page.failed.title') }</h1>
        <p class="mt-1.5 max-w-[34ch] text-balance text-ui-base text-muted" data-failed-lead>{ lead }</p>
        <div class="mt-5 flex flex-wrap items-center justify-center gap-2">
            <Button variant="primary" size="md" leading="refresh" loading={ trying } onClick={ () => void again() }>{ locale.t('common.retry') }</Button>
            <Show when={ away }>
                <Button variant="outline" size="md" leading="home" to={ props.home }>{ props.homeLabel }</Button>
            </Show>
        </div>
    </div>
}
