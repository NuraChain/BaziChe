import { createResource, Link, untrack, useHead } from 'azerothjs';

import { may } from '../../../../backend/src/domains/admin/roles.ts';
import { ALERT_ABILITY, MOVES, QUEUES, REFUSALS, WORKERS, type AlertKind, type Queue, type Worker } from '../../../../backend/src/ops/measures.ts';
import type { AdminOverview } from '../../../../backend/src/schemas.ts';
import AdminHead from '../../components/admin/admin-head.component.azeroth';
import When from '../../components/admin/when.component.azeroth';
import GameIcon from '../../components/games/game-icon.component.azeroth';
import Badge from '../../components/ui/badge.component.azeroth';
import Button from '../../components/ui/button.component.azeroth';
import ErrorState from '../../components/ui/error-state.component.azeroth';
import Panel from '../../components/ui/panel.component.azeroth';
import Skeleton from '../../components/ui/skeleton.component.azeroth';
import { client } from '../../api.ts';
import { GAMES } from '../../data/games.ts';
import Icon from '../../icons/icon.component.azeroth';
import { nuraOf } from '../../lib/nura.ts';
import { whileSeen } from '../../lib/while-seen.ts';
import type { MessageKey } from '../../locales/en.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useReports } from '../../stores/reports.store.ts';
import { useSession } from '../../stores/session.store.ts';

const MB = 1_000_000;

const DAY_S = 86_400;

const HOUR_S = 3_600;

const MINUTE_S = 60;

const LINK = 'text-ui-sm font-semibold text-accent hover:underline';

const TILE = 'flex h-full flex-col gap-1.5 p-4';

const CHIP = 'rounded-control bg-raised px-1.5 py-0.5';

const STATUS: Record<'available' | 'disabled' | 'coming-soon', { word: MessageKey; tone: 'live' | 'gold' | 'neutral' }> = {
    available: { word: 'admin.play.status.available', tone: 'live' },
    disabled: { word: 'admin.play.status.disabled', tone: 'gold' },
    'coming-soon': { word: 'admin.play.status.coming-soon', tone: 'neutral' }
};

/** Every alert but the two "Needs you" already has a row of its own for: the payments stuck and the disagreements. */
const DRAWN = ['sockets-full', 'sockets-behind', 'watch-slow', 'errors', 'backlog', 'markets-late', 'locks-failed', 'workers-failing', 'chain-down'] as const satisfies readonly AlertKind[];

type Drawn = (typeof DRAWN)[number];

type Standing = AdminOverview['alerts'][number];

const isDrawn = (value: string): value is Drawn => DRAWN.some((one) => one === value);

const isQueue = (value: string | undefined): value is Queue => QUEUES.some((one) => one === value);

const isWorker = (value: string | undefined): value is Worker => WORKERS.some((one) => one === value);

export default component OverviewPage()
{
    const locale = useLocale();
    const session = useSession();
    const desk = useReports();

    useHead({ title: () => locale.t('admin.section.overview') });

    const view = createResource(() => client.admin.overview(), { name: 'admin.overview' });

    mount
    {
        return whileSeen(() => void view.refetch());
    }

    derived held = view.data() ?? null;

    effect
    {
        const answered = held;

        if (answered !== null)
        {
            untrack(() => desk.told(answered.reports));
        }
    }

    derived trouble = view.error();

    derived waiting = held === null && trouble === null;

    derived failed = held === null && trouble !== null;

    derived shown = held !== null;

    derived role = session.account()?.staff ?? null;

    derived playable = may(role, 'play');

    derived readAt = held === null ? '' : locale.t('admin.overview.readAt', { time: locale.date(Date.parse(held.at), { timeStyle: 'medium' }) });

    const counted = (count: number, key: MessageKey) => ({ count: locale.n(count), label: locale.plural(key, count) });

    derived accounts = locale.n(held?.people.total ?? 0);

    derived joined = counted(held?.people.day ?? 0, 'admin.overview.day');

    derived week = counted(held?.people.week ?? 0, 'admin.overview.week');

    derived seen = counted(held?.people.active ?? 0, 'admin.overview.active');

    derived suspended = counted(held?.people.suspended ?? 0, 'admin.overview.suspended');

    derived minors = counted(held?.people.minors ?? 0, 'admin.overview.minors');

    derived online = locale.n(held?.online ?? 0);

    derived reportCount = held?.reports ?? 0;

    derived reports = locale.n(reportCount);

    derived reportsWaiting = counted(reportCount, 'admin.overview.reportsWaiting');

    derived reported = reportCount > 0;

    derived playing = locale.n((held?.games ?? []).reduce((sum, one) => sum + one.matches, 0));

    derived tablesWaiting = counted((held?.games ?? []).reduce((sum, one) => sum + one.tables, 0), 'admin.play.tables');

    const tileSaid = (title: MessageKey, value: string, sub: { count: string; label: string }) =>
        locale.t('admin.overview.tile.said', { title: locale.t(title), value, sub: `${ sub.count } ${ sub.label }` });

    derived accountsTile = tileSaid('admin.overview.people', accounts, joined);

    derived onlineTile = tileSaid('admin.section.live', online, seen);

    derived reportsTile = `${ reportsWaiting.count } ${ reportsWaiting.label }`;

    derived gamesTile = tileSaid('admin.overview.tile.games', playing, tablesWaiting);

    derived games = (held?.games ?? []).map((one) =>
    {
        const known = GAMES.find((game) => game.id === one.game) ?? null;

        return {
            game: one.game,
            known,
            name: known === null ? one.game : locale.t(known.nameKey),
            status: locale.t(STATUS[one.status].word),
            tone: STATUS[one.status].tone,
            matches: counted(one.matches, 'admin.play.matches'),
            tables: counted(one.tables, 'admin.play.tables')
        };
    });

    derived stuckCount = held?.stuck ?? 0;

    derived stuck = counted(stuckCount, 'admin.overview.stuck');

    derived jammed = stuckCount > 0 && playable;

    derived money = held?.money ?? null;

    derived funded = money !== null;

    derived paidPlaying = counted(money?.playing ?? 0, 'admin.overview.paidPlaying');

    derived inPlay = locale.n(nuraOf(money?.inPlay ?? '0'), { maximumFractionDigits: 4 });

    derived paidStuckCount = money?.stuck ?? 0;

    derived paidStuck = counted(paidStuckCount, 'admin.overview.paidStuck');

    derived owed = paidStuckCount > 0;

    derived checkCount = held?.checks ?? 0;

    derived checks = counted(checkCount, 'admin.overview.checks');

    derived disagreeing = checkCount > 0;

    derived health = held?.health ?? null;

    derived watched = health !== null;

    const megabytes = (bytes: number) => locale.n(bytes / MB, { style: 'unit', unit: 'megabyte', unitDisplay: 'short', maximumFractionDigits: 0 });

    const millis = (ms: number) => locale.n(ms, { style: 'unit', unit: 'millisecond', unitDisplay: 'short', maximumFractionDigits: 1 });

    const percent = (share: number) => locale.n(share, { style: 'percent', maximumFractionDigits: 1 });

    const unit = (count: number, name: string) => locale.n(count, { style: 'unit', unit: name, unitDisplay: 'long' });

    const span = (seconds: number) =>
    {
        const days = Math.floor(seconds / DAY_S);
        const hours = Math.floor((seconds % DAY_S) / HOUR_S);
        const minutes = Math.floor((seconds % HOUR_S) / MINUTE_S);

        if (days > 0)
        {
            return locale.list([unit(days, 'day'), unit(hours, 'hour')], { type: 'unit', style: 'long' });
        }

        return hours > 0 ? locale.list([unit(hours, 'hour'), unit(minutes, 'minute')], { type: 'unit', style: 'long' }) : unit(minutes, 'minute');
    };

    const waited = (seconds: number) => (seconds < MINUTE_S ? unit(seconds, 'second') : span(seconds));

    /** An api feature is named by its address, left to right in every language; the pages and the rest of the api by words. */
    const familyOf = (family: string) =>
        (family === 'pages' || family === 'other'
            ? { text: locale.t(family === 'pages' ? 'admin.family.pages' : 'admin.family.other'), dir: 'auto', code: false }
            : { text: `/api/${ family }`, dir: 'ltr', code: true });

    const queueOf = (about: string | undefined) => (isQueue(about) ? locale.t(`admin.queue.${ about }`) : about ?? '');

    const workerOf = (about: string | undefined) => (isWorker(about) ? locale.t(`admin.worker.${ about }`) : about ?? '');

    const sentenceOf = (one: Standing, kind: Drawn) =>
    {
        const count = locale.n(one.value);

        switch (kind)
        {
            case 'sockets-full': return locale.t('admin.alert.sockets-full', { count });
            case 'sockets-behind': return locale.t('admin.alert.sockets-behind', { count });
            case 'watch-slow': return locale.t('admin.alert.watch-slow', { time: millis(one.value) });
            case 'errors': return locale.t('admin.alert.errors', { count });
            case 'backlog': return locale.t('admin.alert.backlog', { queue: queueOf(one.about), time: waited(one.value) });
            case 'markets-late': return locale.t('admin.alert.markets-late', { time: waited(one.value) });
            case 'locks-failed': return locale.t('admin.alert.locks-failed', { count });
            case 'workers-failing': return locale.t('admin.alert.workers-failing', { worker: workerOf(one.about), time: waited(one.value) });
            case 'chain-down': return locale.t('admin.alert.chain-down', { count });
        }
    };

    derived standing = held?.alerts ?? [];

    derived alerts = standing.flatMap((one) =>
    {
        const kind = one.alert;

        if (!isDrawn(kind))
        {
            return [];
        }

        const family = kind === 'errors' && one.about !== undefined ? familyOf(one.about) : null;

        return [{
            key: `${ one.alert }:${ one.about ?? '' }`,
            tone: one.level === 'error' ? 'bg-danger/15 text-danger' : 'bg-gold/15 text-gold',
            said: sentenceOf(one, kind),
            about: family?.text ?? '',
            since: one.since,
            panel: ALERT_ABILITY[kind] === 'health' ? 'overview-server' : 'overview-payouts'
        }];
    });

    derived alerting = alerts.length > 0;

    derived needed = reported || jammed || owed || disagreeing || alerting;

    const standingIn = (list: readonly Standing[], kind: AlertKind) => list.some((one) => one.alert === kind);

    const toPanel = (id: string) =>
    {
        const heading = document.getElementById(id);

        heading?.scrollIntoView({ block: 'start' });
        heading?.focus({ preventScroll: true });
    };

    derived uptime = health === null
        ? ''
        : locale.t(health.uptime < MINUTE_S ? 'admin.overview.uptimeFresh' : 'admin.overview.uptime', { time: span(health.uptime) });

    derived memory = health === null ? '' : locale.t('admin.overview.memoryValue', { rss: megabytes(health.rss), heap: megabytes(health.heap) });

    derived loop = health === null ? '' : locale.t('admin.overview.loopValue', { busy: percent(health.loop.busy), stall: millis(health.loop.stall) });

    derived loopShare = `${ Math.min(100, Math.round((health?.loop.busy ?? 0) * 100)) }%`;

    derived pool = health === null
        ? ''
        : locale.t('admin.overview.poolValue', {
            open: locale.n(health.pool.total),
            idle: locale.n(health.pool.idle),
            waiting: locale.n(health.pool.waiting)
        });

    derived poolShare = health === null || health.pool.total === 0 ? '0%' : `${ Math.round(((health.pool.total - health.pool.idle) / health.pool.total) * 100) }%`;

    derived sockets = locale.n(health?.sockets ?? 0);

    derived hour = health === null ? '' : locale.t('admin.overview.hourValue', { requests: locale.n(health.requests), failed: locale.n(health.failed) });

    derived failing = (health?.failed ?? 0) > 0;

    derived failures = (health?.failures ?? []).map((one, at) => ({ key: `${ one.at } ${ at }`, at: one.at, said: `${ one.method } ${ one.path }`, status: locale.n(one.status, { useGrouping: false }) }));

    derived listed = failures.length > 0;

    derived watch = health?.watch ?? null;

    derived measured = watch !== null;

    const total = (counts: Record<string, number>) => Object.values(counts).reduce((sum, one) => sum + one, 0);

    derived socketsHour = watch === null
        ? ''
        : locale.t('admin.overview.socketsHourValue', { opened: locale.n(watch.opened), closed: locale.n(total(watch.closed)), refused: locale.n(total(watch.refused)) });

    derived closes = Object.entries(watch?.closed ?? {}).map(([code, count]) => ({ key: code, said: `${ code } × ${ locale.n(count) }` }));

    derived refusals = REFUSALS.filter((why) => (watch?.refused[why] ?? 0) > 0)
        .map((why) => ({ key: why, said: locale.t('admin.overview.countedValue', { what: locale.t(`admin.refusal.${ why }`), count: locale.n(watch?.refused[why] ?? 0) }) }));

    derived outbox = watch === null ? '' : locale.t('admin.overview.outboxValue', { deepest: locale.n(watch.deepest), waiting: locale.n(watch.waiting) });

    derived delivery = watch?.delivery ?? null;

    derived delivered = delivery !== null;

    derived deliveryValue = delivery === null ? '' : locale.t('admin.overview.deliveryValue', { p50: millis(delivery.p50), p95: millis(delivery.p95), p99: millis(delivery.p99) });

    derived deliveryFrames = delivery === null ? '' : locale.t('admin.overview.deliveryFrames', { frames: locale.n(delivery.frames) });

    derived slow = standingIn(standing, 'watch-slow');

    derived families = (watch?.families ?? []).map((one) => ({
        key: one.family,
        name: familyOf(one.family),
        said: locale.t('admin.overview.familyValue', { requests: locale.n(one.requests), failed: locale.n(one.failed) }),
        tone: one.failed > 0 ? 'text-danger' : 'text-muted'
    }));

    derived asked = families.length > 0;

    derived behind = new Set(standing.flatMap((one) => (one.alert === 'markets-late' ? ['markets'] : one.alert === 'backlog' && one.about !== undefined ? [one.about] : [])));

    derived queues = (watch?.queues ?? []).filter((one) => one.count > 0).map((one) => ({
        key: one.queue,
        name: locale.t(`admin.queue.${ one.queue }`),
        said: one.oldest === undefined
            ? locale.t('admin.overview.queueValue', { count: locale.n(one.count) })
            : locale.t('admin.overview.queueOldest', { count: locale.n(one.count), time: waited(one.oldest) }),
        tone: behind.has(one.queue) ? 'text-danger' : 'text-muted'
    }));

    derived queued = queues.length > 0;

    derived sampledAt = watch?.sampledAt ?? '';

    derived sampled = sampledAt !== '';

    derived marketsRun = (watch?.queues ?? []).some((one) => one.queue === 'markets');

    derived moves = MOVES.filter((move) => (watch?.moves[move] ?? 0) > 0)
        .map((move) => ({ key: move, said: locale.t('admin.overview.countedValue', { what: locale.t(`admin.move.${ move }`), count: locale.n(watch?.moves[move] ?? 0) }) }));

    derived moved = moves.length > 0;

    derived payouts = held?.payouts ?? null;

    derived paying = payouts !== null;

    derived payoutsSpan = funded ? 'lg:col-span-2' : 'lg:col-span-3';

    derived serverSpan = funded && !paying ? 'lg:col-span-2' : 'lg:col-span-3';

    derived payStuckShown = payouts?.stuck !== undefined;

    derived payStuck = locale.n(payouts?.stuck ?? 0);

    derived payStuckTone = (payouts?.stuck ?? 0) > 0 ? 'text-danger' : 'text-text';

    derived marketsDue = payouts?.markets ?? null;

    derived marketsShown = marketsDue !== null;

    derived marketsCount = locale.n(marketsDue?.count ?? 0);

    derived marketsOldest = marketsDue?.oldest === undefined ? '' : locale.t('admin.overview.payouts.oldest', { time: waited(marketsDue.oldest) });

    derived marketsTone = standingIn(standing, 'markets-late') ? 'text-danger' : 'text-text';

    derived locks = locale.n(payouts?.failedLocks ?? 0);

    derived locksTone = standingIn(standing, 'locks-failed') ? 'text-danger' : 'text-text';

    derived reachable = payouts?.reachable ?? true;

    derived chainSaid = locale.t(reachable ? 'admin.overview.payouts.reached' : 'admin.overview.payouts.unreached');

    derived chainTone = reachable ? 'text-text' : 'text-danger';

    derived checksOpen = payouts?.checks ?? null;

    derived checksShown = checksOpen !== null;

    derived checksCount = locale.n(checksOpen?.open ?? 0);

    derived checksOldest = checksOpen?.oldest === undefined ? '' : locale.t('admin.overview.payouts.oldest', { time: waited(checksOpen.oldest) });

    derived checksTone = (checksOpen?.open ?? 0) > 0 ? 'text-danger' : 'text-text';

    derived workers = (payouts?.failing ?? []).map((one) => ({
        key: one.worker,
        name: locale.t(`admin.worker.${ one.worker }`),
        said: locale.t('admin.overview.payouts.failingValue', { count: locale.n(one.count), time: waited(one.oldest) })
    }));

    derived stalled = workers.length > 0;

    <div class="flex flex-col gap-6">
        <AdminHead
            title={ locale.t('admin.section.overview') }
            lead={ locale.t('admin.overview.lead') }
            how={ locale.t('admin.overview.how') }
            actions={ <Button variant="outline" size="sm" leading="refresh" onClick={ () => void view.refetch() }>{ locale.t('admin.overview.read') }</Button> }
        />

        <Show when={ waiting }>
            { () => <Skeleton lines={ 6 } /> }
        </Show>

        <Show when={ failed }>
            { () => <ErrorState title={ locale.t('admin.overview.failed') } onRetry={ () => void view.refetch() } /> }
        </Show>

        <Show when={ shown }>
            <div class="flex flex-col gap-6">
                <section class="flex flex-col gap-2" aria-labelledby="overview-needs" data-needs>
                    <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                        <h2 id="overview-needs" class="text-ui-sm font-semibold text-muted">{ locale.t('admin.overview.needs') }</h2>
                        <span class="text-ui-xs text-faint" data-read-at>{ readAt }</span>
                    </div>
                    <Show when={ needed } fallback={ (
                        <p class="flex items-center gap-3 rounded-panel border border-line bg-field px-4 py-3 text-ui-base text-muted" data-calm>
                            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-live/15 text-live" aria-hidden="true"><Icon name="check-circle" size={ 18 } /></span>
                            <span>{ locale.t('admin.overview.calm') }</span>
                        </p>
                    ) }>
                        <ul class="flex flex-col divide-y divide-line overflow-hidden rounded-panel border border-line bg-field">
                            <Show when={ reported }>
                                <li>
                                    <Link to="/admin/reports" class="flex min-h-14 items-center gap-3 px-4 py-2 transition-colors duration-150 hover:bg-raised" data-reports>
                                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gold/15 text-gold" aria-hidden="true"><Icon name="flag" size={ 18 } /></span>
                                        <span class="min-w-0 flex-1 text-ui-base font-semibold text-text"><span class="tally">{ reportsWaiting.count }</span> { reportsWaiting.label }</span>
                                        <Icon name="chevron-right" size={ 16 } class="icon-flip shrink-0 text-faint" />
                                    </Link>
                                </li>
                            </Show>
                            <Show when={ jammed }>
                                <li>
                                    <Link to="/admin/play?view=stuck" class="flex min-h-14 items-center gap-3 px-4 py-2 transition-colors duration-150 hover:bg-raised" data-stuck>
                                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-danger/15 text-danger" aria-hidden="true"><Icon name="alert" size={ 18 } /></span>
                                        <span class="min-w-0 flex-1 text-ui-base font-semibold text-text"><span class="tally">{ stuck.count }</span> { stuck.label }</span>
                                        <Icon name="chevron-right" size={ 16 } class="icon-flip shrink-0 text-faint" />
                                    </Link>
                                </li>
                            </Show>
                            <Show when={ owed }>
                                <li>
                                    <Link to="/admin/money" class="flex min-h-14 items-center gap-3 px-4 py-2 transition-colors duration-150 hover:bg-raised" data-owed>
                                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-danger/15 text-danger" aria-hidden="true"><Icon name="coins" size={ 18 } /></span>
                                        <span class="min-w-0 flex-1 text-ui-base font-semibold text-text"><span class="tally">{ paidStuck.count }</span> { paidStuck.label }</span>
                                        <Icon name="chevron-right" size={ 16 } class="icon-flip shrink-0 text-faint" />
                                    </Link>
                                </li>
                            </Show>
                            <Show when={ disagreeing }>
                                <li>
                                    <Link to="/admin/money/checks" class="flex min-h-14 items-center gap-3 px-4 py-2 transition-colors duration-150 hover:bg-raised" data-checks>
                                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-danger/15 text-danger" aria-hidden="true"><Icon name="wallet" size={ 18 } /></span>
                                        <span class="min-w-0 flex-1 text-ui-base font-semibold text-text"><span class="tally">{ checks.count }</span> { checks.label }</span>
                                        <Icon name="chevron-right" size={ 16 } class="icon-flip shrink-0 text-faint" />
                                    </Link>
                                </li>
                            </Show>
                            <For each={ alerts } key={ (one) => one.key } let={ alert }>
                                <li>
                                    <button type="button" class="flex min-h-14 w-full items-center gap-3 px-4 py-2 text-start transition-colors duration-150 hover:bg-raised" data-alert={ alert.key } onClick={ () => toPanel(alert.panel) }>
                                        <span class={ () => `flex h-9 w-9 shrink-0 items-center justify-center rounded-full ${ alert.tone }` } aria-hidden="true"><Icon name="alert" size={ 18 } /></span>
                                        <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                                            <span class="text-ui-base font-semibold text-text" data-alert-said>{ alert.said }</span>
                                            <span class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-ui-xs text-faint">
                                                <code class="font-mono text-muted empty:hidden" dir="ltr" data-alert-about>{ alert.about }</code>
                                                <When at={ alert.since } />
                                            </span>
                                        </span>
                                        <Icon name="chevron-right" size={ 16 } class="icon-flip shrink-0 text-faint" />
                                    </button>
                                </li>
                            </For>
                        </ul>
                    </Show>
                </section>

                <ul class="grid grid-cols-2 gap-3 lg:grid-cols-4" data-tiles>
                    <li>
                        <Panel to="/admin/people" pad="none" class="h-full" label={ accountsTile }>
                            <span class={ TILE }>
                                <span class="flex items-center gap-2 text-ui-xs font-semibold text-muted"><Icon name="people" size={ 16 } /><span data-tile-title>{ locale.t('admin.overview.people') }</span></span>
                                <span class="tally text-ui-3xl font-bold text-text" data-accounts>{ accounts }</span>
                                <span class="text-ui-xs text-faint" data-joined><span class="tally">{ joined.count }</span> { joined.label }</span>
                            </span>
                        </Panel>
                    </li>
                    <li>
                        <Panel to="/admin/live" pad="none" class="h-full" label={ onlineTile }>
                            <span class={ TILE }>
                                <span class="flex items-center gap-2 text-ui-xs font-semibold text-muted"><Icon name="signal" size={ 16 } /><span data-tile-title>{ locale.t('admin.section.live') }</span></span>
                                <span class="tally text-ui-3xl font-bold text-text" data-online>{ online }</span>
                                <span class="text-ui-xs text-faint" data-seen><span class="tally">{ seen.count }</span> { seen.label }</span>
                            </span>
                        </Panel>
                    </li>
                    <li>
                        <Panel to="/admin/reports" pad="none" class="h-full" label={ reportsTile }>
                            <span class={ TILE }>
                                <span class="flex items-center gap-2 text-ui-xs font-semibold text-muted"><Icon name="flag" size={ 16 } /><span data-tile-title>{ locale.t('admin.overview.tile.reports') }</span></span>
                                <span class={ () => `tally text-ui-3xl font-bold ${ reported ? 'text-gold' : 'text-text' }` } data-waiting>{ reports }</span>
                                <span class="text-ui-xs text-faint">{ locale.t('admin.overview.openReports') }</span>
                            </span>
                        </Panel>
                    </li>
                    <li>
                        <Panel to={ playable ? '/admin/play?view=matches' : undefined } pad="none" class="h-full" label={ gamesTile }>
                            <span class={ TILE }>
                                <span class="flex items-center gap-2 text-ui-xs font-semibold text-muted"><Icon name="games" size={ 16 } /><span data-tile-title>{ locale.t('admin.overview.tile.games') }</span></span>
                                <span class="tally text-ui-3xl font-bold text-text" data-playing>{ playing }</span>
                                <span class="text-ui-xs text-faint" data-waiting-tables><span class="tally">{ tablesWaiting.count }</span> { tablesWaiting.label }</span>
                            </span>
                        </Panel>
                    </li>
                </ul>

                <div class="grid items-start gap-4 lg:grid-cols-3">
                    <Panel pad="none" class="lg:col-span-2" labelledBy="overview-games">
                        <div class="flex items-center justify-between gap-3 border-b border-line px-4 py-3">
                            <h2 id="overview-games" class="text-ui-md font-semibold text-text">{ locale.t('admin.overview.games') }</h2>
                            <Show when={ playable }>
                                <Link to="/admin/play" class={ LINK } data-open-play>{ locale.t('admin.overview.openPlay') }</Link>
                            </Show>
                        </div>
                        <ul class="divide-y divide-line" data-games>
                            <For each={ games } key={ (one) => one.game } let={ game }>
                                <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3" data-game={ game.game }>
                                    <Show when={ game.known } let={ known } fallback={ <span class="h-9 w-9 shrink-0 rounded-tile bg-raised" aria-hidden="true"></span> }>
                                        <GameIcon game={ known.id } class="h-9 w-9 shrink-0" />
                                    </Show>
                                    <span class="flex min-w-[8rem] flex-1 flex-wrap items-center gap-2">
                                        <span class="text-ui-base font-semibold text-text">{ game.name }</span>
                                        <Badge dot text={ game.status } tone={ game.tone } />
                                    </span>
                                    <span class="w-full ps-12 sm:w-auto sm:ps-0">
                                        <span class="facts text-ui-xs text-muted">
                                            <span data-matches><span class="tally">{ game.matches.count }</span> { game.matches.label }</span>
                                            <span data-tables><span class="tally">{ game.tables.count }</span> { game.tables.label }</span>
                                        </span>
                                    </span>
                                </li>
                            </For>
                        </ul>
                    </Panel>

                    <Panel pad="none" labelledBy="overview-people">
                        <div class="flex items-center justify-between gap-3 border-b border-line px-4 py-3">
                            <h2 id="overview-people" class="text-ui-md font-semibold text-text">{ locale.t('admin.overview.people') }</h2>
                            <Link to="/admin/people" class={ LINK }>{ locale.t('admin.overview.openPeople') }</Link>
                        </div>
                        <ul class="flex flex-col gap-2 px-4 py-3 text-ui-base text-muted" data-facts>
                            <li data-fact="week"><span class="tally font-semibold text-text">{ week.count }</span> { week.label }</li>
                            <li><Link to="/admin/people?list=suspended" class={ LINK } data-suspended><span class="tally">{ suspended.count }</span> { suspended.label }</Link></li>
                            <li><Link to="/admin/people?list=minors" class={ LINK } data-minors><span class="tally">{ minors.count }</span> { minors.label }</Link></li>
                        </ul>
                    </Panel>

                    <Show when={ funded }>
                        <Panel pad="none" labelledBy="overview-money">
                            <div class="flex items-center justify-between gap-3 border-b border-line px-4 py-3">
                                <h2 id="overview-money" class="text-ui-md font-semibold text-text">{ locale.t('admin.overview.money') }</h2>
                                <Link to="/admin/money" class={ LINK }>{ locale.t('admin.overview.openMoney') }</Link>
                            </div>
                            <ul class="flex flex-col gap-2 px-4 py-3 text-ui-base text-muted" data-money>
                                <li data-in-play><span class="tally text-ui-xl font-bold text-madder">{ inPlay }</span> { locale.t('admin.overview.inPlay') }</li>
                                <li data-paid-playing><span class="tally font-semibold text-text">{ paidPlaying.count }</span> { paidPlaying.label }</li>
                                <li class={ () => (owed ? 'font-semibold text-danger' : '') } data-paid-stuck><span class="tally">{ paidStuck.count }</span> { paidStuck.label }</li>
                            </ul>
                        </Panel>
                    </Show>

                    <Show when={ paying }>
                        <Panel pad="none" class={ payoutsSpan } labelledBy="overview-payouts" data-payouts>
                            <div class="flex items-center justify-between gap-3 border-b border-line px-4 py-3">
                                <h2 id="overview-payouts" tabindex="-1" class="text-ui-md font-semibold text-text">{ locale.t('admin.overview.payouts') }</h2>
                                <Link to="/admin/money" class={ LINK }>{ locale.t('admin.overview.openMoney') }</Link>
                            </div>
                            <dl class="flex flex-wrap gap-px bg-line">
                                <Show when={ payStuckShown }>
                                    <div class="flex grow basis-48 flex-col gap-1 bg-field px-4 py-3">
                                        <dt class="text-ui-xs font-semibold text-muted">{ locale.t('admin.overview.payouts.stuck') }</dt>
                                        <dd class={ () => `tally text-ui-xl font-bold ${ payStuckTone }` } data-pay-stuck>{ payStuck }</dd>
                                    </div>
                                </Show>
                                <Show when={ marketsShown }>
                                    <div class="flex grow basis-48 flex-col gap-1 bg-field px-4 py-3">
                                        <dt class="text-ui-xs font-semibold text-muted">{ locale.t('admin.overview.payouts.markets') }</dt>
                                        <dd class={ () => `tally text-ui-xl font-bold ${ marketsTone }` } data-markets-due>{ marketsCount }</dd>
                                        <dd class="text-ui-xs text-faint" data-markets-oldest>{ marketsOldest }</dd>
                                    </div>
                                </Show>
                                <div class="flex grow basis-48 flex-col gap-1 bg-field px-4 py-3">
                                    <dt class="text-ui-xs font-semibold text-muted">{ locale.t('admin.overview.payouts.locks') }</dt>
                                    <dd class={ () => `tally text-ui-xl font-bold ${ locksTone }` } data-locks>{ locks }</dd>
                                </div>
                                <div class="flex grow basis-48 flex-col gap-1 bg-field px-4 py-3">
                                    <dt class="text-ui-xs font-semibold text-muted">{ locale.t('admin.overview.payouts.chain') }</dt>
                                    <dd class={ () => `text-ui-base font-semibold ${ chainTone }` } data-chain>{ chainSaid }</dd>
                                </div>
                                <Show when={ checksShown }>
                                    <div class="flex grow basis-48 flex-col gap-1 bg-field px-4 py-3">
                                        <dt class="text-ui-xs font-semibold text-muted">{ locale.t('admin.overview.payouts.checks') }</dt>
                                        <dd class={ () => `tally text-ui-xl font-bold ${ checksTone }` } data-checks-open>{ checksCount }</dd>
                                        <dd class="text-ui-xs text-faint" data-checks-oldest>{ checksOldest }</dd>
                                    </div>
                                </Show>
                                <div class="flex basis-full flex-col gap-1.5 bg-field px-4 py-3">
                                    <dt class="text-ui-xs font-semibold text-muted">{ locale.t('admin.overview.payouts.failing') }</dt>
                                    <Show when={ stalled } fallback={ <dd class="text-ui-base text-muted" data-failing="none">{ locale.t('admin.overview.payouts.failingNone') }</dd> }>
                                        <dd>
                                            <ul class="flex flex-col gap-1" data-failing>
                                                <For each={ workers } key={ (one) => one.key } let={ worker }>
                                                    <li class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5 text-ui-base" data-worker={ worker.key }>
                                                        <span class="font-semibold text-danger">{ worker.name }</span> <span class="text-ui-xs text-muted">{ worker.said }</span>
                                                    </li>
                                                </For>
                                            </ul>
                                        </dd>
                                    </Show>
                                </div>
                            </dl>
                        </Panel>
                    </Show>

                    <Show when={ watched }>
                        <Panel pad="none" class={ serverSpan } labelledBy="overview-server" data-health>
                            <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 border-b border-line px-4 py-3">
                                <h2 id="overview-server" tabindex="-1" class="text-ui-md font-semibold text-text">{ locale.t('admin.overview.server') }</h2>
                                <span class="text-ui-sm text-muted" data-uptime>{ uptime }</span>
                            </div>
                            <dl class="grid gap-px bg-line sm:grid-cols-2 xl:grid-cols-3">
                                <div class="flex flex-col gap-1 bg-field px-4 py-3">
                                    <dt class="text-ui-xs font-semibold text-muted">{ locale.t('admin.overview.memory') }</dt>
                                    <dd class="text-ui-base text-text" data-memory>{ memory }</dd>
                                </div>
                                <div class="flex flex-col gap-1.5 bg-field px-4 py-3">
                                    <dt class="text-ui-xs font-semibold text-muted">{ locale.t('admin.overview.loop') }</dt>
                                    <dd class="text-ui-base text-text" data-loop>{ loop }</dd>
                                    <dd class="h-1.5 overflow-hidden rounded-full bg-sunk" aria-hidden="true"><span class="block h-full rounded-full bg-accent" style={ `inline-size: ${ loopShare }` }></span></dd>
                                </div>
                                <div class="flex flex-col gap-1.5 bg-field px-4 py-3">
                                    <dt class="text-ui-xs font-semibold text-muted">{ locale.t('admin.overview.pool') }</dt>
                                    <dd class="text-ui-base text-text" data-pool>{ pool }</dd>
                                    <dd class="h-1.5 overflow-hidden rounded-full bg-sunk" aria-hidden="true"><span class="block h-full rounded-full bg-accent" style={ `inline-size: ${ poolShare }` }></span></dd>
                                </div>
                                <div class="flex flex-col gap-1 bg-field px-4 py-3">
                                    <dt class="text-ui-xs font-semibold text-muted">{ locale.t('admin.overview.sockets') }</dt>
                                    <dd class="tally text-ui-base text-text" data-sockets>{ sockets }</dd>
                                </div>
                                <div class="flex flex-col gap-1 bg-field px-4 py-3 sm:col-span-2">
                                    <dt class="text-ui-xs font-semibold text-muted">{ locale.t('admin.overview.hour') }</dt>
                                    <dd class={ () => `text-ui-base ${ failing ? 'text-danger' : 'text-text' }` } data-hour>{ hour }</dd>
                                </div>
                                <Show when={ measured }>
                                    <div class="flex flex-col gap-1 bg-field px-4 py-3">
                                        <dt class="text-ui-xs font-semibold text-muted">{ locale.t('admin.overview.socketsHour') }</dt>
                                        <dd class="text-ui-base text-text" data-sockets-hour>{ socketsHour }</dd>
                                        <dd class="flex flex-wrap gap-1.5 text-ui-xs text-muted" data-closes>
                                            <For each={ closes } key={ (one) => one.key } let={ close }>
                                                <span class={ `${ CHIP } font-mono` } dir="ltr" data-close={ close.key }>{ close.said }</span>
                                            </For>
                                            <For each={ refusals } key={ (one) => one.key } let={ refusal }>
                                                <span class={ CHIP } data-refusal={ refusal.key }>{ refusal.said }</span>
                                            </For>
                                        </dd>
                                    </div>
                                    <div class="flex flex-col gap-1 bg-field px-4 py-3">
                                        <dt class="text-ui-xs font-semibold text-muted">{ locale.t('admin.overview.outbox') }</dt>
                                        <dd class="text-ui-base text-text" data-outbox>{ outbox }</dd>
                                    </div>
                                    <div class="flex flex-col gap-1 bg-field px-4 py-3 sm:col-span-2 xl:col-span-1">
                                        <dt class="text-ui-xs font-semibold text-muted">{ locale.t('admin.overview.delivery') }</dt>
                                        <Show when={ delivered } fallback={ <dd class="text-ui-base text-muted" data-delivery="none">{ locale.t('admin.overview.deliveryNone') }</dd> }>
                                            <dd class={ () => `text-ui-base ${ slow ? 'text-danger' : 'text-text' }` } data-delivery>{ deliveryValue }</dd>
                                            <dd class="text-ui-xs text-faint" data-frames>{ deliveryFrames }</dd>
                                        </Show>
                                    </div>
                                </Show>
                            </dl>
                            <Show when={ measured }>
                                <div class="flex flex-col gap-2 border-t border-line px-4 py-3">
                                    <h3 class="text-ui-sm font-semibold text-text">{ locale.t('admin.overview.families') }</h3>
                                    <Show when={ asked } fallback={ <p class="text-ui-sm text-muted" data-families="none">{ locale.t('admin.overview.familiesNone') }</p> }>
                                        <ul class="grid gap-x-6 gap-y-1 sm:grid-cols-2 xl:grid-cols-3" data-families>
                                            <For each={ families } key={ (one) => one.key } let={ family }>
                                                <li class="flex items-baseline justify-between gap-3 py-0.5 text-ui-xs" data-family={ family.key }>
                                                    <span class={ () => (family.name.code ? 'font-mono text-text' : 'text-text') } dir={ family.name.dir }>{ family.name.text }</span> <span class={ () => family.tone }>{ family.said }</span>
                                                </li>
                                            </For>
                                        </ul>
                                    </Show>
                                </div>
                                <div class="flex flex-col gap-2 border-t border-line px-4 py-3">
                                    <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                                        <h3 class="text-ui-sm font-semibold text-text">{ locale.t('admin.overview.queues') }</h3>
                                        <Show when={ sampled }>
                                            <span class="text-ui-xs text-faint" data-sampled>{ locale.t('admin.overview.sampled') } <When at={ sampledAt } /></span>
                                        </Show>
                                    </div>
                                    <Show when={ queued } fallback={ <p class="text-ui-sm text-muted" data-queues="none">{ locale.t('admin.overview.queuesNone') }</p> }>
                                        <ul class="flex flex-col gap-1" data-queues>
                                            <For each={ queues } key={ (one) => one.key } let={ queue }>
                                                <li class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5 text-ui-xs" data-queue={ queue.key }>
                                                    <span class="text-text">{ queue.name }</span> <span class={ () => queue.tone }>{ queue.said }</span>
                                                </li>
                                            </For>
                                        </ul>
                                    </Show>
                                </div>
                                <Show when={ marketsRun }>
                                    <div class="flex flex-col gap-2 border-t border-line px-4 py-3">
                                        <h3 class="text-ui-sm font-semibold text-text">{ locale.t('admin.overview.moves') }</h3>
                                        <Show when={ moved } fallback={ <p class="text-ui-sm text-muted" data-moves="none">{ locale.t('admin.overview.movesNone') }</p> }>
                                            <p class="flex flex-wrap gap-1.5 text-ui-xs text-muted" data-moves>
                                                <For each={ moves } key={ (one) => one.key } let={ move }>
                                                    <span class={ CHIP } data-move={ move.key }>{ move.said }</span>
                                                </For>
                                            </p>
                                        </Show>
                                    </div>
                                </Show>
                            </Show>
                            <div class="flex flex-col gap-2 border-t border-line px-4 py-3">
                                <h3 class="text-ui-sm font-semibold text-text">{ locale.t('admin.overview.failures') }</h3>
                                <Show when={ listed } fallback={ <p class="text-ui-sm text-muted" data-failures="none">{ locale.t('admin.overview.noFailures') }</p> }>
                                    <ul class="divide-y divide-line" data-failures>
                                        <For each={ failures } key={ (one) => one.key } let={ failure }>
                                            <li class="flex flex-wrap items-center gap-x-3 gap-y-1 py-2 text-ui-xs">
                                                <span class="tally rounded-control bg-danger/15 px-1.5 py-0.5 font-semibold text-danger">{ failure.status }</span>
                                                <span class="min-w-0 flex-1 break-all font-mono text-text" dir="ltr">{ failure.said }</span>
                                                <span class="text-faint"><When at={ failure.at } /></span>
                                            </li>
                                        </For>
                                    </ul>
                                </Show>
                            </div>
                        </Panel>
                    </Show>
                </div>
            </div>
        </Show>
    </div>
}
