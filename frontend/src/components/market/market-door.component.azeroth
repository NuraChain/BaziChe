import { onCleanup, untrack } from 'azerothjs';

import Icon from '../../icons/icon.component.azeroth';
import { openMarket } from '../../lib/market-sheet.ts';
import { nuraOf } from '../../lib/nura.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useMarkets } from '../../stores/markets.store.ts';
import { useRealtime } from '../../stores/realtime.store.ts';
import '../../locales/market-catalogue.ts';

/**
 * The way to the market on a game the reader watches, beside the dock: drawn only where markets are
 * offered to the reader and the game has one, with how long it takes positions and what is in it.
 */
export default component MarketDoor(props: { match: string })
{
    const locale = useLocale();
    const markets = useMarkets();
    const live = useRealtime();

    let release: () => void = () => undefined;

    const two = (value: number) => locale.n(value, { minimumIntegerDigits: 2, useGrouping: false });

    derived market = markets.view();

    derived now = markets.now();

    derived shown = markets.offered() && market !== null;

    derived seconds = market === null ? 0 : Math.max(0, Math.ceil((live.toLocal(Date.parse(market.closesAt)) - now) / 1000));

    derived taking = market !== null && market.state === 'open' && seconds > 0;

    derived label = locale.t(taking ? 'market.door' : 'market.door.closed');

    derived leftWords = locale.t('market.door.left', { time: `${ locale.n(Math.floor(seconds / 60)) }:${ two(seconds % 60) }` });

    derived poolWords = locale.t('market.pool', { amount: locale.n(nuraOf(market?.pool ?? '0'), { maximumFractionDigits: 4 }) });

    effect
    {
        const match = props.match;

        untrack(() =>
        {
            release();
            release = markets.watch(match);
        });
    }

    onCleanup(() => release());

    mount
    {
        return markets.listen();
    }

    <Show when={ shown }>
        <button
            type="button"
            class="table-pill flex min-h-11 max-w-[16rem] cursor-pointer items-center gap-2.5 rounded-full border border-line-strong bg-lifted py-1 ps-1 pe-4 text-start"
            aria-haspopup="dialog"
            data-market-door={ taking ? 'open' : 'closed' }
            onClick={ () => void openMarket(props.match) }
        >
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gold text-bright-ink">
                <Icon name="trophy" size={ 18 } />
            </span>
            <span class="flex min-w-0 flex-col">
                <span class="truncate text-ui-sm font-semibold text-text">{ label }</span>
                <span class="facts truncate text-ui-xs text-muted">
                    <Show when={ taking }>
                        <span data-market-left>{ leftWords }</span>
                    </Show>
                    <span>{ poolWords }</span>
                </span>
            </span>
        </button>
    </Show>
}
