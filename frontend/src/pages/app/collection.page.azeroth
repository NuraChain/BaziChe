import { untrack, useHead } from 'azerothjs';

import { CELEBRATION_SLOT, GAME_SLOTS, PROFILE_SLOTS, SHOP_SLOTS, type ShopSlot } from '../../../../backend/src/domains/shop/catalogue.ts';
import Page from '../../components/app/page.component.azeroth';
import PageHeader from '../../components/app/page-header.component.azeroth';
import OrderRow from '../../components/shop/order-row.component.azeroth';
import Button from '../../components/ui/button.component.azeroth';
import ErrorState from '../../components/ui/error-state.component.azeroth';
import LoadMore from '../../components/ui/load-more.component.azeroth';
import Panel from '../../components/ui/panel.component.azeroth';
import Skeleton from '../../components/ui/skeleton.component.azeroth';
import { GAMES } from '../../data/games.ts';
import { burstOver } from '../../game/looks/equip.ts';
import { createVoices, type SoundHandle } from '../../game/sound.ts';
import Icon from '../../icons/icon.component.azeroth';
import { nuraOf } from '../../lib/nura.ts';
import { itemName } from '../../lib/shop.ts';
import '../../locales/shop-catalogue.ts';
import type { MessageKey } from '../../locales/en.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import { useSettings } from '../../stores/settings.store.ts';
import { useShop } from '../../stores/shop.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';

interface Area
{
    id: string;
    name: MessageKey;
    slots: readonly ShopSlot[];
    table: boolean;
}

export default component CollectionPage()
{
    const locale = useLocale();
    const shop = useShop();
    const people = usePeople();
    const toasts = useToasts();
    const settings = useSettings();

    let voices: SoundHandle | null = null;

    useHead({ title: () => locale.t('shop.collection.title') });

    const areas: Area[] = [
        { id: 'profile', name: 'shop.collection.profile', slots: PROFILE_SLOTS, table: false },
        ...GAMES.filter((game) => Object.hasOwn(GAME_SLOTS, game.id)).map((game) => ({
            id: game.id,
            name: game.nameKey,
            slots: GAME_SLOTS[game.id as keyof typeof GAME_SLOTS],
            table: true
        })),
        { id: 'table', name: 'shop.collection.everyTable', slots: [CELEBRATION_SLOT], table: true }
    ];

    derived held = shop.collection();

    derived awaited = held === null && shop.collectionLoading();

    derived refused = held === null && !shop.collectionLoading() && shop.collectionFailed();

    derived shown = held !== null;

    derived gifts = held?.owned.filter((one) => one.via === 'gift') ?? [];

    derived given = gifts.length > 0;

    derived open = shop.state()?.open === true;

    derived orders = [...shop.orders()];

    derived ordered = orders.length > 0;

    derived quiet = !ordered && !shop.ordersLoading();

    derived older = shop.hasOlder();

    derived earnings = shop.earnings();

    derived earning = open && earnings !== null;

    derived owed = earnings !== null && BigInt(earnings.earnings) > 0n;

    derived owedFigure = locale.n(nuraOf(earnings?.earnings ?? '0'), { maximumFractionDigits: 4 });

    derived share = locale.n((earnings?.share ?? 0) / 10_000, { style: 'percent', maximumFractionDigits: 2 });

    const choices = (slot: ShopSlot) => (held?.owned ?? []).filter((one) => !one.item.startsWith('bundle.') && SHOP_SLOTS[slot] === one.item.split('.')[0]).map((one) => one.item);

    const choose = (slot: ShopSlot, item: string | null, pressed?: HTMLElement) =>
    {
        const drawing = pressed?.querySelector('img') ?? null;

        if (item !== null && drawing !== null && shop.chosen(slot) !== item)
        {
            burstOver(drawing, item, voices);
        }
        void shop.choose(slot, item);
    };

    const claim = async () =>
    {
        const said = await shop.claim();

        toasts.show(said === null ? { kind: 'success', text: locale.t('shop.claimed') } : { kind: 'warning', text: locale.t(said) });
    };

    const when = (at: string) => locale.date(Date.parse(at), { dateStyle: 'medium' });

    mount
    {
        shop.want('orders');
        voices = createVoices(untrack(() => settings.settings().sound));

        const unlisten = shop.listen();

        return () =>
        {
            unlisten();
            voices?.dispose();
            voices = null;
        };
    }

    effect
    {
        const on = settings.settings().sound;

        untrack(() => voices?.setEnabled(on));
    }

    // What the shop owes for the people the reader invited is the contract's to say, and a closed shop has none to ask.
    effect
    {
        if (open)
        {
            untrack(() => shop.want('earnings'));
        }
    }

    <Page width="narrow" label={ locale.t('shop.collection.title') } onRefresh={ () => void shop.refresh() }>
        <PageHeader title={ locale.t('shop.collection.title') } lead={ locale.t('shop.collection.lead') } />

        <Show when={ awaited }>
            <div class="flex flex-col gap-4" aria-hidden="true">
                <Skeleton lines={ 3 } class="rounded-panel border border-line bg-field p-4" />
                <Skeleton lines={ 3 } class="rounded-panel border border-line bg-field p-4" />
            </div>
        </Show>

        <Show when={ refused }>
            <ErrorState title={ locale.t('shop.failed') } onRetry={ () => void shop.refresh() } />
        </Show>

        <Show when={ shown }>
            <div class="flex flex-col gap-6">
                <For each={ areas } key={ (area) => area.id } let={ area }>
                    <div>
                        <Panel section stack="md" labelledBy={ `area-${ area.id }` }>
                            <div class="flex flex-wrap items-baseline justify-between gap-2">
                                <h2 id={ `area-${ area.id }` } class="text-ui-lg font-semibold text-text">{ locale.t(area.name) }</h2>
                                <Show when={ area.table }>
                                    <span class="text-ui-xs text-muted">{ locale.t('shop.nextGame') }</span>
                                </Show>
                            </div>
                            <For each={ [...area.slots] } key={ (slot) => slot } let={ slot }>
                                <div class="flex flex-col gap-2 @xl:flex-row @xl:items-center @xl:gap-4" data-slot={ slot }>
                                    <h3 class="text-ui-sm font-semibold text-muted @xl:w-40 @xl:shrink-0">{ locale.t(`shop.kinds.${ SHOP_SLOTS[slot] }`) }</h3>
                                    <ul class="flex min-w-0 gap-2 overflow-x-auto pb-1 [scrollbar-width:none]" aria-label={ locale.t(`shop.kinds.${ SHOP_SLOTS[slot] }`) }>
                                        <li class="shrink-0">
                                            <button
                                                type="button"
                                                class="look-choice flex w-24 flex-col items-center gap-1.5 rounded-tile border border-line bg-sunk p-2 text-center"
                                                aria-pressed={ shop.chosen(slot) === null }
                                                onClick={ () => choose(slot, null) }
                                            >
                                                <span class="flex aspect-[4/3] w-full items-center justify-center rounded-control bg-raised text-muted" aria-hidden="true">
                                                    <Icon name="selected" size={ 18 } />
                                                </span>
                                                <span class="w-full truncate text-ui-xs font-semibold text-text">{ locale.t('shop.classic') }</span>
                                            </button>
                                        </li>
                                        <For each={ choices(slot) } key={ (item) => item } let={ item }>
                                            <li class="shrink-0">
                                                <button
                                                    type="button"
                                                    class="look-choice flex w-24 flex-col items-center gap-1.5 rounded-tile border border-line bg-sunk p-2 text-center"
                                                    aria-pressed={ shop.chosen(slot) === item }
                                                    onClick={ (event) => choose(slot, item, event.currentTarget as HTMLElement) }
                                                >
                                                    <img src={ `/looks/${ item }.svg` } alt="" width="80" height="60" loading="lazy" decoding="async" class="block aspect-[4/3] w-full rounded-control" />
                                                    <span class="line-clamp-2 w-full text-ui-xs font-semibold leading-tight text-text [overflow-wrap:anywhere]">{ itemName(item, locale) }</span>
                                                </button>
                                            </li>
                                        </For>
                                        <Show when={ open }>
                                            <li class="shrink-0">
                                                <Button variant="ghost" size="sm" leading="sparkles" class="h-full whitespace-nowrap" to={ `/app/shop?for=${ area.id === 'table' ? 'all' : area.id }` }>{ locale.t('shop.collection.more') }</Button>
                                            </li>
                                        </Show>
                                    </ul>
                                </div>
                            </For>
                        </Panel>
                    </div>
                </For>

                <Panel section stack="md" labelledBy="collection-gifts">
                    <h2 id="collection-gifts" class="text-ui-lg font-semibold text-text">{ locale.t('shop.collection.gifts') }</h2>
                    <Show when={ given } fallback={ <p class="text-ui-sm text-muted">{ locale.t('shop.collection.noGifts') }</p> }>
                        <ul class="divide-y divide-line">
                            <For each={ gifts } key={ (gift) => gift.item } let={ gift }>
                                <li class="flex items-center gap-3 py-2.5">
                                    <img src={ `/looks/${ gift.item }.svg` } alt="" width="64" height="48" loading="lazy" decoding="async" class="block aspect-[4/3] w-16 shrink-0 rounded-control" />
                                    <span class="flex min-w-0 flex-1 flex-col">
                                        <span class="truncate text-ui-sm font-semibold text-text">{ itemName(gift.item, locale) }</span>
                                        <span class="truncate text-ui-xs text-muted" dir="auto">{ locale.t('shop.collection.from', { name: people.byHandle(gift.from ?? '')?.displayName ?? gift.from ?? '' }) }</span>
                                    </span>
                                    <span class="shrink-0 text-ui-xs text-faint">{ when(gift.at) }</span>
                                </li>
                            </For>
                        </ul>
                    </Show>
                </Panel>

                <Panel section stack="md" labelledBy="collection-orders">
                    <h2 id="collection-orders" class="text-ui-lg font-semibold text-text">{ locale.t('shop.collection.orders') }</h2>
                    <Show when={ quiet }>
                        <p class="text-ui-sm text-muted">{ locale.t('shop.collection.noOrders') }</p>
                    </Show>
                    <Show when={ ordered }>
                        <ul class="divide-y divide-line">
                            <For each={ orders } key={ (order) => order.id } let={ order }>
                                <li data-order={ order.id }><OrderRow order={ order } /></li>
                            </For>
                        </ul>
                    </Show>
                    <Show when={ older }>
                        <LoadMore label={ locale.t('shop.collection.older') } onMore={ () => void shop.older() } />
                    </Show>
                </Panel>

                <Show when={ earning }>
                    <Panel section stack="md" labelledBy="collection-earnings">
                        <h2 id="collection-earnings" class="text-ui-lg font-semibold text-text">{ locale.t('shop.collection.earnings') }</h2>
                        <p class="text-ui-sm text-muted">{ locale.t('shop.collection.earningsLead', { share }) }</p>
                        <p class="text-ui-2xl font-bold text-text"><span class="tally">{ owedFigure }</span> NURA</p>
                        <Show when={ owed }>
                            <Button variant="primary" class="self-start" leading="coins" loading={ shop.claiming() } onClick={ () => void claim() }>
                                { locale.t('shop.claim', { amount: owedFigure }) }
                            </Button>
                        </Show>
                    </Panel>
                </Show>
            </div>
        </Show>
    </Page>
}
