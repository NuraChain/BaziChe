import { useHead, useNavigate } from 'azerothjs';

import { BEST_OF, FORMATS, FORMAT_IDS, type FormatId } from '../../../../backend/src/domains/tournament/engine/formats.ts';
import { client } from '../../api.ts';
import Page from '../../components/app/page.component.azeroth';
import PageHeader from '../../components/app/page-header.component.azeroth';
import Button from '../../components/ui/button.component.azeroth';
import Chip from '../../components/ui/chip.component.azeroth';
import Input from '../../components/ui/input.component.azeroth';
import Segmented from '../../components/ui/segmented.component.azeroth';
import type { GameId } from '../../data/games.ts';
import '../../locales/tournament-catalogue.ts';
import { whyTournament } from '../../lib/tournament-refusal.ts';
import { runtime } from '../../lib/runtime.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';

const HOUR_MS = 3_600_000;

/** What a `datetime-local` field holds: the reader's own clock, with no zone written. */
const localInput = (at: number) =>
{
    const date = new Date(at);

    return new Date(at - date.getTimezoneOffset() * 60_000).toISOString().slice(0, 16);
};

/** Laid out as a table is opened: one choice to a group, its label above it and what it means below. */
export default component TournamentCreatePage()
{
    const locale = useLocale();
    const catalogue = useCatalogue();
    const toasts = useToasts();
    const { navigate } = useNavigate();

    derived games = catalogue.games.filter((game) => catalogue.status(game.id) === 'available');

    state name = '';
    state game = 'chess' as string;
    state format = 'single' as FormatId;
    state size = 8;
    state bestOf = '1';
    state listed = 'yes';
    state starts = localInput(runtime().clock.now() + HOUR_MS);
    state sending = false;

    derived sizes = FORMATS[format].sizes;

    derived fittedSize = sizes.includes(size) ? size : sizes[0];

    derived fittedGame = games.some((one) => one.id === game) ? game : games[0]?.id ?? game;

    derived ready = name.trim() !== '' && starts !== '' && !sending;

    useHead({ title: () => locale.t('tournaments.new.title') });

    const submit = async () =>
    {
        if (!ready)
        {
            return;
        }

        sending = true;

        try
        {
            const made = await client.tournaments.create({
                input: {
                    name: name.trim(),
                    game: fittedGame as GameId,
                    format,
                    size: fittedSize,
                    bestOf: Number(bestOf),
                    listed: listed === 'yes',
                    startsAt: new Date(starts).toISOString()
                }
            });

            navigate(`/app/tournaments/${ made.code }`);
        }
        catch (error)
        {
            toasts.show({ kind: 'warning', text: locale.t(whyTournament(error)), dedupe: 'tournament-new' });
        }
        finally
        {
            sending = false;
        }
    };

    <Page width="narrow" label={ locale.t('tournaments.new.title') }>
        <div class="flex flex-col gap-6">
            <PageHeader eyebrow={ locale.t('tournaments.title') } title={ locale.t('tournaments.new.title') } lead={ locale.t('tournaments.new.lead') } flush />

            <form
                class="flex flex-col gap-7"
                onSubmit={ (event) =>
                {
                    event.preventDefault();
                    void submit();
                } }
            >
                <fieldset class="flex flex-col gap-2">
                    <legend class="label mb-2 text-ui-sm text-muted">{ locale.t('tournaments.new.name') }</legend>
                    <Input id="tournament-name" value={ name } onInput={ (value) => name = value } maxlength={ 60 } placeholder={ locale.t('tournaments.new.namePlaceholder') } label={ locale.t('tournaments.new.name') } autofocus />
                </fieldset>

                <fieldset class="flex flex-col gap-2">
                    <legend class="label mb-2 text-ui-sm text-muted">{ locale.t('tournaments.new.game') }</legend>
                    <ul class="flex flex-wrap gap-2">
                        <For each={ games } key={ (one) => one.id } let={ one }>
                            <li>
                                <Chip icon="games" selected={ fittedGame === one.id } onClick={ () => game = one.id }>
                                    <span>{ locale.t(one.nameKey) }</span>
                                </Chip>
                            </li>
                        </For>
                    </ul>
                </fieldset>

                <fieldset class="flex flex-col gap-2">
                    <legend class="label mb-2 text-ui-sm text-muted">{ locale.t('tournaments.new.format') }</legend>
                    <ul class="flex flex-wrap gap-2">
                        <For each={ [...FORMAT_IDS] } key={ (id) => id } let={ id }>
                            <li>
                                <Chip icon="medal" selected={ format === id } onClick={ () => format = id }>
                                    <span>{ locale.t(`tournaments.format.${ id }`) }</span>
                                </Chip>
                            </li>
                        </For>
                    </ul>
                    <p class="text-ui-xs text-faint">{ locale.t(`tournaments.formatHint.${ format }`) }</p>
                </fieldset>

                <fieldset class="flex flex-col gap-2">
                    <legend class="label mb-2 text-ui-sm text-muted">{ locale.t('tournaments.new.size') }</legend>
                    <ul class="flex flex-wrap gap-2">
                        <For each={ [...sizes] } key={ (one) => one } let={ one }>
                            <li>
                                <Chip icon="people" selected={ fittedSize === one } onClick={ () => size = one }>
                                    <span class="tally">{ locale.n(one) }</span>
                                </Chip>
                            </li>
                        </For>
                    </ul>
                </fieldset>

                <fieldset class="flex flex-col gap-2">
                    <legend class="label mb-2 text-ui-sm text-muted">{ locale.t('tournaments.new.length') }</legend>
                    <Segmented
                        block
                        label={ locale.t('tournaments.new.length') }
                        value={ bestOf }
                        items={ BEST_OF.map((n) => ({ id: String(n), label: locale.t('tournaments.bestOf', { n: locale.n(n) }) })) }
                        onChange={ (id) => bestOf = id }
                    />
                </fieldset>

                <fieldset class="flex flex-col gap-2">
                    <legend class="label mb-2 text-ui-sm text-muted">{ locale.t('tournaments.new.starts') }</legend>
                    <Input id="tournament-starts" type="datetime-local" value={ starts } onInput={ (value) => starts = value } label={ locale.t('tournaments.new.starts') } />
                    <p class="text-ui-xs text-faint">{ locale.t('tournaments.new.startsHint') }</p>
                </fieldset>

                <fieldset class="flex flex-col gap-2">
                    <legend class="label mb-2 text-ui-sm text-muted">{ locale.t('tournaments.new.visibility') }</legend>
                    <Segmented
                        block
                        label={ locale.t('tournaments.new.visibility') }
                        value={ listed }
                        items={ [
                            { id: 'yes', label: locale.t('tournaments.new.listed'), icon: 'discover' },
                            { id: 'no', label: locale.t('tournaments.new.linkOnly'), icon: 'lock' }
                        ] }
                        onChange={ (id) => listed = id }
                    />
                    <p class="text-ui-xs text-faint">{ locale.t(listed === 'yes' ? 'tournaments.new.listedHint' : 'tournaments.new.linkOnlyHint') }</p>
                </fieldset>

                <Button variant="primary" size="lg" block submit leading="add" loading={ sending } disabled={ !ready }>{ locale.t('tournaments.create') }</Button>
            </form>
        </div>
    </Page>
}
