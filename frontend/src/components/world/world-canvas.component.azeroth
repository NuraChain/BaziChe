import type { TourStage } from '../../world/gate.ts';
import { useFocus } from '../../stores/focus.store.ts';
import { useLocale } from '../../stores/locale.store.ts';

export default component WorldCanvas()
{
    const locale = useLocale();
    const focus = useFocus();
    let host: HTMLDivElement | null = null;
    let canvas: HTMLCanvasElement | null = null;
    let stage: TourStage | null = null;

    state live = false;
    derived preview = !live && focus.chapter() === null ? focus.game() : null;

    mount
    {
        let mounted = true;
        void import('../../world/gate.ts').then(({ attachStage }) =>
        {
            if (mounted && host !== null && canvas !== null)
            {
                stage = attachStage(host, canvas, {
                    onLive: (value) => live = value,
                    onChapter: (id) => focus.setChapter(id),
                    onTour: (visible) => focus.setInTour(visible),
                    preview: () => focus.chapter() === null ? focus.game() : null
                });
            }
        });
        return () =>
        {
            mounted = false;
            stage?.dispose();
            stage = null;
            focus.setChapter(null);
            focus.setInTour(false);
        };
    }

    effect
    {
        const id = focus.game();
        stage?.focus(focus.chapter() === null ? id : null);
    }

    effect
    {
        const angle = focus.orbit();
        stage?.orbit(angle);
    }

    effect
    {
        locale.dir();
        stage?.refresh();
    }

    <div ref={ (element) => host = element } data-shot={ focus.chapter() ?? 'arrival' } data-game-color={ focus.chapter() ?? focus.game() ?? undefined } class="stage world-stage [--subject-x:0.5] [--subject-y:0.32] beside:[--subject-x:0.725] beside:[--subject-y:0.5] beside:rtl:[--subject-x:0.275]" aria-hidden="true">
        <div
            class="world-poster absolute inset-0 bg-[url('/world/poster-portrait.webp')] bg-cover bg-[position:calc(var(--subject-x)*100%)_calc(var(--subject-y)*100%)] bg-no-repeat beside:bg-[url('/world/poster-wide-ltr.webp')] beside:rtl:bg-[url('/world/poster-wide-rtl.webp')]"
            hidden={ preview !== null }
            data-live={ live ? '' : undefined }
        ></div>
        <canvas
            ref={ (element) => canvas = element }
            class={ () => ['world-canvas absolute inset-0 block h-full w-full [transition:opacity_400ms_ease]', live ? 'is-live opacity-100' : 'opacity-0'].join(' ') }
        ></canvas>
        <Show when={ preview !== null }>
            { () => <div class="landing-scene-still"><img src={ `/world/card-${ preview }.webp` } alt="" /></div> }
        </Show>
        <div class="scrim"></div>
    </div>
}
