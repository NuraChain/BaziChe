import { Link, createResource, untrack, useHead, useParams } from 'azerothjs';

import type { FormatId } from '../../../../backend/src/domains/tournament/engine/formats.ts';
import type { AdminTournament } from '../../../../backend/src/schemas.ts';
import { client } from '../../api.ts';
import AdminHead from '../../components/admin/admin-head.component.azeroth';
import LogEntry from '../../components/admin/log-entry.component.azeroth';
import ReasonSheet from '../../components/admin/reason-sheet.component.azeroth';
import TournamentTimeSheet, { type NewStart } from '../../components/admin/tournament-time-sheet.component.azeroth';
import When from '../../components/admin/when.component.azeroth';
import Badge from '../../components/ui/badge.component.azeroth';
import Button from '../../components/ui/button.component.azeroth';
import ErrorState from '../../components/ui/error-state.component.azeroth';
import Skeleton from '../../components/ui/skeleton.component.azeroth';
import { GAMES } from '../../data/games.ts';
import { attempt } from '../../lib/attempt.ts';
import { runtime } from '../../lib/runtime.ts';
import { whyStaffRefused } from '../../lib/staff-words.ts';
import '../../locales/tournament-catalogue.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';

type Entrant = AdminTournament['tournament']['entrants'][number];

/** One tournament as the staff see it: what it is, what they may do to it, who is in it and what was done before. */
export default component AdminTournamentPage()
{
    const locale = useLocale();
    const overlay = useOverlay();
    const params = useParams();

    /** Read once: a page that is being left still sees the address it is going to. */
    const code = untrack(() => params().code ?? '');

    const read = createResource(() => client.admin.tournament({ params: { code } }), { name: 'admin.tournament' });

    derived page = read.data() ?? null;

    derived waiting = page === null && read.error() === null;

    derived failed = page === null && read.error() !== null;

    derived shown = page !== null;

    derived tournament = page?.tournament ?? null;

    derived name = tournament?.name ?? '';

    derived going = tournament?.status === 'open' || tournament?.status === 'running';

    derived waitingToStart = tournament?.status === 'open';

    derived featured = tournament?.featured === true;

    derived hidden = page?.hidden === true;

    derived linkOnly = tournament?.listed === false;

    derived players = (tournament?.entrants ?? []).filter((entry) => entry.who !== undefined);

    derived log = page?.log ?? [];

    derived logged = log.length > 0;

    derived game = (() =>
    {
        const found = GAMES.find((one) => one.id === tournament?.game);

        return found === undefined ? tournament?.game ?? '' : locale.t(found.nameKey);
    })();

    derived lead = tournament === null
        ? ''
        : [
            locale.t(`tournaments.status.${ tournament.status }`),
            game,
            locale.t(`tournaments.format.${ tournament.format as FormatId }`),
            locale.t('tournaments.places', { entered: locale.n(tournament.entered), size: locale.n(tournament.size) }),
            locale.t('tournaments.bestOf', { n: locale.n(tournament.bestOf) })
        ].join(' · ');

    useHead({ title: () => name === '' ? locale.t('admin.section.tournaments') : name });

    /** Asks for a reason, does it, says so, and reads the page again whatever happened. */
    const act = async (ask: { title: string; lead?: string; confirm: string; destructive?: boolean }, call: (reason: string) => Promise<unknown>, done: string) =>
    {
        const reason = await overlay.open(ReasonSheet, ask, { label: ask.title }).closed;

        if (typeof reason !== 'string')
        {
            return;
        }

        await attempt(call(reason), done, whyStaffRefused);
        await read.refetch();
    };

    const startNow = () => act(
        { title: locale.t('tournaments.admin.startAsk', { name }), lead: locale.t('tournaments.admin.startLead', { n: locale.n(players.length) }), confirm: locale.t('tournaments.admin.start') },
        (reason) => client.admin.startTournament({ params: { code }, input: { reason } }),
        locale.t('tournaments.admin.started', { name })
    );

    const moveStart = async () =>
    {
        const asked = await overlay.open(
            TournamentTimeSheet,
            { title: locale.t('tournaments.admin.moveAsk', { name }), lead: locale.t('tournaments.admin.moveLead'), from: tournament?.startsAt ?? new Date(runtime().clock.now()).toISOString() },
            { label: locale.t('tournaments.admin.move') }
        ).closed as NewStart | null;

        if (asked === null || typeof asked !== 'object')
        {
            return;
        }

        await attempt(client.admin.moveTournament({ params: { code }, input: asked }), locale.t('tournaments.admin.saved'), whyStaffRefused);
        await read.refetch();
    };

    const feature = () => act(
        featured
            ? { title: locale.t('tournaments.admin.unfeatureAsk', { name }), confirm: locale.t('tournaments.admin.unfeature') }
            : { title: locale.t('tournaments.admin.featureAsk', { name }), lead: locale.t('tournaments.admin.featureLead'), confirm: locale.t('tournaments.admin.feature') },
        (reason) => client.admin.featureTournament({ params: { code }, input: { on: !featured, reason } }),
        locale.t('tournaments.admin.saved')
    );

    const hide = () => act(
        hidden
            ? { title: locale.t('tournaments.admin.showAsk', { name }), confirm: locale.t('tournaments.admin.show') }
            : { title: locale.t('tournaments.admin.hideAsk', { name }), lead: locale.t('tournaments.admin.hideLead'), confirm: locale.t('tournaments.admin.hide') },
        (reason) => client.admin.hideTournament({ params: { code }, input: { on: !hidden, reason } }),
        locale.t('tournaments.admin.saved')
    );

    const cancel = () => act(
        { title: locale.t('tournaments.admin.ask', { name }), lead: locale.t('tournaments.admin.askLead'), confirm: locale.t('tournaments.admin.cancel'), destructive: true },
        (reason) => client.admin.cancelTournament({ params: { code }, input: { reason } }),
        locale.t('tournaments.admin.done', { name })
    );

    const remove = (entry: Entrant) =>
    {
        const who = entry.who ?? '';

        return act(
            {
                title: locale.t('tournaments.admin.removeAsk', { who: `@${ who }`, name }),
                lead: locale.t(waitingToStart ? 'tournaments.admin.removeLeadOpen' : 'tournaments.admin.removeLeadRunning'),
                confirm: locale.t('tournaments.admin.remove'),
                destructive: true
            },
            (reason) => client.admin.removeFromTournament({ params: { code }, input: { player: who, reason } }),
            locale.t('tournaments.admin.removed', { who: `@${ who }` })
        );
    };

    <div class="flex flex-col gap-6 @container">
        <Show when={ waiting }>
            { () => <Skeleton lines={ 6 } /> }
        </Show>

        <Show when={ failed }>
            { () => <ErrorState error={ read.error() } onRetry={ () => void read.refetch() } /> }
        </Show>

        <Show when={ shown }>
            { () =>
                <div class="flex flex-col gap-6">
                    <AdminHead title={ name } lead={ lead } back={ { to: '/admin/tournaments', label: locale.t('tournaments.admin.back') } } />

                    <div class="flex flex-wrap items-center gap-2">
                        <Show when={ featured }>
                            <Badge text={ locale.t('tournaments.featured') } tone="gold" size="sm" />
                        </Show>
                        <Show when={ hidden }>
                            <Badge text={ locale.t('tournaments.admin.hidden') } tone="danger" size="sm" />
                        </Show>
                        <Show when={ linkOnly }>
                            <Badge text={ locale.t('tournaments.admin.linkOnly') } tone="neutral" size="sm" />
                        </Show>
                        <span class="facts text-ui-xs text-muted">
                            <span dir="ltr">{ code.toUpperCase() }</span>
                            <span>{ locale.t('tournaments.admin.starts') } <When at={ tournament?.startsAt ?? '' } /></span>
                            <Show when={ tournament?.creator !== undefined }>
                                <span>{ locale.t('tournaments.admin.creator') } <Link to={ () => `/admin/people/${ encodeURIComponent(tournament?.creator ?? '') }` } class="font-semibold text-accent hover:underline" dir="ltr">@{ tournament?.creator }</Link></span>
                            </Show>
                        </span>
                    </div>

                    <div class="flex flex-wrap gap-2" role="group" aria-label={ locale.t('tournaments.admin.title') }>
                        <Button variant="secondary" leading="watch" to={ `/app/tournaments/${ encodeURIComponent(code) }` }>{ locale.t('tournaments.admin.view') }</Button>
                        <Show when={ waitingToStart }>
                            <Button variant="primary" leading="zap" onClick={ () => void startNow() }>{ locale.t('tournaments.admin.start') }</Button>
                        </Show>
                        <Show when={ waitingToStart }>
                            <Button variant="secondary" leading="clock" onClick={ () => void moveStart() }>{ locale.t('tournaments.admin.move') }</Button>
                        </Show>
                        <Button variant="secondary" leading="star" onClick={ () => void feature() }>{ locale.t(featured ? 'tournaments.admin.unfeature' : 'tournaments.admin.feature') }</Button>
                        <Button variant="secondary" leading="discover" onClick={ () => void hide() }>{ locale.t(hidden ? 'tournaments.admin.show' : 'tournaments.admin.hide') }</Button>
                        <Show when={ going }>
                            <Button variant="destructive" leading="close" onClick={ () => void cancel() }>{ locale.t('tournaments.admin.cancel') }</Button>
                        </Show>
                    </div>

                    <section class="flex flex-col gap-3" aria-labelledby="admin-tournament-players">
                        <h2 id="admin-tournament-players" class="text-ui-md font-semibold text-text">{ locale.t('tournaments.admin.players') }</h2>
                        <ul class="flex flex-col divide-y divide-line overflow-hidden rounded-panel border border-line bg-field">
                            <For each={ players } key={ (entry) => entry.spot } let={ entry }>
                                <li class="flex min-w-0 items-center gap-3 px-4 py-2.5">
                                    <span class="w-7 shrink-0 text-ui-xs tabular-nums text-faint">{ locale.n(entry.spot) }</span>
                                    <Link to={ () => `/admin/people/${ encodeURIComponent(entry.who ?? '') }` } class="min-w-0 flex-1 truncate text-ui-sm font-semibold text-text hover:underline" dir="ltr">@{ entry.who }</Link>
                                    <Show when={ entry.removed === true }>
                                        <Badge text={ locale.t('tournaments.removed') } tone="danger" size="sm" />
                                    </Show>
                                    <Show when={ entry.place !== undefined }>
                                        <Badge text={ locale.n(entry.place ?? 0) } tone="neutral" size="sm" />
                                    </Show>
                                    <Show when={ going && entry.removed !== true }>
                                        <Button variant="ghost" size="sm" onClick={ () => void remove(entry) }>{ locale.t('tournaments.admin.remove') }</Button>
                                    </Show>
                                </li>
                            </For>
                        </ul>
                    </section>

                    <section class="flex flex-col gap-3" aria-labelledby="admin-tournament-log">
                        <h2 id="admin-tournament-log" class="text-ui-md font-semibold text-text">{ locale.t('tournaments.admin.log') }</h2>
                        <Show
                            when={ logged }
                            fallback={ <p class="text-ui-sm text-muted">{ locale.t('tournaments.admin.logEmpty') }</p> }
                        >
                            <ul class="flex flex-col divide-y divide-line overflow-hidden rounded-panel border border-line bg-field">
                                <For each={ log } key={ (row) => row.id } let={ row }>
                                    <li><LogEntry row={ row } /></li>
                                </For>
                            </ul>
                        </Show>
                    </section>
                </div>
            }
        </Show>
    </div>
}
