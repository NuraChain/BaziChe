import type { ChannelSummary } from '../../api.ts';
import { whyFailed } from '../../lib/failure.ts';
import { useChannels } from '../../stores/channels.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import type { OverlayProps } from '../../stores/overlay.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';
import Avatar from '../ui/avatar.component.azeroth';
import Button from '../ui/button.component.azeroth';
import SheetHeader from '../ui/sheet-header.component.azeroth';
import Skeleton from '../ui/skeleton.component.azeroth';

type Role = 'owner' | 'admin' | 'member';

const ROLE_WORDS = { owner: 'channels.role.owner', admin: 'channels.role.admin', member: 'channels.role.member' } as const;

/**
 * Who is in a channel and as what. The owner names an admin, makes one a member again, takes a
 * member out, or hands the channel to one of them (asked first, in the row); everybody else sees
 * the list.
 */
export default component ChannelMembers(props: OverlayProps & { channel: ChannelSummary })
{
    const locale = useLocale();
    const channels = useChannels();
    const people = usePeople();
    const toasts = useToasts();

    state members = null as { handle: string; role: Role }[] | null;
    state busy = '';
    state handing = '';
    state owns = props.channel.role === 'owner';

    const load = async () =>
    {
        try
        {
            const read = await channels.members(props.channel.slug);

            members = read;
            void people.want(read.map((one) => one.handle));
        }
        catch (error)
        {
            members = [];
            toasts.show({ kind: 'warning', text: locale.t(whyFailed(error)) });
        }
    };

    mount
    {
        void load();
    }

    const act = async (handle: string, work: Promise<void>) =>
    {
        if (busy !== '')
        {
            return;
        }

        busy = handle;

        try
        {
            await work;
            await load();
        }
        catch (error)
        {
            toasts.show({ kind: 'warning', text: locale.t(whyFailed(error)) });
        }
        finally
        {
            busy = '';
        }
    };

    const nameOf = (handle: string) => locale.text(people.byHandle(handle)?.displayName ?? handle);

    const handOver = async (handle: string) =>
    {
        if (busy !== '')
        {
            return;
        }

        busy = handle;

        try
        {
            await channels.transfer(props.channel.slug, handle);
            owns = false;
            handing = '';
            toasts.show({ kind: 'success', text: locale.t('channels.transferred', { who: nameOf(handle), name: props.channel.name }) });
            await load();
        }
        catch (error)
        {
            toasts.show({ kind: 'warning', text: locale.t(whyFailed(error)) });
        }
        finally
        {
            busy = '';
        }
    };

    <div class="flex flex-col gap-4 p-5" data-channel-members>
        <SheetHeader title={ locale.t('channels.membersTitle', { name: props.channel.name }) } onClose={ () => props.close() } />

        <Show
            when={ members !== null }
            fallback={
                <div data-reading>
                    <span class="sr-only">{ locale.t('common.loading') }</span>
                    <Skeleton avatar lines={ 2 } class="py-2" />
                    <Skeleton avatar lines={ 2 } class="py-2" />
                </div>
            }
        >
            { () =>
                <ul class="flex flex-col gap-1">
                    <For each={ members ?? [] } key={ (member) => member.handle } let={ member }>
                        <li class="flex flex-col gap-2 px-1 py-1.5" data-member={ member.handle } data-role={ member.role }>
                            <div class="flex min-h-11 items-center gap-3">
                                <Avatar person={ people.byHandle(member.handle) } size="sm" />
                                <span class="flex min-w-0 flex-1 flex-col">
                                    <span class="truncate text-ui-sm font-semibold text-text" dir="auto">{ nameOf(member.handle) }</span>
                                    <span class="text-ui-xs text-muted">{ locale.t(ROLE_WORDS[member.role]) }</span>
                                </span>
                                <Show when={ owns && member.role !== 'owner' && handing !== member.handle }>
                                    { () =>
                                        <span class="flex shrink-0 flex-wrap justify-end gap-1">
                                            <Button
                                                variant="ghost"
                                                size="sm"
                                                disabled={ busy !== '' }
                                                onClick={ () => void act(member.handle, channels.setRole(props.channel.slug, member.handle, member.role === 'admin' ? 'member' : 'admin')) }
                                            >
                                                { locale.t(member.role === 'admin' ? 'channels.role.unmake' : 'channels.role.make') }
                                            </Button>
                                            <Button
                                                variant="ghost"
                                                size="sm"
                                                disabled={ busy !== '' }
                                                onClick={ () => void act(member.handle, channels.remove(props.channel.slug, member.handle)) }
                                            >
                                                { locale.t('channels.role.remove') }
                                            </Button>
                                            <Button
                                                variant="ghost"
                                                size="sm"
                                                disabled={ busy !== '' }
                                                onClick={ () => { handing = member.handle; } }
                                            >
                                                { locale.t('channels.role.transfer') }
                                            </Button>
                                        </span>
                                    }
                                </Show>
                            </div>
                            <Show when={ owns && handing === member.handle }>
                                { () =>
                                    <div class="flex flex-col gap-2 rounded-tile border border-line bg-field p-3" data-handing={ member.handle }>
                                        <p class="text-ui-sm text-text" dir="auto">{ locale.t('channels.transferAsk', { name: props.channel.name, who: nameOf(member.handle) }) }</p>
                                        <span class="flex justify-end gap-2">
                                            <Button variant="ghost" size="sm" disabled={ busy !== '' } onClick={ () => { handing = ''; } }>{ locale.t('common.cancel') }</Button>
                                            <Button variant="primary" size="sm" disabled={ busy !== '' } onClick={ () => void handOver(member.handle) }>{ locale.t('channels.transferYes') }</Button>
                                        </span>
                                    </div>
                                }
                            </Show>
                        </li>
                    </For>
                </ul>
            }
        </Show>
    </div>
}
