import Icon from '../../icons/icon.component.azeroth';
import { useLocale } from '../../stores/locale.store.ts';
import type { OverlayProps } from '../../stores/overlay.store.ts';

/**
 * A photo full screen, from the address its bubble holds it at: a press anywhere or Escape closes it,
 * and Save keeps it under its name. Nothing is fetched here; the bubble has the photo already.
 */
export default component FileViewer(props: OverlayProps & { url: string; name: string; from: string })
{
    const locale = useLocale();

    <div
        class="fixed inset-0 flex flex-col bg-black/90 pointer-events-auto"
        role="dialog"
        aria-modal="true"
        aria-label={ locale.t('chat.file.viewer', { name: props.from }) }
        tabindex="-1"
        data-viewer
        onClick={ () => props.close() }
    >
        <div class="flex items-center justify-end gap-1 p-2">
            <a
                href={ props.url }
                download={ props.name }
                class="flex h-11 w-11 items-center justify-center rounded-full text-white hover:bg-white/10"
                aria-label={ locale.t('chat.file.save', { name: props.name }) }
                onClick={ (event) => event.stopPropagation() }
            >
                <Icon name="download" size={ 20 } />
            </a>
            <button
                type="button"
                class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-full text-white hover:bg-white/10"
                aria-label={ locale.t('chat.file.close') }
                onClick={ () => props.close() }
            >
                <Icon name="close" size={ 20 } />
            </button>
        </div>
        <div class="flex min-h-0 flex-1 items-center justify-center p-4 pt-0">
            <img src={ props.url } alt={ props.name } class="max-h-full max-w-full object-contain" draggable={ false } />
        </div>
    </div>
}
