import { createResource } from 'azerothjs';

import type { GroupSummary } from '../../api.ts';
import type { Person } from '../../data/person.ts';
import Icon from '../../icons/icon.component.azeroth';
import { readingOf } from '../../lib/reading.ts';
import { useGroups } from '../../stores/groups.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import type { OverlayProps } from '../../stores/overlay.store.ts';
import { usePresence } from '../../stores/presence.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';
import Avatar from '../ui/avatar.component.azeroth';
import EmptyState from '../ui/empty-state.component.azeroth';
import ErrorState from '../ui/error-state.component.azeroth';
import SearchInput from '../ui/search-input.component.azeroth';
import Skeleton from '../ui/skeleton.component.azeroth';
import { whyFailed } from '../../lib/failure.ts';
import { namesOf, narrowed, SEARCH_FROM } from '../../services/search.service.ts';

/**
 * Who can be brought into a group: the people this account has added who are not in it and not
 * kept out of it, as the server answers them, so no list of every member is needed to leave them out.
 *
 * Friends only, and not because the server insists - it gates on `mayMessage`, which a stranger
 * with open settings would pass. It is a product decision: a group is somebody's room, and being
 * put in one by a person you have never spoken to is the kind of thing that needs an invitation
 * rather than an addition. The server's rule is the floor; this is the door.
 */
export default component GroupAdd(props: OverlayProps & { group: GroupSummary })
{
    const locale = useLocale();
    const groups = useGroups();
    const presence = usePresence();
    const toasts = useToasts();

    state pending = '';
    state query = '';

    const offer = createResource(() => props.group.id, (slug) => groups.addable(slug), { name: 'groups.addable' });

    derived everyone = [...(offer.data() ?? [])]
        .sort((a, b) => (presence.isOnline(a.id) ? 0 : 1) - (presence.isOnline(b.id) ? 0 : 1));

    derived candidates = narrowed(everyone, query, namesOf);

    derived reading = readingOf(offer);

    derived offerReading = reading === 'reading';

    derived offerFailed = reading === 'failed';

    derived searchable = reading === 'read' && everyone.length > SEARCH_FROM;

    derived offered = candidates.length > 0;

    derived quiet = reading === 'read' && !offered;

    const add = async (person: Person) =>
    {
        if (pending !== '')
        {
            return;
        }
        pending = person.id;
        try
        {
            await groups.add(props.group.id, person.id);
            toasts.show({ kind: 'success', text: locale.t('groups.added', { name: person.displayName }) });
            props.close(person.id);
        }
        catch (error)
        {
            toasts.show({ kind: 'warning', text: locale.t(whyFailed(error)) });
        }
        finally
        {
            pending = '';
        }
    };

    <div class="flex flex-col gap-4 p-5">
        <div>
            <h2 class="title text-ui-xl text-text">{ locale.t('groups.addTitle', { name: props.group.name }) }</h2>
            <p class="mt-2 text-ui-base text-muted">{ locale.t('groups.addLead') }</p>
        </div>

        <Show when={ searchable }>
            { () => <SearchInput value={ query } onInput={ (value) => query = value } placeholder={ locale.t('create.search') } label={ locale.t('create.search') } /> }
        </Show>

        <Show when={ offerReading }>
            { () =>
                <div class="flex flex-col" data-reading>
                    <span class="sr-only">{ locale.t('common.loading') }</span>
                    <Skeleton avatar lines={ 2 } class="py-2" />
                    <Skeleton avatar lines={ 2 } class="py-2" />
                </div>
            }
        </Show>

        <Show when={ offerFailed }>
            { () => <ErrorState compact error={ offer.error() } onRetry={ () => void offer.refetch() } /> }
        </Show>

        <Show when={ quiet }>
            { () => <EmptyState icon="people" title={ everyone.length > 0 ? locale.t('search.empty', { query: query.trim() }) : locale.t('groups.addNone') } class="py-8" /> }
        </Show>

        <Show when={ offered }>
            { () =>
                <ul class="flex flex-col gap-1" aria-label={ locale.t('groups.add') }>
                    <For each={ candidates } key={ (person) => person.id } let={ person }>
                        <li>
                            <button
                                type="button"
                                class="flex min-h-14 w-full cursor-pointer items-center gap-3 rounded-tile px-2 py-2 text-start transition-colors hover:bg-raised/60"
                                disabled={ pending !== '' }
                                onClick={ () => void add(person) }
                            >
                                <Avatar person={ person } size="md" presence={ presence.dot(person.id) } />
                                <span class="flex min-w-0 flex-1 flex-col">
                                    <span class="truncate text-ui-base font-semibold text-text" dir="auto">{ person.displayName }</span>
                                    <span class="truncate text-ui-xs text-muted" dir="ltr">@{ person.handle }</span>
                                </span>
                                <Icon name="friend-add" size={ 16 } class="shrink-0 text-accent" />
                            </button>
                        </li>
                    </For>
                </ul>
            }
        </Show>
    </div>
}
