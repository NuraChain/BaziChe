import type { Message } from '../../data/chat.ts';
import Icon from '../../icons/icon.component.azeroth';
import type { MessageKey } from '../../locales/en.ts';
import { useChat } from '../../stores/chat.store.ts';
import { useFileLoads, type FileFault } from '../../stores/file-loads.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import { sizeSaid, voiceClock } from './gist.ts';
import FileViewer from './file-viewer.component.azeroth';

const FAULTS: Record<FileFault, MessageKey> = {
    gone: 'chat.file.gone',
    failed: 'chat.file.failed',
    tampered: 'chat.file.tampered',
    unshowable: 'chat.file.unshowable'
};

/** A thumb as the picture its bytes are: base64url in the document, base64 in an address. */
const thumbOf = (thumb: string | undefined) =>
{
    if (thumb === undefined)
    {
        return null;
    }

    const plain = thumb.replaceAll('-', '+').replaceAll('_', '/');

    return `data:image/jpeg;base64,${ plain }${ '='.repeat((4 - (plain.length % 4)) % 4) }`;
};

/** A name cut in its middle, so a long one still shows how it ends: `holiday-photos-…-final.pdf`. */
const middleOf = (name: string, most = 32) =>
{
    if (name.length <= most)
    {
        return name;
    }

    const tail = Math.min(12, Math.floor(most / 2));

    return `${ name.slice(0, most - tail - 1) }…${ name.slice(-tail) }`;
};

/** What the type or the name says the file is, in a few capitals: PDF, ZIP, MP3. */
const extensionOf = (name: string, mime: string) =>
{
    const dot = name.lastIndexOf('.');
    const said = dot > 0 && dot < name.length - 1 ? name.slice(dot + 1) : (mime.split('/')[1] ?? '');

    return said.slice(0, 6).toUpperCase();
};

/**
 * A photo, a video or a file in its bubble. Nothing is fetched until it is pressed: a photo or a video
 * shows its thumb, blurred, at its own proportions, with how large it is (and a video how long), and
 * a file its name, its size and its type, each with a download button. Pressed, a ring fills as it
 * comes (a second press stops it); come, a photo is shown and opens full screen, a video plays in the
 * bubble, and a file is saved under its name. Never shown inline as anything its bytes did not say.
 */
export default component FileNote(props: {
    message: Message;
    mine: boolean;

    /** The bubble's time, kept room for at the end of the lower line when no caption is under it. */
    reserve: string;
    trail: boolean;
})
{
    const locale = useLocale();
    const chat = useChat();
    const loads = useFileLoads();
    const overlay = useOverlay();
    const people = usePeople();

    derived file = props.message.file!;

    derived mine = props.mine;

    derived shown = file.as !== 'file';

    derived photo = file.as === 'photo';

    derived state = loads.stateOf(props.message);

    derived ready = state !== null && state.at === 'ready';

    derived loading = state !== null && state.at === 'loading';

    derived fraction = state !== null && state.at === 'loading' ? state.fraction : 0;

    derived fault = state !== null && state.at === 'fault' ? state.fault : null;

    derived alarming = fault === 'tampered';

    derived url = state !== null && state.at === 'ready' ? state.url : '';

    derived size = sizeSaid(file.bytes, locale);

    derived length = file.ms === undefined ? '' : voiceClock(Math.round(file.ms / 1000), locale.n);

    derived meta = file.as === 'video' && length !== '' ? `${ length } · ${ size }` : size;

    derived sending = chat.uploadOf(props.message.id);

    derived uploading = sending !== null;

    derived thumb = thumbOf(file.thumb);

    derived ratio = file.w !== undefined && file.h !== undefined ? `${ file.w } / ${ file.h }` : '4 / 3';

    derived wide = file.w !== undefined && file.h !== undefined && file.w >= file.h;

    derived label = loading ? locale.t('chat.file.cancel') : locale.t('chat.file.download', { name: file.name, size });

    derived reserve = props.reserve;

    derived room = props.trail ? 'invisible ps-2 pe-4' : 'invisible ps-2';

    derived from = (() =>
    {
        const person = people.byHandle(props.message.from);

        return person === null ? props.message.from : locale.text(person.displayName);
    })();

    const view = () =>
    {
        if (url !== '')
        {
            overlay.open(FileViewer, { url, name: file.name, from }, { label: locale.t('chat.file.viewer', { name: from }), kind: 'modal' });
        }
    };

    <div class="flex max-w-full flex-col gap-1 py-0.5" data-file={ file.id } data-as={ file.as }>
        <Show
            when={ shown }
            fallback={
                <div class="flex min-w-0 items-center gap-2.5">
                    <Show
                        when={ ready }
                        fallback={
                            <button
                                type="button"
                                class={ () => [
                                    'relative flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-full transition-transform duration-150 active:scale-95 motion-reduce:transition-none',
                                    mine ? 'bg-accent-ink text-accent-fill focus-visible:outline-accent-ink' : 'bg-accent-fill text-accent-ink'
                                ].join(' ') }
                                aria-label={ label }
                                aria-busy={ loading ? 'true' : undefined }
                                data-download={ loading ? 'loading' : 'idle' }
                                onClick={ () => loads.toggle(props.message) }
                            >
                                <Icon name={ loading ? 'close' : 'download' } size={ 18 } />
                                <Show when={ loading || uploading }>
                                    { () =>
                                        <svg class="pointer-events-none absolute -inset-1 -rotate-90" viewBox="0 0 48 48" aria-hidden="true" data-ring>
                                            <circle cx="24" cy="24" r="22.5" fill="none" stroke="currentColor" stroke-opacity="0.25" stroke-width="2.5"></circle>
                                            <circle cx="24" cy="24" r="22.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" pathLength="100" stroke-dasharray="100" stroke-dashoffset={ 100 - Math.round((uploading ? sending ?? 0 : fraction) * 100) }></circle>
                                        </svg>
                                    }
                                </Show>
                            </button>
                        }
                    >
                        { () =>
                            <a
                                href={ url }
                                download={ file.name }
                                class={ () => [
                                    'flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-full',
                                    mine ? 'bg-accent-ink text-accent-fill focus-visible:outline-accent-ink' : 'bg-accent-fill text-accent-ink'
                                ].join(' ') }
                                aria-label={ locale.t('chat.file.save', { name: file.name }) }
                                data-save
                            >
                                <Icon name="file" size={ 18 } />
                            </a>
                        }
                    </Show>
                    <span class="flex min-w-0 flex-col">
                        <span class="max-w-56 truncate text-ui-sm font-semibold" dir="auto" title={ file.name }>{ middleOf(file.name) }</span>
                        <span class={ () => [ 'flex items-center gap-1 text-ui-2xs tabular-nums', mine ? 'text-accent-ink/75' : 'text-muted' ].join(' ') }>
                            <span data-size>{ size }</span>
                            <span aria-hidden="true">·</span>
                            <span>{ extensionOf(file.name, file.mime) }</span>
                            <span class={ () => `ms-auto ${ room }` } aria-hidden="true">{ reserve }</span>
                        </span>
                    </span>
                </div>
            }
        >
            { () =>
                <div
                    class={ () => [ 'relative -mx-1.5 overflow-hidden rounded-[0.8rem] bg-black/20', wide ? 'w-72 max-w-full' : 'w-52 max-w-full' ].join(' ') }
                    style={ `aspect-ratio: ${ ratio }; max-height: 22rem` }
                >
                    <Show when={ thumb !== null && !ready }>
                        { () => <img src={ thumb ?? '' } alt="" class="absolute inset-0 h-full w-full scale-110 object-cover blur-md" aria-hidden="true" /> }
                    </Show>
                    <Show when={ ready && photo }>
                        { () =>
                            <button type="button" class="absolute inset-0 cursor-zoom-in" aria-label={ locale.t('chat.file.open') } onClick={ view }>
                                <img src={ url } alt={ props.message.text === '' ? file.name : props.message.text } class="h-full w-full object-cover" draggable={ false } />
                            </button>
                        }
                    </Show>
                    <Show when={ ready && !photo }>
                        { () => <video src={ url } controls playsinline preload="metadata" class="absolute inset-0 h-full w-full bg-black object-contain"></video> }
                    </Show>
                    <Show when={ !ready }>
                        { () =>
                            <span class="absolute inset-0 flex items-center justify-center">
                                <button
                                    type="button"
                                    class="relative flex h-12 w-12 cursor-pointer items-center justify-center rounded-full bg-black/55 text-white backdrop-blur-sm transition-transform duration-150 active:scale-95 motion-reduce:transition-none"
                                    aria-label={ label }
                                    aria-busy={ loading ? 'true' : undefined }
                                    data-download={ loading ? 'loading' : 'idle' }
                                    disabled={ fault !== null && fault !== 'failed' }
                                    onClick={ () => loads.toggle(props.message) }
                                >
                                    <Icon name={ fault !== null && fault !== 'failed' ? 'alert' : (loading ? 'close' : 'download') } size={ 20 } />
                                    <Show when={ loading || uploading }>
                                        { () =>
                                            <svg class="pointer-events-none absolute -inset-0.5 -rotate-90" viewBox="0 0 48 48" aria-hidden="true" data-ring>
                                                <circle cx="24" cy="24" r="22.5" fill="none" stroke="white" stroke-opacity="0.3" stroke-width="2.5"></circle>
                                                <circle cx="24" cy="24" r="22.5" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" pathLength="100" stroke-dasharray="100" stroke-dashoffset={ 100 - Math.round((uploading ? sending ?? 0 : fraction) * 100) }></circle>
                                            </svg>
                                        }
                                    </Show>
                                </button>
                            </span>
                        }
                    </Show>
                    <Show when={ !ready || photo }>
                        { () =>
                            <span class="pointer-events-none absolute start-1.5 top-1.5 flex items-center gap-1 rounded-full bg-black/55 px-2 py-0.5 text-ui-2xs font-medium tabular-nums text-white backdrop-blur-sm" data-size>
                                <Show when={ !photo }>
                                    { () => <Icon name="film" size={ 12 } /> }
                                </Show>
                                { meta }
                            </span>
                        }
                    </Show>
                </div>
            }
        </Show>

        <Show when={ fault !== null }>
            { () =>
                <span class={ () => [ 'flex items-start gap-1 text-ui-2xs leading-snug', alarming ? 'text-danger' : (mine ? 'text-accent-ink/85' : 'text-muted') ].join(' ') } role={ alarming ? 'alert' : 'status' } data-fault={ fault ?? '' }>
                    <span class="min-w-0 flex-1">
                        { fault === null ? '' : locale.t(FAULTS[fault]) }
                        <Show when={ fault === 'failed' }>
                            { () =>
                                <button type="button" class="relative ms-1 cursor-pointer font-semibold underline-offset-2 hover:underline coarse:before:absolute coarse:before:-inset-x-1 coarse:before:-inset-y-3.5" onClick={ () => loads.toggle(props.message) }>
                                    { locale.t('common.retry') }
                                </button>
                            }
                        </Show>
                    </span>
                </span>
            }
        </Show>

        <Show when={ shown && reserve !== '' }>
            { () => <span class="flex min-h-3 text-ui-2xs leading-none" aria-hidden="true"><span class={ () => `ms-auto ${ room }` }>{ reserve }</span></span> }
        </Show>
    </div>
}
