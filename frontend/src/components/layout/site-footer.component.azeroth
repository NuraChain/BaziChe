import { NURA_CHAIN } from '../../data/chain.ts';
import { GAMES } from '../../data/games.ts';
import type { MessageKey } from '../../locales/en.ts';
import { useLocale } from '../../stores/locale.store.ts';
import BrandLogo from './brand-logo.component.azeroth';
import BrandMark from './brand-mark.component.azeroth';

const REPO = 'https://github.com/NuraChain/BaziChe';

/** Where the sentence naming the framework puts its link: a character no translation types. */
const NAMED = '';

interface FooterLink
{
    key: MessageKey;
    href: string;
}

/** The columns as one list, so the landing's first script carries one row of markup however many links there are. */
const COLUMNS: { title: MessageKey; links: FooterLink[] }[] = [
    {
        title: 'footer.play',
        links: [
            { key: 'nav.games', href: '/#games' },
            { key: 'footer.together', href: '/#together' },
            { key: 'footer.compete', href: '/#compete' },
            { key: 'landing.cta.start', href: '/app' }
        ]
    },
    {
        title: 'nav.games',
        links: GAMES.map((game): FooterLink => ({ key: `games.${ game.id }.name`, href: `/app/games/${ game.slug }` }))
    },
    {
        title: 'footer.source',
        links: [
            { key: 'footer.code', href: REPO },
            { key: 'footer.selfHost', href: `${ REPO }/blob/main/docs/operations/self-hosting.md` },
            { key: 'footer.contribute', href: `${ REPO }/blob/main/.github/CONTRIBUTING.md` },
            { key: 'footer.security', href: `${ REPO }/security/policy` },
            { key: 'footer.license', href: `${ REPO }/blob/main/LICENSE` }
        ]
    },
    {
        title: 'footer.chain',
        links: [
            { key: 'footer.chainSite', href: NURA_CHAIN.site },
            { key: 'footer.explorer', href: NURA_CHAIN.explorerUrls[0] },
            { key: 'footer.chainCode', href: 'https://github.com/NuraChain' }
        ]
    }
];

/** Where the brand can be followed, each drawn from its mark in `public/brand-marks.svg`, which no script carries. */
const ELSEWHERE: { key: MessageKey; href: string; mark: string }[] = [
    { key: 'footer.onGitHub', href: REPO, mark: 'github' },
    { key: 'footer.onTelegram', href: 'https://t.me/bazichecom', mark: 'telegram' },
    { key: 'footer.onDiscord', href: 'https://discord.gg/H2jTm7F2gK', mark: 'discord' },
    { key: 'footer.onX', href: 'https://x.com/nurachainnet', mark: 'x' }
];

/**
 * The foot of every public page: the brand and its line with where it can be followed, the ways round
 * the product, its games, its source and the chain it runs on, then the year and the framework it is
 * built with. Links only, so it reads the same with no script at all.
 */
export default component SiteFooter()
{
    const locale = useLocale();

    const year = new Date().getFullYear();

    derived built = locale.t('footer.builtWith', { name: NAMED }).split(NAMED);

    <footer class="relative z-10 border-t border-line bg-void" data-site-footer>
        <div class="page-pad safe-b mx-auto flex max-w-7xl flex-col gap-10 pt-12 pb-2">
            <div class="grid gap-10 lg:grid-cols-[minmax(0,18rem)_minmax(0,1fr)] lg:gap-16">
                <div class="flex flex-col items-start gap-3">
                    <a href="/" class="flex min-h-11 items-center gap-2.5 rounded-control" aria-label={ locale.t('brand.name') }>
                        <BrandLogo size="md" />
                        <BrandMark class="text-ui-lg text-text" />
                    </a>
                    <p class="text-ui-sm text-muted">{ locale.t('landing.arrival.lead') } { locale.t('landing.arrival.accent') }</p>
                    <ul class="mt-1 flex gap-2" aria-label={ locale.t('footer.follow') }>
                        <For each={ ELSEWHERE } key={ (one) => one.href } let={ one }>
                            <li>
                                <a
                                    href={ one.href }
                                    class="flex size-11 items-center justify-center rounded-control border border-line bg-field text-muted transition-colors duration-150 hover:border-line-strong hover:text-text"
                                    aria-label={ locale.t(one.key, { name: locale.t('brand.name') }) }
                                    data-elsewhere={ one.href }
                                >
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><use href={ `/brand-marks.svg#${ one.mark }` } /></svg>
                                </a>
                            </li>
                        </For>
                    </ul>
                </div>
                <nav class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4" aria-label={ locale.t('footer.nav') }>
                    <For each={ COLUMNS } key={ (column) => column.title } let={ column }>
                        <div class="flex min-w-0 flex-col gap-1">
                            <h2 class="label text-ui-sm text-text">{ locale.t(column.title) }</h2>
                            <ul class="flex flex-col">
                                <For each={ column.links } key={ (link) => link.href } let={ link }>
                                    <li>
                                        <a href={ link.href } class="inline-flex min-h-11 items-center text-ui-sm text-muted transition-colors duration-150 hover:text-text fine:min-h-10">
                                            { locale.t(link.key) }
                                        </a>
                                    </li>
                                </For>
                            </ul>
                        </div>
                    </For>
                </nav>
            </div>
            <div class="flex flex-col gap-x-6 border-t border-line pt-2 sm:flex-row sm:items-center sm:justify-between">
                <p class="py-3 text-ui-sm text-faint" data-rights>
                    © <span class="tally">{ locale.n(year, { useGrouping: false }) }</span> { locale.t('brand.name') }. { locale.t('footer.rights') }
                </p>
                <p class="text-ui-sm text-faint" data-built-with>
                    { built[0] }<a href="https://github.com/AzerothJS/AzerothJS" class="inline-flex min-h-11 items-center font-semibold text-muted transition-colors duration-150 hover:text-accent" dir="ltr">AzerothJS</a>{ built[1] }
                </p>
            </div>
        </div>
    </footer>
}
