import PlayCta from '../components/layout/play-cta.component.azeroth';
import { useLocale } from '../stores/locale.store.ts';

export default component SceneFinale(props: { returning: boolean })
{
    const locale = useLocale();

    <section data-beat="finale" class="landing-finale" aria-labelledby="finale-title">
        <div class="landing-inner landing-finale-inner">
            <div class="landing-section-head">
                <h2 id="finale-title">{ locale.t('landing.finale.title') }</h2>
                <p>{ locale.t('landing.finale.lead') }</p>
            </div>
            <PlayCta returning={ props.returning } />
        </div>
    </section>
}
